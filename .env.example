# Copy this file to `.env` (which is gitignored) and fill in your real values.
# Anything prefixed PUBLIC_ is exposed to the client bundle at build time.

# Production origin (no trailing slash). Used by Astro.site to build absolute
# URLs for Open Graph share cards and canonical links. Leave unset locally;
# the default in astro.config.mjs will be used.
# PUBLIC_SITE_URL=https://thebrownline.com

# Beehiiv form action URL.
# Where to find it: Beehiiv dashboard → Publication Settings → Subscribe Forms →
# "Embed" → grab the <form action="..."> URL from the snippet. It usually looks like:
#   https://embeds.beehiiv.com/<your-publication-id>/subscribe
# This is what SubscribeForm.astro POSTs to.
PUBLIC_BEEHIIV_URL=
