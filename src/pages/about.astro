---
import Layout from '../layouts/Layout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import TransitDivider from '../components/TransitDivider.astro';

const base = import.meta.env.BASE_URL;
const EMAIL = 'hi@thebrownlinechi.com';

// Standards & Ethics: selection criteria cards.
const criteria = [
  {
    n: '01',
    label: 'Community & Cultural Relevance',
    accent: 'cayenne',
    points: [
      'Rooted in Global South diaspora communities',
      'Community-centered, solidarity-driven, or culturally significant',
    ],
  },
  {
    n: '02',
    label: 'Accessibility & Inclusion',
    accent: 'mayaBlue',
    points: [
      'Affordable (free or low-cost whenever possible)',
      'Accessible within the city of Chicago',
      'Designed to be welcoming and inclusive',
    ],
  },
  {
    n: '03',
    label: 'Depth & Intent',
    accent: 'celadon',
    points: [
      'Educational, intellectually engaging, or culturally enriching',
      'Supportive of holistic community wellness',
    ],
  },
  {
    n: '04',
    label: 'Independence & Integrity',
    accent: 'amber',
    points: [
      'Independent or underpromoted',
      'Ethically organized, not exploitative or extractive',
    ],
  },
] as const;

const accentText: Record<string, string> = {
  cayenne:  'text-cayenne',
  mayaBlue: 'text-mayaBlue',
  celadon:  'text-celadon',
  amber:    'text-amber',
};

// The prose sections of the ethics policy, rendered as a compact stack. The
// criteria grid is interleaved after "Scope & Format" in the markup below.
const ethicsSections = [
  {
    heading: 'Editorial Independence',
    paragraphs: [
      "The Brown Line is editorially independent. No advertiser, sponsor, event organizer, or community member has any influence over what gets featured, how it's covered, or what gets left out. All coverage decisions are made based on The Brown Line's editorial criteria and my own judgment.",
    ],
  },
  {
    heading: 'Scope & Format',
    paragraphs: [
      'The Brown Line is a curated cultural guide, not a reviewing or rating platform. Inclusion is not an endorsement, and absence is not a judgment. The goal is to surface meaningful cultural programming, not to evaluate or rank it.',
    ],
  },
  {
    heading: 'No Pay-to-Play',
    paragraphs: [
      "I don't accept payment, gifts, or compensation in exchange for coverage or mentions. If something is featured here, it's because I genuinely believe it's worth your time. I may occasionally attend events using complimentary access, but that never guarantees coverage or influences what I choose to include.",
    ],
  },
  {
    heading: 'Sponsored Content & Advertising',
    paragraphs: [
      "The Brown Line does not currently run ads or sponsored content. If that changes, any sponsorships will be clearly labeled and only accepted from organizations that align with The Brown Line's values. They won't influence editorial decisions.",
    ],
  },
  {
    heading: 'Conflicts of Interest',
    paragraphs: [
      "I work full-time as an editor at a national nonprofit newsroom. The Brown Line is a separate, independent project. Because this work is community-rooted, I may have personal or professional connections to some of the people or spaces featured. Those relationships don't determine coverage. When context matters, I'll share it.",
      "The Brown Line has a perspective, not a political agenda. The Brown Line intentionally centers Global South diaspora communities in Chicago. The politics you'll find here live in the communities I cover, in the events, the organizers, and the cultural work being documented, not in advocacy or activism on my part.",
    ],
  },
  {
    heading: 'Accuracy & Corrections',
    paragraphs: [
      "I do my best to verify event details (dates, times, locations, and ticket info) before publishing. Things can change, so it's always worth double-checking with organizers directly. If I get something wrong, I'll fix it. For smaller errors, I may update and flag on social. For something more significant, I'll clearly acknowledge and correct it in the next issue.",
    ],
  },
  {
    heading: 'Accountability',
    paragraphs: [
      "I welcome feedback, critique, and conversation from the communities this work is for. That's part of keeping this project honest and useful.",
    ],
  },
];

const affiliations = [
  { label: 'Editor, National Nonprofit Newsroom',            accent: 'amber'    },
  { label: 'Board, Borderless Magazine',                     accent: 'mayaBlue' },
  { label: 'Tow-Knight Fellow, CUNY',                        accent: 'celadon'  },
  { label: 'AAJA Executive Leadership Fellow',               accent: 'babyPink' },
  { label: 'Poynter Institute Fellow',                       accent: 'cayenne'  },
];

const accentClass: Record<string, string> = {
  amber:    'border-amber',
  mayaBlue: 'border-mayaBlue',
  celadon:  'border-celadon',
  babyPink: 'border-babyPink',
  cayenne:  'border-cayenne',
};

const description =
  'The Brown Line is an independent local guide to Chicago arts, culture, and community through a Global South diaspora lens, founded and edited by journalist Ghazala Irshad. Subscribe and ride along.';
---
<Layout
  title="About · The Brown Line"
  description={description}
  ogImage="images/ghazala.jpeg"
  ogImageAlt="Ghazala Irshad, founder of The Brown Line"
  ogType="profile"
>
  {/* ---------- Hero: the project first ---------- */}
  <section class="px-6 pt-16 md:pt-24 pb-12">
    <div class="max-w-4xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-6">
        About the line
      </p>
      <h1 class="font-heading text-darkWalnut text-4xl md:text-6xl lg:text-7xl leading-[1.02] tracking-tight text-balance">
        We map the Chicago culture that travels by word of mouth.
      </h1>
      <p class="font-body text-darkWalnut/85 text-lg md:text-xl mt-8 leading-relaxed">
        The Brown Line spotlights Global South diaspora arts, culture, and community events: the film
        screenings, food pop-ups, dance floors, book talks, fundraisers, workshops, neighborhood
        gatherings, and independent artists that make Chicago feel like the world.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6">
    <TransitDivider />
  </div>

  {/* ---------- What we're building ---------- */}
  <section class="px-6 py-16 md:py-24">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-tight tracking-tight">
        A creator-led local newsroom for the Global South diaspora.
      </h2>

      <div class="mt-8 font-body text-darkWalnut text-lg leading-relaxed space-y-6">
        <p>
          The Brown Line is a Chicago-based, creator-led, local media brand serving Global South
          diaspora communities through culturally intelligent journalism. It blends curated weekly and
          neighborhood guides, independent artist and small-business spotlights, original reporting, and
          values-driven commentary through a Global South lens.
        </p>
        <p>
          Built through word of mouth and organic Instagram growth, it has attracted a highly engaged
          local subscriber base and is expanding through live events, community partnerships, and
          cross-platform distribution.
        </p>
      </div>

      <p class="mt-8">
        <a
          href="#ethics"
          data-ga-event="standards_click"
          data-ga-label="about_page"
          class="inline-flex items-center gap-1.5 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut/70 transition-colors hover:text-cayenne focus-visible:text-cayenne focus-visible:outline-none"
        >
          How we curate
          <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  {/* ---------- Credibility strip (shared with homepage) ---------- */}
  <section class="px-6 pb-4 md:pb-6">
    <CredibilityStrip />
  </section>

  {/* ---------- Meet the founder ---------- */}
  <section class="px-6 py-12 md:py-16 bg-seashell">
    <div class="max-w-5xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-8">
        Meet the founder
      </p>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">
        {/* Portrait */}
        <div class="md:col-span-5">
          <div class="relative inline-block w-full">
            <img
              src={`${base}images/ghazala.jpeg`}
              alt="Ghazala Irshad, founder of The Brown Line"
              class="w-full h-auto border-2 border-darkWalnut shadow-retro"
              width="800"
              height="800"
              decoding="async"
              loading="lazy"
            />
            <div
              class="transit-divider absolute -bottom-3 -right-3 w-32 md:w-48"
              aria-hidden="true"
            ></div>
          </div>
        </div>

        {/* Lead bio */}
        <div class="md:col-span-7 font-body text-darkWalnut leading-relaxed">
          <p class="text-xl md:text-2xl font-semibold text-darkWalnut leading-snug">
            The Brown Line is founded and edited by <span class="text-cayenne font-bold">Ghazala Irshad</span>,
            a Chicago-based journalist, editor, and media entrepreneur whose work spans international
            reporting, nonprofit media, standards editing, and community storytelling.
          </p>

          <p class="mt-6 text-darkWalnut/85">
            She works full-time as an editor at a national nonprofit newsroom; The Brown Line is a
            separate, independent project. Because this work is community-rooted, she may have personal or
            professional connections to some of the people or spaces featured. Those relationships don't
            determine coverage, and when context matters, she shares it.
          </p>

          <p class="mt-4 text-darkWalnut/85">
            Her career spans international reporting, nonprofit media, and community storytelling. After
            teaching English to refugees and orphans in Thailand, she lived in Egypt during the Arab
            Spring, reporting on protests and abuses of power. She later produced an award-winning
            documentary series highlighting grassroots changemakers across the Global South, and developed
            a Muslim diaspora-focused, decolonial travel storytelling platform as a Tow-Knight
            Entrepreneurial Journalism Fellow at CUNY.
          </p>

          <p class="mt-4 text-darkWalnut/85">
            She serves on the board of <strong class="font-semibold text-darkWalnut">Borderless Magazine</strong>,
            focused on immigrants and immigration news in Chicago, and is a fellow of executive leadership
            programs at the Asian American Journalists Association and the Poynter Institute.
          </p>
        </div>
      </div>

      <div class="mt-12">
        <p class="font-body uppercase text-xs tracking-[0.3em] text-darkWalnut/60 font-bold mb-6">
          Currently &amp; previously
        </p>
        <ul class="flex flex-wrap gap-3">
          {affiliations.map((a) => (
            <li
              class:list={[
                'font-body text-darkWalnut text-sm font-semibold uppercase tracking-wider bg-seashell border-2 px-4 py-2',
                accentClass[a.accent],
              ]}
            >
              {a.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- Values strip ---------- */}
  <section class="px-6 py-16 md:py-20 bg-darkWalnut text-seashell">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 text-center md:text-left">
      <div>
        <p class="font-heading text-amber text-5xl md:text-6xl leading-none">01</p>
        <h3 class="font-body font-extrabold uppercase tracking-widest text-seashell text-lg mt-4">Belonging</h3>
        <p class="font-body text-seashell/80 text-base mt-2 leading-relaxed">
          Stories that name and honor the communities Chicago's mainstream media routinely overlooks.
        </p>
      </div>
      <div>
        <p class="font-heading text-celadon text-5xl md:text-6xl leading-none">02</p>
        <h3 class="font-body font-extrabold uppercase tracking-widest text-seashell text-lg mt-4">Trust</h3>
        <p class="font-body text-seashell/80 text-base mt-2 leading-relaxed">
          Reported journalism built on relationships, accuracy, and a clear editorial standard, not engagement bait.
        </p>
      </div>
      <div>
        <p class="font-heading text-babyPink text-5xl md:text-6xl leading-none">03</p>
        <h3 class="font-body font-extrabold uppercase tracking-widest text-seashell text-lg mt-4">Sustainability</h3>
        <p class="font-body text-seashell/80 text-base mt-2 leading-relaxed">
          Audience-supported. Independent. Built to outlast the news cycle and the next platform pivot.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- Where we're headed (business model, kept lower) ---------- */}
  <section class="px-6 py-20 md:py-28">
    <div class="max-w-4xl mx-auto">
      <figure class="border-l-4 border-cayenne pl-6 md:pl-10">
        <blockquote class="font-body italic font-medium text-darkWalnut text-2xl md:text-4xl leading-[1.3] tracking-tight">
          Positioned at the intersection of local journalism, community building, and creator-economy
          strategy. Designed to be a sustainable, audience-supported platform rooted in belonging and trust.
        </blockquote>
      </figure>
      <p class="font-body text-darkWalnut/85 text-lg leading-relaxed mt-10">
        The long-term model includes paid subscriptions, branded community gatherings, partnerships with
        immigrant-owned businesses, and strategic collaborations with cultural institutions.
      </p>
    </div>
  </section>

  {/* Support moved to its own page (/support). Old newsletters and bookmarks
      still deep-link to /about#support, so forward that anchor along. */}
  <script is:inline define:vars={{ supportUrl: `${base}support` }}>
    if (window.location.hash === '#support') {
      window.location.replace(supportUrl);
    }
  </script>

  {/* ---------- Standards & Ethics (moved here from /standards) ---------- */}
  <section id="ethics" class="scroll-mt-24 lg:scroll-mt-6 px-6 py-16 md:py-24">
    <div class="max-w-5xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-3">
        How we work
      </p>
      <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-tight tracking-tight">
        Standards &amp; Ethics
      </h2>
      <p class="font-body text-darkWalnut/85 text-lg leading-relaxed mt-5 max-w-2xl">
        These principles shape how I operate and how I decide what gets featured.
      </p>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
        {ethicsSections.slice(0, 2).map((s) => (
          <div>
            <h3 class="font-body font-extrabold uppercase tracking-widest text-darkWalnut text-sm md:text-base mb-4">
              {s.heading}
            </h3>
            {s.paragraphs.map((p) => (
              <p class="font-body text-darkWalnut text-base leading-relaxed mt-3 first:mt-0">{p}</p>
            ))}
          </div>
        ))}
      </div>

      {/* How coverage is selected */}
      <div class="mt-14">
        <h3 class="font-body font-extrabold uppercase tracking-widest text-darkWalnut text-sm md:text-base mb-4">
          How Coverage Is Selected
        </h3>
        <p class="font-body text-darkWalnut text-base leading-relaxed max-w-3xl">
          I spotlight events and cultural programming based on these core criteria:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
          {criteria.map((c) => (
            <div class="bg-seashell border-2 border-darkWalnut p-6 md:p-8 flex flex-col">
              <p class:list={['font-heading text-5xl md:text-6xl leading-none', accentText[c.accent]]}>
                {c.n}
              </p>
              <h4 class="font-body font-extrabold uppercase tracking-widest text-darkWalnut text-base md:text-lg mt-4">
                {c.label}
              </h4>
              <ul class="mt-4 space-y-2 font-body text-darkWalnut/85 text-base leading-relaxed list-disc pl-5 marker:text-darkWalnut/50">
                {c.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="font-body text-darkWalnut text-base leading-relaxed mt-8 max-w-3xl">
          Meeting these criteria doesn't guarantee coverage. I receive more submissions than I can
          feature, and final decisions come down to editorial judgment and space. Community members and
          event organizers can submit events through the
          <a href={`${base}submit-event`} class="text-cayenne font-bold underline decoration-2 decoration-mayaBlue underline-offset-4 hover:decoration-cayenne">event submission form</a>,
          or by email at
          <a href={`mailto:${EMAIL}`} class="text-cayenne font-bold underline decoration-2 decoration-mayaBlue underline-offset-4 hover:decoration-cayenne">{EMAIL}</a>.
          Submitting an event doesn't guarantee it will be featured.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
        {ethicsSections.slice(2).map((s) => (
          <div>
            <h3 class="font-body font-extrabold uppercase tracking-widest text-darkWalnut text-sm md:text-base mb-4">
              {s.heading}
            </h3>
            {s.paragraphs.map((p) => (
              <p class="font-body text-darkWalnut text-base leading-relaxed mt-3 first:mt-0">{p}</p>
            ))}
          </div>
        ))}
      </div>

      <p class="font-body text-darkWalnut/70 text-sm mt-10 uppercase tracking-widest">
        To flag an error or ask a question:
        <a href={`mailto:${EMAIL}`} class="text-darkWalnut font-bold underline decoration-2 decoration-mayaBlue underline-offset-4 hover:decoration-cayenne normal-case tracking-normal">{EMAIL}</a>
      </p>
    </div>
  </section>

  {/* ---------- A note on perspective ---------- */}
  <section class="px-6 py-16 md:py-24 bg-darkWalnut text-seashell">
    <div class="max-w-3xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-amber font-bold mb-6">
        A note on perspective
      </p>
      <div class="font-body text-seashell text-lg md:text-xl leading-relaxed space-y-5">
        <p>
          Every publication has a lens. Mine is shaped by my identity as a South Asian American Muslim woman, journalist, and Chicagoan. That lens influences what gets spotlighted: more transit-accessible than suburban, more culture-focused than consumption-driven, more community-rooted than trend-chasing.
        </p>
        <p>
          The Brown Line isn't a neutral aggregator. It's a curated publication with a clear point of view and stated values. You deserve to know that, and to decide for yourself whether this ride is for you.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- CTA ---------- */}
  <section id="subscribe" class="scroll-mt-24 lg:scroll-mt-6 px-6 py-20 md:py-28 bg-seashell">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-darkWalnut text-4xl md:text-6xl leading-[0.95] tracking-tight">
        Ride with us.
      </h2>
      <p class="font-body text-darkWalnut/85 text-lg mt-6 max-w-xl mx-auto leading-relaxed">
        One stop a week in your inbox. Arts, culture, and community from the corners of Chicago you actually want to know.
      </p>
      <div class="mt-10 flex justify-center">
        <SubscribeForm caption="" />
      </div>
      <p class="font-body text-darkWalnut/70 text-sm mt-8 uppercase tracking-widest">
        Want to do more?
        <a
          href={`${base}support`}
          class="text-darkWalnut font-bold underline decoration-2 decoration-mayaBlue underline-offset-4 hover:decoration-cayenne"
        >
          Support The Brown Line
        </a>
      </p>
    </div>
  </section>
</Layout>
