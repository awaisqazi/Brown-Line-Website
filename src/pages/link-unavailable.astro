---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const description = 'This stop is closed: the link you followed is no longer available.';
---
<Layout
  title="This Stop Is Closed · The Brown Line"
  description={description}
  noindex
>
  {/* ---------- Closed stop ---------- */}
  <section class="px-6 pt-16 md:pt-24 pb-20">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-6">
        Service notice
      </p>
      <h1 class="font-heading text-darkWalnut text-5xl md:text-7xl leading-[0.95] tracking-tight">
        This stop is closed
      </h1>
      <p class="font-body text-darkWalnut/80 text-lg md:text-xl mt-8 leading-relaxed">
        The link you followed no longer goes anywhere. The page it pointed to has moved, changed, or
        gone offline since we linked it.
      </p>
      <p class="mt-10">
        <a
          href={base}
          class="inline-flex items-center gap-2 border-2 border-darkWalnut bg-cayenne px-6 py-3 font-body font-bold uppercase tracking-widest text-seashell shadow-retro transition-transform duration-150 ease-out hover:-translate-y-1 hover:-translate-x-1 focus-visible:-translate-y-1 focus-visible:-translate-x-1 focus-visible:outline-none"
        >
          <span aria-hidden="true">&larr;</span>
          Back to the homepage
        </a>
      </p>
    </div>
  </section>
</Layout>
