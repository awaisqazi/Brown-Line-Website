---
import Layout from '../layouts/Layout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import IssueCard from '../components/IssueCard.astro';
import EventCard from '../components/EventCard.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import Marquee from '../components/Marquee.astro';
import TransitDivider from '../components/TransitDivider.astro';
import { getRecentIssues } from '../lib/issues';
import { supabase } from '../lib/supabase';
import { formatTimeRange, formatStopDate, getChicagoDateString } from '../lib/dates';
import type { TickerItem } from '../lib/ticker';
import type { TransitEvent } from '../lib/supabase';

const HOMEPAGE_EVENTS_LIMIT = 5;

// Real testimonials only (reader + organizer/partner mix). Leave empty until
// quotes are collected via DM/form, then fill in here. The section renders only
// when this has entries, so the homepage never shows a fabricated quote.
const testimonials: { quote: string; name: string; role: string; accent: string }[] = [
  // Example shape (do not ship until confirmed real, with permission):
  // { quote: '...', name: 'First name', role: 'Neighborhood or role', accent: 'cayenne' },
];
const testimonialAccent: Record<string, string> = {
  cayenne: 'border-cayenne',
  mayaBlue: 'border-mayaBlue',
  celadon: 'border-celadon',
  amber: 'border-amber',
  babyPink: 'border-babyPink',
};

// The credibility strip (Supported by / Featured in) is a shared component,
// used here and on the About page so the two never drift (see CredibilityStrip.astro).
// Cycle the brand palette across stops so the homepage route reads like the
// colorful line on the full events board (src/pages/events.astro).
const stopColors = ['bg-babyPink', 'bg-mayaBlue', 'bg-celadon', 'bg-amber', 'bg-cayenne'];

const issues = await getRecentIssues();
const todayDateString = getChicagoDateString();
// The rail shows the next stops in date order, curated or not, so the homepage
// always reflects what is actually coming up soonest. Conductor's Picks still
// lead within a same-day tie.
const { data: upcomingEventsData, error: upcomingEventsError } = await supabase
  .from('events')
  .select('*')
  .gte('event_date', todayDateString)
  .order('event_date', { ascending: true })
  .order('is_curated', { ascending: false, nullsFirst: false })
  .order('title', { ascending: true })
  .limit(HOMEPAGE_EVENTS_LIMIT)
  .returns<TransitEvent[]>();

if (upcomingEventsError) {
  throw new Error(`Failed to load homepage events: ${upcomingEventsError.message}`);
}

const upcomingEvents = upcomingEventsData ?? [];
// The scrolling NEXT STOP banner leads with the soonest upcoming event, matching
// the date-ordered rail below.
const firstUpcomingEvent = upcomingEvents[0];
const upcomingStopsTicker: TickerItem[] = [
  {
    label: 'NEXT STOP',
    text: firstUpcomingEvent
      ? `${firstUpcomingEvent.title} · DOORS OPEN ON THE RIGHT`
      : 'NO SCHEDULED STOPS · CHECK THE EVENTS BOARD',
  },
];
---
<Layout>
  {/* ---------- Hero ---------- */}
  <section id="subscribe" class="px-6 pt-12 pb-6 md:pt-16 md:pb-6 lg:pt-20">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-5">
        Underground culture, elevated
      </p>

      <h1 class="font-heading text-darkWalnut text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight text-balance">
        Chicago&rsquo;s go-to guide for&nbsp;<em class="not-italic text-cayenne">Global South diaspora</em> arts, culture, and community.
      </h1>

      <div class="mt-8 md:mt-10 flex justify-center">
        <SubscribeForm caption="" />
      </div>
    </div>
  </section>

  {/* ---------- Credibility strip ---------- */}
  <section class="px-6 pt-2">
    <CredibilityStrip />
  </section>

  {/* ---------- Scroll cue: sits right above the Upcoming Stops section ---------- */}
  <div class="px-6 pt-10 pb-10 md:pt-12 md:pb-12 text-center">
    <a
      href="#upcoming-stops"
      class="scroll-cue-link group inline-flex flex-col items-center gap-1.5 font-body text-[0.7rem] font-bold uppercase tracking-[0.3em] text-darkWalnut/75 transition-colors hover:text-cayenne focus-visible:text-cayenne"
      aria-label="Scroll down to upcoming stops"
    >
      <span>Upcoming stops</span>
      <span class="scroll-cue text-cayenne" aria-hidden="true">&darr;</span>
    </a>
  </div>

  {/* ---------- Upcoming Stops ---------- */}
  <section id="upcoming-stops" class="scroll-mt-24 pt-6 pb-16 md:scroll-mt-0 md:pt-6 md:pb-24">
    <div class="max-w-5xl mx-auto">
      <div class="upcoming-stops-led mb-10 md:mb-12">
        <Marquee items={upcomingStopsTicker} visualRepeat={4} />
      </div>

      <div class="px-4 sm:px-6">
        <div class="mb-10 md:mb-14 md:pl-16">
          <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-3">
            Board here
          </p>
          <h2 class="font-heading tracking-tight font-semibold text-darkWalnut text-4xl md:text-[2.5rem] leading-none">
            Upcoming Stops
          </h2>
        </div>

        {upcomingEvents.length > 0 ? (
          <div class="relative">
            <ol class="upcoming-route relative space-y-9 md:space-y-12">
              {upcomingEvents.map((event, index) => (
                <li class="relative pl-12 md:pl-20">
                  <span
                    class:list={[
                      'absolute left-4 top-6 z-10 h-7 w-7 -translate-x-1/2 rounded-full border-2 border-darkWalnut shadow-[2px_2px_0_#642713] md:left-8 md:h-8 md:w-8',
                      stopColors[index % stopColors.length],
                    ]}
                    aria-hidden="true"
                  ></span>

                  {/* Departure tag: date and time as one two-segment chip, like a ticket stub */}
                  <div class="mb-3 inline-flex items-stretch font-mono text-[10px] font-bold uppercase tracking-[0.22em] text-[#62361B] shadow-[2px_2px_0_#642713] md:text-xs">
                    <span class="border-2 border-[#62361B] bg-seashell px-2.5 py-1">
                      {formatStopDate(event.event_date)}
                    </span>
                    {formatTimeRange(event.start_time, event.end_time) && (
                      <span class="flex items-center border-2 border-l-0 border-[#62361B] bg-amber px-2.5 py-1">
                        {formatTimeRange(event.start_time, event.end_time)}
                      </span>
                    )}
                  </div>

                  <EventCard event={event} showTime={false} />
                </li>
              ))}
            </ol>

            {/* Terminus: the line keeps running to the full events board.
               The dot center sits a fixed 0.85rem below this block's top and
               2.5rem (mt-10) below the list, so the .upcoming-route rail can
               extend a fixed distance down to meet it regardless of wrapping. */}
            <div class="relative mt-10 pl-12 md:pl-20">
              <span
                class="absolute left-4 top-[0.85rem] z-10 flex h-7 w-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-darkWalnut bg-amber shadow-[2px_2px_0_#642713] md:left-8 md:h-8 md:w-8"
                aria-hidden="true"
              >
                <span class="block h-2.5 w-2.5 rounded-full bg-darkWalnut md:h-3 md:w-3"></span>
              </span>
              <a
                href={`${import.meta.env.BASE_URL}events`}
                class="see-more group inline-flex items-center gap-3 font-heading font-semibold leading-none tracking-tight text-darkWalnut text-2xl transition-colors hover:text-cayenne focus-visible:text-cayenne md:text-3xl"
              >
                <span>See all stops</span>
                <span class="see-more-arrow text-cayenne" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        ) : (
          <div class="border-[3px] border-[#62361B] bg-[#FDFBF7] px-6 py-8 shadow-retro md:ml-16 md:px-8">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.22em] text-[#62361B]">
              Route status
            </p>
            <p class="mt-3 font-sans text-2xl font-extrabold tracking-tight text-darkWalnut md:text-3xl">
              No scheduled stops right now.
            </p>
            <a
              href={`${import.meta.env.BASE_URL}events`}
              class="link-transit mt-5 inline-flex font-body text-sm font-bold uppercase tracking-widest text-darkWalnut"
            >
              Check the events board &nearr;
            </a>
          </div>
        )}
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-6 mt-16 md:mt-20">
      <TransitDivider />
    </div>
  </section>

  {/* ---------- Two-sided band: the platform/network story ---------- */}
  <section class="px-6 pb-16 md:pb-24">
    <div class="max-w-5xl mx-auto grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
      <div class="flex flex-col border-[3px] border-darkWalnut bg-[#FDFBF7] p-7 md:p-8 shadow-retro">
        <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">Feeling social?</p>
        <h3 class="font-heading font-semibold text-darkWalnut text-2xl md:text-3xl leading-tight mt-3">
          Find your next stop.
        </h3>
        <p class="font-body text-darkWalnut/80 text-base leading-relaxed mt-3">
          Browse the live board for what&rsquo;s happening across Chicago&rsquo;s Global South diasporas this week.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}events`}
          data-ga-event="browse_click"
          data-ga-label="homepage_band"
          class="mt-6 inline-flex items-center gap-2 self-start border-2 border-darkWalnut bg-mayaBlue px-5 py-2.5 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cayenne"
        >
          Browse events <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="flex flex-col border-[3px] border-darkWalnut bg-[#FDFBF7] p-7 md:p-8 shadow-retro">
        <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">Hosting?</p>
        <h3 class="font-heading font-semibold text-darkWalnut text-2xl md:text-3xl leading-tight mt-3">
          Put it on the map.
        </h3>
        <p class="font-body text-darkWalnut/80 text-base leading-relaxed mt-3">
          Submit your event and a human will review it for the board and the newsletter.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}submit-event`}
          data-ga-event="submit_click"
          data-ga-label="homepage_band"
          class="mt-6 inline-flex items-center gap-2 self-start border-2 border-darkWalnut bg-amber px-5 py-2.5 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
        >
          Submit an event <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Testimonials (renders only when real quotes exist) ---------- */}
  {testimonials.length > 0 && (
    <section class="px-6 py-16 md:py-24 bg-seashell">
      <div class="max-w-5xl mx-auto">
        <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-3 text-center">
          From the platform
        </p>
        <h2 class="font-heading font-semibold text-darkWalnut text-4xl md:text-[2.5rem] leading-none tracking-tight text-center">
          Riders &amp; organizers
        </h2>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <figure class:list={['bg-[#FDFBF7] border-l-4 p-6', testimonialAccent[t.accent] ?? 'border-cayenne']}>
              <blockquote class="font-body italic text-darkWalnut text-lg leading-relaxed">
                &ldquo;{t.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-4 font-body text-sm font-bold uppercase tracking-widest text-darkWalnut/70">
                {t.name} &middot; {t.role}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ---------- Recent Rides ---------- */}
  <section id="newsletter" class="px-6 py-20 md:py-28">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-12">
        <h2 class="font-heading font-semibold text-darkWalnut text-4xl md:text-[2.5rem] tracking-tight leading-none">
          Recent dispatches
        </h2>
        <a
          href="https://www.thebrownline.co"
          target="_blank"
          rel="noopener noreferrer"
          class="link-transit font-body text-darkWalnut text-sm font-bold uppercase tracking-widest"
        >
          View all &nearr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {issues.map((issue, i) => (
          <div class:list={[i === 0 ? 'md:col-span-2' : '']}>
            <IssueCard
              category={issue.category}
              date={issue.date}
              datetime={issue.publishedAt ? new Date(issue.publishedAt).toISOString().slice(0, 10) : undefined}
              title={issue.title}
              href={issue.href}
              accent={issue.accent as 'amber' | 'cayenne'}
              featured={i === 0}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Support band ---------- */}
  <section class="px-6 py-16 md:py-20 bg-darkWalnut text-seashell">
    <div class="max-w-5xl mx-auto flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <p class="font-body uppercase text-[10px] tracking-[0.3em] text-amber font-bold">Fund the line</p>
        <h2 class="font-heading text-seashell text-3xl md:text-4xl leading-tight tracking-tight mt-3">
          Keep independent culture coverage on the rails.
        </h2>
        <p class="font-body text-seashell/80 text-base md:text-lg leading-relaxed mt-3">
          The Brown Line is reader-supported. Chip in once or ride monthly to keep the guide free, independent, and growing.
        </p>
      </div>
      <a
        href={`${import.meta.env.BASE_URL}support`}
        data-ga-event="support_click"
        data-ga-label="homepage_band"
        class="shrink-0 inline-flex items-center gap-2 border-2 border-amber bg-amber px-6 py-3 font-body text-sm font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0_#FAF1EC] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-seashell"
      >
        Support The Brown Line
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  {/* ---------- About teaser (closing brand statement) ---------- */}
  <section class="px-6 py-20 md:py-28 bg-seashell">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-darkWalnut text-4xl md:text-5xl leading-[0.95] tracking-tight">
        Elevating Chicago&rsquo;s underground Global South culture
      </h2>
      <p class="font-body text-darkWalnut/90 text-lg mt-6 leading-relaxed">
        Your independent, local guide to the arts and culture of Chicago&rsquo;s Global South diasporas. From Rogers Park to Bridgeview, The Brown Line cuts through redlining to connect the neighborhoods — and the people — that make this city feel like the world.
      </p>
      <a
        href={`${import.meta.env.BASE_URL}about`}
        class="inline-flex items-center gap-2 mt-8 font-body font-bold text-sm uppercase tracking-widest text-darkWalnut border-2 border-darkWalnut px-6 py-3 transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:shadow-retro"
      >
        What we&rsquo;re building
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <style>
    /* Hero scroll cue: gently bouncing arrow that signals more content below. */
    .scroll-cue {
      display: inline-block;
      font-size: 1.35rem;
      line-height: 1;
      animation: scroll-cue-bounce 1.6s ease-in-out infinite;
    }

    @keyframes scroll-cue-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(7px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .scroll-cue { animation: none; }
    }

    /* Upcoming Stops rail: a single brown line behind the colorful stop dots.
       Anchored to the list (stable height) and extended a fixed 3.35rem below
       it so the line ends exactly on the terminus dot, which sits mt-10 (2.5rem)
       below the list plus 0.85rem into the terminus block. This stays aligned no
       matter how the terminus link/caption wrap. */
    .upcoming-route::before {
      content: '';
      position: absolute;
      left: 12px;
      top: 0.75rem;
      bottom: -3.35rem;
      width: 8px;
      border-radius: 9999px;
      background: #62361B;
    }

    @media (min-width: 768px) {
      .upcoming-route::before {
        left: 28px;
      }
    }

    /* "See more" terminus: arrow eases forward on hover, like a train pulling away. */
    .see-more-arrow {
      display: inline-block;
      transition: transform 150ms ease;
    }

    .see-more:hover .see-more-arrow,
    .see-more:focus-visible .see-more-arrow {
      transform: translateX(6px);
    }

    @media (prefers-reduced-motion: reduce) {
      .see-more-arrow { transition: none; }
    }

    :global(.upcoming-stops-led .marquee) {
      background: #642713;
      border-color: #FFBC29;
      color: #FFBC29;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
    }

    :global(.upcoming-stops-led .marquee::before) {
      background: linear-gradient(to right, #642713 0%, rgba(100, 39, 19, 0) 100%);
    }

    :global(.upcoming-stops-led .marquee::after) {
      background: linear-gradient(to left, #642713 0%, rgba(100, 39, 19, 0) 100%);
    }

    :global(.upcoming-stops-led .marquee-label) {
      color: #FAF1EC;
    }

    :global(.upcoming-stops-led .marquee-separator),
    :global(.upcoming-stops-led .marquee-toggle) {
      color: #FFBC29;
    }

    :global(.upcoming-stops-led .marquee-grip) {
      background-image: radial-gradient(circle, #FAF1EC 1.4px, transparent 1.6px);
    }
  </style>
</Layout>
