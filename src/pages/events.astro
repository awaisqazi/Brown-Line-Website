---
import Layout from '../layouts/Layout.astro';
import TransitDivider from '../components/TransitDivider.astro';
import EventCard from '../components/EventCard.astro';
import EventDatePicker from '../components/EventDatePicker.astro';
import EventSelect from '../components/EventSelect.astro';
import { fetchAllRows, supabase } from '../lib/supabase';
import type { TransitEvent } from '../lib/supabase';
import { addDays, formatMonthDay, formatStopDate, formatTimeRange, SERIES_LOOKBACK_DAYS } from '../lib/dates';
import { groupBoardStops, type BoardStop } from '../lib/board';
import { BRAND_NAME, buildEventPath, buildEventUrl, buildItemListJsonLd, stringifyJsonLd } from '../lib/seo';

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString() ?? Astro.url.origin;

// The board is a build-time snapshot of upcoming stops. The query looks back
// far enough to see the start of a run already underway (an exhibit stored as
// one row per day), so its collapsed card carries the full date range, the
// same way the homepage rail does; only rows on or after today are counted,
// filtered, and marked on the calendar.
const today = getTodayChicago();

const rows = await fetchAllRows<TransitEvent>('events', (from, to) =>
  supabase
    .from('events')
    .select('*', { count: 'exact' })
    .gte('event_date', addDays(today, -SERIES_LOOKBACK_DAYS))
    .order('event_date', { ascending: true })
    .order('is_curated', { ascending: false })
    .order('title', { ascending: true })
    .order('id', { ascending: true })
    .range(from, to)
    .returns<TransitEvent[]>()
);
const events = rows.filter((event) => event.event_date >= today);

function getTodayChicago() {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Chicago',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date());
  const byType = Object.fromEntries(parts.map((p) => [p.type, p.value]));
  return `${byType.year}-${byType.month}-${byType.day}`;
}

// Rows that share a title and venue are one run. src/lib/board.ts turns them
// into cards: a short run gets a card on each remaining date, a long run one
// card with its date range (the same helper gives each stop page its anchor).
const eventGroups: BoardStop[] = groupBoardStops(rows, today);

// A long run's full card sits on one day only, so each of its later dates
// gets a small "Also running" card under that day instead: every day on the
// board lists everything on, without an exhibit repeating its full card for
// two months. A small card names the run and its dates, and opens into the
// full card for that day.
interface RunningLine {
  /** The run's row for this date; the card opens to this day and links to its page. */
  row: TransitEvent;
  /** The run's one full card. */
  stop: BoardStop;
}
// A day shows this many small cards; the rest sit behind "Show more".
const RUNNING_PREVIEW = 3;
const days = new Map<string, { dayGroups: BoardStop[]; running: RunningLine[] }>();
function dayFor(date: string) {
  let day = days.get(date);
  if (!day) {
    day = { dayGroups: [], running: [] };
    days.set(date, day);
  }
  return day;
}
for (const stop of eventGroups) {
  dayFor(stop.sortDate).dayGroups.push(stop);
  for (const row of stop.alsoRunning) dayFor(row.event_date).running.push({ row, stop });
}

// Ties a long run's lines to its card for the client filters. The card's
// anchor would not do: it is a slug cut to 80 characters, so two runs can share one.
const stopKeys = new Map(eventGroups.map((stop, index) => [stop, `s${index}`]));

function picksThenTitle(a: TransitEvent, b: TransitEvent) {
  if (a.is_curated !== b.is_curated) return a.is_curated ? -1 : 1;
  return a.title.localeCompare(b.title);
}

// One segment per calendar day with anything on; curated picks lead within a day.
const groupedEventEntries = Array.from(days.entries())
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([eventDate, { dayGroups, running }]) => ({
    eventDate,
    label: formatStopDate(eventDate),
    dayGroups: dayGroups.sort((a, b) => picksThenTitle(a.rep, b.rep)),
    // Picks lead, then whatever closes soonest, so a last chance is not
    // behind "Show more".
    running: running.sort((a, b) => {
      if (a.row.is_curated !== b.row.is_curated) return a.row.is_curated ? -1 : 1;
      return a.stop.end.localeCompare(b.stop.end) || a.row.title.localeCompare(b.row.title);
    }),
  }));

// ItemList structured data for the board, in the order the page prints it and
// pointing at each stop's own page, so a crawler can walk from the board into
// the individual events instead of treating them as one blob of page text.
const boardItemListJsonLd = buildItemListJsonLd(
  `Upcoming stops on ${BRAND_NAME}`,
  groupedEventEntries.flatMap(({ dayGroups }) =>
    dayGroups.map(({ rep }) => ({ name: rep.title, url: buildEventUrl(rep, base, siteUrl) }))
  )
);

// Calendar marks every distinct event date (including individual recurring days).
const eventDates = Array.from(
  new Set(events.map((event) => event.event_date).filter(Boolean))
).sort();

function isFreeEvent(event: TransitEvent) {
  const cost = event.cost_info?.toLowerCase() ?? '';
  return /\bfree\b/.test(cost) && !/\bnot free\b/.test(cost);
}

// Canonical order for the diaspora community tags; anything else falls to the end.
const CATEGORY_ORDER = [
  'South Asian',
  'SWANA',
  'East Asian',
  'Southeast Asian',
  'Black Diaspora',
  'Latine',
  'Afro-Latine',
  'Indigenous',
  'Cross-cultural',
];
const categories = Array.from(new Set(events.flatMap((event) => event.tags ?? []))).sort((a, b) => {
  const ia = CATEGORY_ORDER.indexOf(a);
  const ib = CATEGORY_ORDER.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});
const neighborhoods = Array.from(
  new Set(
    events
      .map((event) => event.neighborhood)
      .filter((value): value is string => Boolean(value && value.trim()))
  )
).sort((a, b) => a.localeCompare(b));
const controlsGridClass =
  neighborhoods.length > 0
    ? 'lg:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))]'
    : 'lg:grid-cols-[minmax(0,1.6fr)_repeat(2,minmax(0,1fr))]';
const stopColors = ['bg-babyPink', 'bg-mayaBlue', 'bg-celadon', 'bg-amber', 'bg-cayenne'];
const pageDescription =
  "Chicago's Global South diaspora events, curated by a human: arts, culture, food, film, music, and community stops across the city's neighborhoods. Updated as new stops come in.";

function getEventKind(event: TransitEvent) {
  if (event.is_giveaway) return 'giveaway';
  if (event.is_curated) return 'curated';
  return 'regular';
}

// Mirrors EventCard's display normalization so searching the rendered spelling
// ("Türkiye") still matches rows stored as "Turkiye".
function fixSpelling(value: string) {
  return value.replace(/\bTurkiye\b/g, 'Türkiye').replace(/\bTURKIYE\b/g, 'TÜRKIYE');
}

function getEventSearchText(event: TransitEvent) {
  const raw = [
    event.title,
    event.description,
    event.venue,
    event.organizer,
    event.cost_info,
    event.neighborhood,
    ...(event.tags ?? []),
  ]
    .filter(Boolean)
    .join(' ');
  // Index both spellings so either one matches a search, and fold accents so
  // "dimelo" finds "Dímelo" (the client folds the typed query the same way).
  const fixed = fixSpelling(raw);
  const text = (fixed === raw ? raw : `${raw} ${fixed}`).toLowerCase();
  return `${text} ${foldAccents(text)}`;
}

function foldAccents(value: string) {
  return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

// "Nov 23 – Jan 25 · 11 AM to 5 PM · Art Institute of Chicago" for a small
// "Also running" card: the run's first and last date, that day's own hours,
// and the venue's name without its street address.
function getRunningMeta({ row, stop }: RunningLine) {
  const venueName = fixSpelling(row.venue).split(',')[0].trim();
  const dates = `${formatMonthDay(stop.start)} – ${formatMonthDay(stop.end)}`;
  return [dates, formatTimeRange(row.start_time, row.end_time), venueName].filter(Boolean).join(' · ');
}
---
<Layout
  title="Chicago Global South Diaspora Events | The Brown Line"
  description={pageDescription}
>
  {events.length > 0 && (
    <script type="application/ld+json" set:html={stringifyJsonLd(boardItemListJsonLd)} />
  )}

  <section class="px-6 py-16 md:py-24 lg:py-28">
    <div class="max-w-5xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenneInk font-bold mb-5">
        Now boarding
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] gap-10 lg:gap-14 items-end">
        <div>
          <h1 class="font-heading font-extrabold text-darkWalnut text-[2.5rem] sm:text-5xl md:text-6xl lg:text-7xl leading-[1.02] text-balance">
            Find your <em class="not-italic text-cayenne">next stop</em>.
          </h1>
        </div>
        <div class="max-w-xl">
          <p class="font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed">
            Curated events across Chicago's Global South diaspora — from film screenings and artist talks to food pop-ups, fundraisers, dance floors, workshops and more.
          </p>
          <a
            href={`${base}submit-event`}
            data-ga-event="submit_click"
            data-ga-label="events_hero"
            class="mt-6 inline-flex items-center gap-2 border-2 border-darkWalnut bg-amber px-4 py-2.5 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut shadow-retro transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
          >
            Submit an event
            <span aria-hidden="true">&rarr;</span>
          </a>
          <p class="mt-4">
            <a
              href={`${base}about#ethics`}
              data-ga-event="standards_click"
              data-ga-label="events_hero"
              class="inline-flex items-center gap-1.5 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut/70 transition-colors hover:text-cayenneInk focus-visible:text-cayenneInk focus-visible:outline-none"
            >
              How we curate
              <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6">
    <TransitDivider />
  </div>

  {events.length > 0 && (
    <section class="px-4 pt-8 sm:px-6 md:pt-20">
      <div
        data-event-controls
        data-event-dates={JSON.stringify(eventDates)}
        class="max-w-5xl mx-auto border-2 border-darkWalnut bg-[#FDFBF7] p-4 shadow-[3px_3px_0_#642713] md:p-5 md:shadow-retro"
      >
        <div class="flex items-start justify-between gap-3 md:items-center">
          <div class="min-w-0">
            <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenneInk font-bold">
              Filter the route
            </p>
            <p
              data-event-result-count
              class="font-heading text-darkWalnut text-[2rem] sm:text-4xl md:text-5xl leading-none mt-1.5"
              aria-live="polite"
            >
              {eventGroups.length === 1 ? '1 stop' : `${eventGroups.length} stops`}
            </p>
          </div>
          <button
            type="button"
            data-reset-filters
            class="shrink-0 self-start font-body text-[10px] sm:text-xs font-bold uppercase tracking-widest text-darkWalnut border-2 border-darkWalnut px-3 py-2 transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:shadow-retro focus-visible:outline-none md:self-auto md:px-4"
          >
            Reset
          </button>
        </div>

        <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Quick filters">
          <button type="button" data-quick-filter="week" data-ga-event="events_filter" data-ga-label="this_week" class="quick-chip" aria-pressed="false">This week</button>
          <button type="button" data-quick-filter="weekend" data-ga-event="events_filter" data-ga-label="this_weekend" class="quick-chip" aria-pressed="false">This weekend</button>
          <button type="button" data-quick-filter="all" data-ga-event="events_filter" data-ga-label="all_upcoming" class="quick-chip is-active" aria-pressed="true">All upcoming</button>
          <button type="button" data-quick-filter="free" data-ga-event="events_filter" data-ga-label="free" class="quick-chip" aria-pressed="false">Free</button>
          <button type="button" data-quick-filter="curated" data-ga-event="events_filter" data-ga-label="conductors_picks" class="quick-chip" aria-pressed="false">★ Conductor's picks</button>
        </div>

        <div class:list={['mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 md:mt-5', controlsGridClass]}>
          <label class="block min-w-0 sm:col-span-2 lg:col-span-1">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/75">
              Search
            </span>
            <input
              data-event-search-input
              type="search"
              placeholder="Title, venue, organizer"
              class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
            />
          </label>

          <div class="block min-w-0">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/75">
              Date
            </span>
            <EventDatePicker />
          </div>

          <div class="block min-w-0">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/75">
              Category
            </span>
            <EventSelect field="category-filter" label="Category" placeholder="All categories" options={categories} />
          </div>

          {neighborhoods.length > 0 && (
            <div class="block min-w-0">
              <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/75">
                Neighborhood
              </span>
              <EventSelect field="neighborhood-filter" label="Neighborhood" placeholder="All neighborhoods" options={neighborhoods} />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="px-6 py-16 md:py-24">
    <div class="max-w-5xl mx-auto">
      {events.length === 0 ? (
        <div class="border-2 border-darkWalnut bg-seashell p-8 md:p-10 shadow-retro">
          <p class="font-body uppercase text-xs tracking-[0.3em] text-cayenneInk font-bold">No scheduled stops</p>
          <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-none mt-3">
            New stops are on the way.
          </h2>
          <p class="font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed mt-5 max-w-2xl">
            The board updates as new stops come in. Check back soon, or submit an event to put it on the map.
          </p>
        </div>
      ) : (
        <>
          <div
            data-no-event-matches
            hidden
            class="border-2 border-darkWalnut bg-seashell p-8 md:p-10 shadow-retro"
          >
            <p class="font-body uppercase text-xs tracking-[0.3em] text-cayenneInk font-bold">
              No matching stops
            </p>
            <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-none mt-3">
              Try a different route.
            </h2>
            <p class="font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed mt-4 max-w-2xl">
              No stops match these filters. Try All upcoming, or clear a filter.
            </p>
          </div>

          <div data-events-board data-running-preview={RUNNING_PREVIEW} class="space-y-14 md:space-y-16">
            {groupedEventEntries.map(({ eventDate, label, dayGroups, running }, sectionIndex) => (
            <section
              data-event-day-section
              data-event-date={eventDate}
              class="grid grid-cols-1 md:grid-cols-[14rem_minmax(0,1fr)] gap-8 md:gap-10"
            >
              <div>
                {sectionIndex === 0 && (
                  <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenneInk font-bold mb-3">
                    Platform
                  </p>
                )}
                <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-none">
                  {label}
                </h2>
              </div>

              <ol class="events-route relative min-w-0 space-y-6">
                {dayGroups.map((stop, index) => (
                  <li
                    id={stop.anchor}
                    data-event-card
                    data-stop={stopKeys.get(stop)}
                    data-event-date={stop.rep.event_date}
                    data-event-free={isFreeEvent(stop.rep) ? 'true' : 'false'}
                    data-event-kind={getEventKind(stop.rep)}
                    data-event-curated={stop.rep.is_curated ? 'true' : 'false'}
                    data-event-giveaway={stop.rep.is_giveaway ? 'true' : 'false'}
                    data-event-tags={(stop.rep.tags ?? []).join('|')}
                    data-event-neighborhood={stop.rep.neighborhood ?? ''}
                    data-event-search={getEventSearchText(stop.rep)}
                    data-has-link={stop.rep.event_url ? 'true' : 'false'}
                    class="relative pl-12 md:pl-14"
                  >
                    <span
                      class:list={[
                        'event-stop absolute left-0 top-7 h-[22px] w-[22px] rounded-full border-2 border-darkWalnut shadow-[2px_2px_0_#642713]',
                        stopColors[index % stopColors.length],
                      ]}
                      aria-hidden="true"
                    ></span>

                    <EventCard event={stop.rep} recurrenceLabel={stop.recurrenceLabel} />
                  </li>
                ))}

                {running.length > 0 && (
                  <li data-running-group class="relative pl-12 md:pl-14">
                    <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenneInk">
                      Also running
                      <span data-running-count class="ml-1 font-mono text-[11px] tracking-normal text-darkWalnut">{running.length}</span>
                    </p>
                    <ul class="mt-2.5 space-y-2">
                      {running.map((line, lineIndex) => (
                        <li
                          data-running-line
                          data-stop={stopKeys.get(line.stop)}
                          data-event-date={line.row.event_date}
                          data-event-time={formatTimeRange(line.row.start_time, line.row.end_time)}
                          data-event-free={isFreeEvent(line.row) ? 'true' : 'false'}
                          data-event-curated={line.row.is_curated ? 'true' : 'false'}
                          data-event-tags={(line.row.tags ?? []).join('|')}
                          data-event-neighborhood={line.row.neighborhood ?? ''}
                          class:list={['relative', lineIndex >= RUNNING_PREVIEW && 'is-extra']}
                        >
                          <span class="running-stop" aria-hidden="true"></span>
                          <details data-running-card class="running-card border-2 border-darkWalnut/30 bg-[#FDFBF7]">
                            <summary class="cursor-pointer px-3.5 py-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue">
                              <span class="flex items-center gap-3">
                                <span class="min-w-0 flex-1">
                                  <span class="block font-card text-sm font-bold leading-snug text-darkWalnut">
                                    {line.row.is_curated && <span aria-hidden="true">★ </span>}{fixSpelling(line.row.title)}
                                  </span>
                                  <span class="mt-0.5 block font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-darkWalnut/70">
                                    {getRunningMeta(line)}
                                  </span>
                                </span>
                                {line.row.event_date === line.stop.end && (
                                  <span class="shrink-0 border-2 border-darkWalnut bg-amber px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-darkWalnut">
                                    Last day
                                  </span>
                                )}
                                <span class="running-chevron shrink-0" aria-hidden="true"></span>
                              </span>
                            </summary>
                            {/* Opened, the page script swaps this link for the run's full card,
                                set to this day. The link is what a visitor without it gets. */}
                            <div data-running-body class="border-t-2 border-darkWalnut/30 p-3">
                              <a
                                href={buildEventPath(line.row, base)}
                                data-ga-event="event_detail_click"
                                data-ga-label={line.row.title}
                                class="link-transit font-card text-[13px] font-bold text-darkWalnut transition-colors hover:text-cayenneInk focus-visible:text-cayenneInk focus-visible:outline-none"
                              >
                                Full details for {formatStopDate(line.row.event_date)} <span aria-hidden="true">&rarr;</span>
                              </a>
                            </div>
                          </details>
                        </li>
                      ))}
                    </ul>
                    {running.length > RUNNING_PREVIEW && (
                      <button
                        type="button"
                        data-running-more
                        aria-expanded="false"
                        class="mt-2.5 font-card text-[11px] font-bold uppercase tracking-[0.12em] text-cayenneInk underline decoration-2 underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
                      >
                        Show {running.length - RUNNING_PREVIEW} more
                      </button>
                    )}
                  </li>
                )}
              </ol>
            </section>
          ))}
          </div>

          {/* One full card per long run, cloned into a small "Also running"
              card when it is opened and set to that card's day. */}
          {eventGroups.filter((stop) => stop.alsoRunning.length > 0).map((stop) => (
            <template data-stop-card={stopKeys.get(stop)}>
              <EventCard event={stop.rep} recurrenceLabel={stop.recurrenceLabel} runTemplate />
            </template>
          ))}
          <noscript>
            <style is:inline>
              [data-running-line].is-extra { display: block !important; }
              [data-running-more] { display: none; }
            </style>
          </noscript>
        </>
      )}
    </div>
  </section>

</Layout>

<style>
  /* Quick-filter chips (This week / This weekend / All upcoming / Free) */
  .quick-chip {
    display: inline-flex;
    align-items: center;
    border: 2px solid #642713;
    background: #FAF1EC;
    color: #642713;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    transition: transform 120ms ease, background-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
  }

  .quick-chip:hover,
  .quick-chip:focus-visible {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 #642713;
    outline: none;
  }

  .quick-chip.is-active {
    background: #642713;
    color: #FAF1EC;
  }

  .events-route::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 2.25rem;
    bottom: 2.25rem;
    width: 2px;
    background: #642713;
  }

  @media (min-width: 768px) {
    .events-route::before {
      left: 10px;
    }
  }

  /* "Also running": a small card per long run still going that day, each on
     the route under a hollow stop. Past the first few, the rest wait behind
     "Show more". */
  [data-running-group]:not([data-open='true']) .is-extra {
    display: none;
  }

  .running-stop {
    position: absolute;
    left: calc(-3rem + 5px);
    top: 0.95rem;
    width: 12px;
    height: 12px;
    border: 2px solid #642713;
    border-radius: 9999px;
    background: #FAF1EC;
  }

  @media (min-width: 768px) {
    .running-stop {
      left: calc(-3.5rem + 5px);
    }
  }

  .running-card > summary {
    list-style: none;
  }

  .running-card > summary::-webkit-details-marker {
    display: none;
  }

  .running-card[open] {
    border-color: #642713;
  }

  .running-chevron {
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.125rem;
    border-right: 2px solid #642713;
    border-bottom: 2px solid #642713;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 120ms ease;
  }

  .running-card[open] .running-chevron {
    transform: translateY(2px) rotate(225deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .running-chevron {
      transition: none;
    }
  }

  [data-event-card].is-past-event .event-stop {
    opacity: 0.35;
    filter: grayscale(1);
    box-shadow: none;
  }

  [data-event-card].is-past-event :is(article, a) {
    opacity: 0.45;
    filter: grayscale(1);
  }

  [data-event-card].is-past-event :is(article, a):hover {
    transform: none !important;
    box-shadow: none !important;
  }

  [data-event-day-section].is-past-day > div:first-child {
    opacity: 0.45;
    filter: grayscale(1);
  }

</style>

<script>
  const controls = document.querySelector('[data-event-controls]');

  if (controls) {
    const getControlFields = (selector) => Array.from(controls.querySelectorAll(selector));
    const searchInput = controls.querySelector('[data-event-search-input]');
    const categorySelect = controls.querySelector('[data-category-filter]');
    const neighborhoodSelect = controls.querySelector('[data-neighborhood-filter]');
    const resetButtons = getControlFields('[data-reset-filters]');
    const resultCounts = getControlFields('[data-event-result-count]');
    const calendarRoots = getControlFields('[data-calendar]');
    const quickFilterButtons = getControlFields('[data-quick-filter]');
    // Scope the filterable set to the upcoming board so the static past-stops
    // archive is never hidden, counted, or re-ordered by the client filters.
    const board = document.querySelector('[data-events-board]');
    const eventCards = board ? Array.from(board.querySelectorAll('[data-event-card]')) : [];
    const daySections = board ? Array.from(board.querySelectorAll('[data-event-day-section]')) : [];
    // A long run has one full card, on its first day; each later day carries
    // a small "Also running" card for it (a "line" below). Lines are filtered
    // like cards; a line and its run's card share a `data-stop` key, and a
    // line is searched by that card's text.
    const runningGroups = board ? Array.from(board.querySelectorAll('[data-running-group]')) : [];
    const runningPreview = Number(board?.dataset.runningPreview) || 3;
    const runningLines = board ? Array.from(board.querySelectorAll('[data-running-line]')) : [];
    const searchTextByStop = new Map(
      eventCards.map((card) => [card.dataset.stop, card.dataset.eventSearch ?? ''])
    );
    const noMatches = document.querySelector('[data-no-event-matches]');

    let eventDates = [];
    try {
      eventDates = JSON.parse(controls?.dataset.eventDates ?? '[]');
    } catch (_) {
      eventDates = [];
    }
    const eventDateSet = new Set(eventDates);

    let selectedDate = '';
    let pendingScrollDate = null;
    // Date-range mode: 'all' (default) | 'week' | 'weekend'. 'free' is a separate
    // toggle. The board defaults to All upcoming so the full slate is visible;
    // the This week / This weekend chips narrow it.
    const DEFAULT_DATE_MODE = 'all';
    let dateMode = DEFAULT_DATE_MODE;
    let freeOnly = false;
    let curatedOnly = false;

    // Lowercase and fold accents so a query typed without diacritics still
    // matches (the build-time search text is folded the same way).
    const normalize = (value) =>
      value.toString().trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const pad = (value) => String(value).padStart(2, '0');

    function addDays(dateString, days) {
      const [y, m, d] = dateString.split('-').map(Number);
      const next = new Date(Date.UTC(y, m - 1, d + days));
      return `${next.getUTCFullYear()}-${pad(next.getUTCMonth() + 1)}-${pad(next.getUTCDate())}`;
    }

    function getChicagoDateString() {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(new Date());

      const byType = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      return `${byType.year}-${byType.month}-${byType.day}`;
    }

    const today = getChicagoDateString();

    // The lower/upper date bounds for the active quick-filter mode. A past
    // calendar pick lowers the floor so events from that day onward reappear.
    function getActiveRange() {
      const floor = selectedDate && selectedDate < today ? selectedDate : today;
      if (dateMode === 'all') {
        return { lo: floor, hi: '9999-12-31' };
      }
      if (dateMode === 'weekend') {
        const dow = new Date(`${today}T00:00:00Z`).getUTCDay(); // 0 Sun .. 6 Sat
        let sat;
        let sun;
        if (dow === 0) {
          sat = addDays(today, -1);
          sun = today;
        } else {
          sat = addDays(today, (6 - dow + 7) % 7);
          sun = addDays(sat, 1);
        }
        return { lo: sat < floor ? floor : sat, hi: sun };
      }
      // 'week': today (or lowered floor) through the next 6 days.
      return { lo: floor, hi: addDays(floor, 6) };
    }

    function syncQuickFilters() {
      quickFilterButtons.forEach((button) => {
        const kind = button.dataset.quickFilter;
        const active =
          kind === 'free' ? freeOnly : kind === 'curated' ? curatedOnly : dateMode === kind;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function formatDateLabel(dateString) {
      const [year, month, day] = dateString.split('-').map(Number);
      if (!year || !month || !day) return 'Any date';
      return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      });
    }

    function formatMonthTitle(year, month) {
      return new Date(Date.UTC(year, month, 1)).toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      });
    }

    /* ---------- Calendar widgets ---------- */
    const calendars = [];

    function closeAllCalendars(except = null) {
      calendars.forEach((calendar) => {
        if (calendar.root !== except) calendar.close();
      });
    }

    function setSelectedDate(date) {
      selectedDate = date || '';
      // Picking a specific day implies "show me everything from here": widen the
      // window to all upcoming so the chosen day isn't hidden by the week/weekend
      // chip, then jump to it. Clearing the date returns to the default week view.
      if (selectedDate) {
        dateMode = 'all';
        syncQuickFilters();
      }
      // Choosing a date is a JUMP, not a hard filter: scroll to that day while
      // keeping the surrounding events visible. Clearing it scrolls nowhere.
      pendingScrollDate = selectedDate || null;
      calendars.forEach((calendar) => {
        calendar.syncLabel();
        if (calendar.isOpen()) {
          // Move the (possibly always-open inline) calendar to the selected
          // month so the new selection is rendered and highlighted.
          calendar.syncView();
          calendar.renderGrid();
        }
      });
      renderFilters();
    }

    function createCalendar(root) {
      const inline = root.dataset.calendarInline === 'true';
      const trigger = root.querySelector('[data-calendar-trigger]');
      const label = root.querySelector('[data-calendar-label]');
      const popover = root.querySelector('[data-calendar-popover]');
      const title = root.querySelector('[data-calendar-title]');
      const grid = root.querySelector('[data-calendar-grid]');
      const prevButton = root.querySelector('[data-calendar-prev]');
      const nextButton = root.querySelector('[data-calendar-next]');
      const clearButton = root.querySelector('[data-calendar-clear]');

      const base = (selectedDate || today).split('-').map(Number);
      let viewYear = base[0];
      let viewMonth = base[1] - 1;

      function renderGrid() {
        if (!grid || !title) return;
        title.textContent = formatMonthTitle(viewYear, viewMonth);
        const firstWeekday = new Date(Date.UTC(viewYear, viewMonth, 1)).getUTCDay();
        const daysInMonth = new Date(Date.UTC(viewYear, viewMonth + 1, 0)).getUTCDate();

        let html = '';
        for (let i = 0; i < firstWeekday; i += 1) {
          html += '<span aria-hidden="true"></span>';
        }
        for (let day = 1; day <= daysInMonth; day += 1) {
          const dateString = `${viewYear}-${pad(viewMonth + 1)}-${pad(day)}`;
          const classes = ['bl-cal-day'];
          if (eventDateSet.has(dateString)) classes.push('has-event');
          if (dateString === today) classes.push('is-today');
          const isSelected = dateString === selectedDate;
          if (isSelected) classes.push('is-selected');
          html += `<button type="button" class="${classes.join(' ')}" data-calendar-day="${dateString}"${
            isSelected ? ' aria-pressed="true"' : ''
          }>${day}</button>`;
        }
        grid.innerHTML = html;
      }

      function syncView() {
        const next = (selectedDate || today).split('-').map(Number);
        viewYear = next[0];
        viewMonth = next[1] - 1;
      }

      function open() {
        if (inline || !popover) return;
        closeAllThemed();
        syncView();
        renderGrid();
        popover.hidden = false;
        trigger?.setAttribute('aria-expanded', 'true');
        // Move focus into the popover (selected day, else today, else first day).
        const focusTarget =
          grid?.querySelector('.bl-cal-day.is-selected') ||
          grid?.querySelector('.bl-cal-day.is-today') ||
          grid?.querySelector('.bl-cal-day');
        focusTarget?.focus({ preventScroll: true });
      }

      function close(returnFocus = false) {
        if (inline || !popover) return;
        popover.hidden = true;
        trigger?.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger?.focus();
      }

      function isOpen() {
        return inline || (popover ? !popover.hidden : false);
      }

      function syncLabel() {
        if (!label) return;
        label.textContent = selectedDate ? formatDateLabel(selectedDate) : 'Any date';
        label.classList.toggle('text-cayenneInk', Boolean(selectedDate));
      }

      trigger?.addEventListener('click', () => {
        if (popover && popover.hidden) {
          closeAllCalendars(root);
          open();
        } else {
          close();
        }
      });

      prevButton?.addEventListener('click', () => {
        viewMonth -= 1;
        if (viewMonth < 0) {
          viewMonth = 11;
          viewYear -= 1;
        }
        renderGrid();
      });

      nextButton?.addEventListener('click', () => {
        viewMonth += 1;
        if (viewMonth > 11) {
          viewMonth = 0;
          viewYear += 1;
        }
        renderGrid();
      });

      grid?.addEventListener('click', (event) => {
        const dayButton = event.target.closest('[data-calendar-day]');
        if (!dayButton) return;
        setSelectedDate(dayButton.dataset.calendarDay);
        close();
      });

      clearButton?.addEventListener('click', () => {
        setSelectedDate('');
        close();
      });

      popover?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !inline) {
          event.preventDefault();
          close(true);
        }
      });

      const api = { root, isOpen, open, close, renderGrid, syncLabel, syncView };
      if (inline) renderGrid();
      syncLabel();
      calendars.push(api);
      return api;
    }

    /* ---------- Themed dropdowns (desktop) ---------- */
    const themedSelects = [];

    function closeAllThemed(except = null) {
      themedSelects.forEach((select) => {
        if (select.root !== except) select.close();
      });
    }

    function refreshThemed() {
      themedSelects.forEach((select) => select.sync());
    }

    function initThemedSelect(root) {
      const native = root.querySelector('[data-themed-native]');
      const trigger = root.querySelector('[data-themed-trigger]');
      const label = root.querySelector('[data-themed-label]');
      const popover = root.querySelector('[data-themed-popover]');
      if (!native || !trigger || !label || !popover) return;

      const placeholder = native.options[0]?.textContent ?? '';
      const optionEls = () => Array.from(popover.querySelectorAll('[data-themed-option]'));

      function buildOptions() {
        popover.innerHTML = '';
        Array.from(native.options).forEach((option) => {
          // role="option" elements (not buttons) so they don't each become a tab
          // stop; keyboard navigation is handled by the listbox below.
          const el = document.createElement('div');
          el.setAttribute('role', 'option');
          el.tabIndex = -1;
          el.className = 'bl-themed-option';
          el.dataset.themedOption = option.value;
          el.textContent = option.textContent;
          popover.appendChild(el);
        });
      }

      function sync() {
        const selected = native.options[native.selectedIndex];
        label.textContent = selected ? selected.textContent : placeholder;
        label.classList.toggle('text-cayenneInk', Boolean(native.value));
        optionEls().forEach((el) => {
          const active = el.dataset.themedOption === native.value;
          el.setAttribute('aria-selected', active ? 'true' : 'false');
          el.classList.toggle('is-active', active);
        });
      }

      function selectValue(value) {
        native.value = value;
        native.dispatchEvent(new Event('change', { bubbles: true }));
      }

      function focusOption(index) {
        const els = optionEls();
        if (!els.length) return;
        els[Math.max(0, Math.min(index, els.length - 1))].focus();
      }

      function open() {
        closeAllThemed(root);
        closeAllCalendars();
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        sync();
        const els = optionEls();
        const activeIndex = els.findIndex((el) => el.dataset.themedOption === native.value);
        focusOption(activeIndex >= 0 ? activeIndex : 0);
      }

      function close(returnFocus = false) {
        if (popover.hidden) return;
        popover.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger.focus();
      }

      function isOpen() {
        return !popover.hidden;
      }

      trigger.addEventListener('click', () => {
        if (isOpen()) close();
        else open();
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (!isOpen()) open();
        }
      });

      popover.addEventListener('click', (event) => {
        const el = event.target.closest('[data-themed-option]');
        if (!el) return;
        selectValue(el.dataset.themedOption);
        close(true);
      });

      popover.addEventListener('keydown', (event) => {
        const els = optionEls();
        const current = els.indexOf(document.activeElement);
        switch (event.key) {
          case 'ArrowDown':
            event.preventDefault();
            focusOption(current + 1);
            break;
          case 'ArrowUp':
            event.preventDefault();
            focusOption(current - 1);
            break;
          case 'Home':
            event.preventDefault();
            focusOption(0);
            break;
          case 'End':
            event.preventDefault();
            focusOption(els.length - 1);
            break;
          case 'Enter':
          case ' ':
            event.preventDefault();
            if (document.activeElement?.dataset?.themedOption !== undefined) {
              selectValue(document.activeElement.dataset.themedOption);
              close(true);
            }
            break;
          case 'Escape':
            event.preventDefault();
            close(true);
            break;
          case 'Tab':
            close();
            break;
          default:
            break;
        }
      });

      native.addEventListener('change', sync);

      buildOptions();
      sync();
      themedSelects.push({ root, close, isOpen, sync });
    }

    /* ---------- Filtering ---------- */
    // Decides a card and an "Also running" line alike.
    function eventMatches(card) {
      const query = normalize(searchInput?.value ?? '');
      const category = categorySelect?.value ?? '';
      const neighborhood = neighborhoodSelect?.value ?? '';
      const cardDate = card.dataset.eventDate ?? '';
      const cardTags = (card.dataset.eventTags ?? '').split('|').filter(Boolean);
      const cardNeighborhood = card.dataset.eventNeighborhood ?? '';
      const isFree = card.dataset.eventFree === 'true';

      const searchText = card.dataset.eventSearch ?? searchTextByStop.get(card.dataset.stop) ?? '';
      if (query && !searchText.includes(query)) return false;

      // Each card and line stands for one day (a long run is its card plus a
      // line on every later day), so it matches when that day is in the active
      // window. Searching expands the window to all upcoming, since a search
      // means "find this anywhere," not "only this week."
      const range = getActiveRange();
      const hi = query ? '9999-12-31' : range.hi;
      if (cardDate && (cardDate < range.lo || cardDate > hi)) return false;

      if (freeOnly && !isFree) return false;
      if (curatedOnly && card.dataset.eventCurated !== 'true') return false;
      if (category && !cardTags.includes(category)) return false;
      if (neighborhood && cardNeighborhood !== neighborhood) return false;

      return true;
    }

    function renderFilters() {
      // Stops on screen: every card, plus every long run showing only as
      // lines, counted once however many days it is listed under.
      const visibleStops = new Set();

      eventCards.forEach((card) => {
        const shouldShow = eventMatches(card);
        card.hidden = !shouldShow;
        if (shouldShow) visibleStops.add(card.dataset.stop);
      });

      // The board is a list of days, so a long run is named under every day
      // it is on. An open-ended window (All upcoming, or any search) narrowed
      // by search, Category, Neighborhood, Free, or picks reads as a list of
      // stops instead, where a run shows once: its card, or failing that its
      // first line, rather than the same exhibit under sixty day headings.
      const query = normalize(searchInput?.value ?? '');
      const oncePerRun =
        (dateMode === 'all' || Boolean(query)) &&
        Boolean(query || categorySelect?.value || neighborhoodSelect?.value || freeOnly || curatedOnly);

      runningLines.forEach((line) => {
        const stop = line.dataset.stop;
        const shouldShow = eventMatches(line) && !(oncePerRun && visibleStops.has(stop));
        line.hidden = !shouldShow;
        if (shouldShow) visibleStops.add(stop);
      });

      // Each day counts the lines the filters kept and shows the first few.
      runningGroups.forEach((group) => {
        const lines = Array.from(group.querySelectorAll('[data-running-line]:not([hidden])'));
        group.hidden = lines.length === 0;
        lines.forEach((line, index) => line.classList.toggle('is-extra', index >= runningPreview));
        const count = group.querySelector('[data-running-count]');
        if (count) count.textContent = String(lines.length);
        syncRunningMore(group, lines.length);
      });

      const visibleCount = visibleStops.size;

      daySections.forEach((section) => {
        const sectionCards = Array.from(section.querySelectorAll('[data-event-card]'));
        const visibleCards = sectionCards.filter((card) => !card.hidden);
        const hasVisibleCard = visibleCards.length > 0;
        const hasVisibleStop =
          hasVisibleCard || Boolean(section.querySelector('[data-running-line]:not([hidden])'));
        const isPastDay =
          hasVisibleCard &&
          visibleCards.every((card) => (card.dataset.eventDate ?? '') < today);
        section.hidden = !hasVisibleStop;
        section.classList.toggle('hidden', !hasVisibleStop);
        section.classList.toggle('is-past-day', isPastDay);
      });

      resultCounts.forEach((resultCount) => {
        resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'stop' : 'stops'}`;
      });

      if (noMatches) {
        noMatches.hidden = visibleCount > 0;
      }

      if (pendingScrollDate) {
        // Jump to the chosen day (or the first stop on/after it) without hiding
        // the rest of the route.
        const targetDate = pendingScrollDate;
        pendingScrollDate = null;
        window.requestAnimationFrame(() => {
          const target = daySections.find(
            (section) => !section.hidden && (section.dataset.eventDate ?? '') >= targetDate
          );
          target?.scrollIntoView({ block: 'start', behavior: 'smooth' });
        });
      }
    }

    // "Show 9 more" / "Show fewer" under a day's small cards.
    function syncRunningMore(group, lineCount) {
      const button = group.querySelector('[data-running-more]');
      if (!button) return;
      const extra = lineCount - runningPreview;
      const open = group.dataset.open === 'true';
      button.hidden = extra <= 0;
      button.textContent = open ? 'Show fewer' : `Show ${extra} more`;
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    // A small card opens into its run's full card, set to the small card's
    // own day: the date tile, that day's hours, and links to that day's page.
    // The full card is rendered once per run in a <template>, not once per day.
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function fillRunningCard(line) {
      const body = line.querySelector('[data-running-body]');
      const template = document.querySelector(`template[data-stop-card="${line.dataset.stop}"]`);
      if (!body || !template || body.dataset.filled === 'true') return;

      const card = template.content.cloneNode(true);
      const dayUrl = body.querySelector('a')?.href ?? '';
      const [, month, day] = (line.dataset.eventDate ?? '').split('-').map(Number);
      const setText = (selector, text) => {
        const node = card.querySelector(selector);
        if (node) node.textContent = text;
      };

      // The run's own card is on the page already, under its first day.
      card.querySelectorAll('[id]').forEach((node) => node.removeAttribute('id'));
      if (month && day) {
        setText('[data-card-month]', MONTHS[month - 1]);
        setText('[data-card-day]', String(day));
      }
      const time = card.querySelector('[data-card-time]');
      if (time && line.dataset.eventTime) time.textContent = line.dataset.eventTime;
      else time?.remove();
      if (dayUrl) {
        card.querySelectorAll('a[data-ga-event="event_detail_click"]').forEach((link) => {
          link.href = dayUrl;
        });
        card.querySelectorAll('[data-share-button]').forEach((button) => {
          button.dataset.shareUrl = dayUrl;
        });
      }

      body.replaceChildren(card);
      body.dataset.filled = 'true';
    }

    // `toggle` does not bubble, so it is caught on the way down.
    board?.addEventListener(
      'toggle',
      (event) => {
        const details = event.target;
        if (!(details instanceof HTMLElement) || !details.matches('[data-running-card]')) return;
        const line = details.closest('[data-running-line]');
        if (details.open && line) fillRunningCard(line);
      },
      true
    );

    board?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-running-more]');
      const group = button?.closest('[data-running-group]');
      if (!group) return;
      group.dataset.open = group.dataset.open === 'true' ? 'false' : 'true';
      syncRunningMore(group, group.querySelectorAll('[data-running-line]:not([hidden])').length);
    });

    function resetFilters() {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = '';
      if (neighborhoodSelect) neighborhoodSelect.value = '';
      refreshThemed();
      dateMode = DEFAULT_DATE_MODE;
      freeOnly = false;
      curatedOnly = false;
      syncQuickFilters();
      setSelectedDate('');
    }

    /* ---------- Wiring ---------- */
    quickFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const kind = button.dataset.quickFilter;
        if (kind === 'free') {
          freeOnly = !freeOnly;
        } else if (kind === 'curated') {
          curatedOnly = !curatedOnly;
        } else {
          dateMode = kind;
          if (selectedDate) {
            // A range chip takes over date filtering: clear the calendar pick so
            // its highlighted day doesn't linger while no longer driving results.
            // setSelectedDate('') re-syncs the calendars and re-renders.
            syncQuickFilters();
            setSelectedDate('');
            return;
          }
        }
        syncQuickFilters();
        renderFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      renderFilters();
    });

    categorySelect?.addEventListener('change', () => {
      refreshThemed();
      renderFilters();
    });

    neighborhoodSelect?.addEventListener('change', () => {
      refreshThemed();
      renderFilters();
    });

    resetButtons.forEach((button) => button.addEventListener('click', resetFilters));

    calendarRoots.forEach((root) => createCalendar(root));
    getControlFields('[data-themed-select]').forEach((root) => initThemedSelect(root));

    document.addEventListener('click', (event) => {
      if (!event.target.closest('[data-calendar]')) closeAllCalendars();
      if (!event.target.closest('[data-themed-select]')) closeAllThemed();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeAllCalendars();
        closeAllThemed();
      }
    });

    eventCards.forEach((card) => {
      card.classList.toggle('is-past-event', (card.dataset.eventDate ?? '') < today);
    });

    syncQuickFilters();

    // A date that exists on the calendar, not just one shaped like it, so a
    // mangled link ("2026-13-45") is ignored instead of rendering a bad month.
    function isRealDateString(value) {
      const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
      if (!match) return false;
      const [year, month, day] = [Number(match[1]), Number(match[2]), Number(match[3])];
      const date = new Date(Date.UTC(year, month - 1, day));
      return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
    }

    // Deep link: /events?date=YYYY-MM-DD (used by the nav mini calendar)
    // preselects that day and jumps to it, same as picking it in the filter
    // calendar. setSelectedDate re-renders, so skip the plain renderFilters.
    const paramDate = new URLSearchParams(window.location.search).get('date') ?? '';
    if (isRealDateString(paramDate)) {
      setSelectedDate(paramDate);
      // The browser's own load-time scrolling cancels the smooth scroll that
      // setSelectedDate queues, so re-jump instantly once the page settles.
      const jumpToParamDate = () => {
        // Every day with anything on has a section (a run's later days carry
        // its "Also running" line), so the day picked, or the next one, is there.
        const target = daySections.find(
          (section) => !section.hidden && (section.dataset.eventDate ?? '') >= paramDate
        );
        target?.scrollIntoView({ block: 'start' });
      };
      if (document.readyState === 'complete') jumpToParamDate();
      else window.addEventListener('load', jumpToParamDate, { once: true });
    } else {
      renderFilters();
    }
  }
</script>

