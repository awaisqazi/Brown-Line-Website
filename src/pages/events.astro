---
import Layout from '../layouts/Layout.astro';
import TransitDivider from '../components/TransitDivider.astro';
import EventCard from '../components/EventCard.astro';
import EventDatePicker from '../components/EventDatePicker.astro';
import EventSelect from '../components/EventSelect.astro';
import { supabase } from '../lib/supabase';
import type { TransitEvent } from '../lib/supabase';
import { formatStopDate } from '../lib/dates';

const base = import.meta.env.BASE_URL;

const { data, error } = await supabase
  .from('events')
  .select('*')
  .order('event_date', { ascending: true })
  .order('is_curated', { ascending: false })
  .order('title', { ascending: true })
  .returns<TransitEvent[]>();

if (error) {
  throw new Error(`Failed to load events: ${error.message}`);
}

const events = data ?? [];

function getTodayChicago() {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Chicago',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date());
  const byType = Object.fromEntries(parts.map((p) => [p.type, p.value]));
  return `${byType.year}-${byType.month}-${byType.day}`;
}
const today = getTodayChicago();

const MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function monthDay(dateString: string) {
  const [y, m, d] = dateString.split('-').map(Number);
  if (!y || !m || !d) return dateString;
  return `${MONTHS_SHORT[m - 1]} ${d}`;
}

// Collapse identical recurring / multi-day events (same title + venue) into a
// single card with a date range, so a 25-day summer camp doesn't flood the board.
interface EventGroup {
  rep: TransitEvent;
  start: string;
  end: string;
  recurrenceLabel: string;
  sortDate: string;
}

const seriesMap = new Map<string, TransitEvent[]>();
for (const event of events) {
  const key = `${event.title}||${event.venue}`;
  const bucket = seriesMap.get(key);
  if (bucket) bucket.push(event);
  else seriesMap.set(key, [event]);
}

const eventGroups: EventGroup[] = Array.from(seriesMap.values()).map((rows) => {
  const dates = rows.map((r) => r.event_date).filter(Boolean).sort();
  const start = dates[0];
  const end = dates[dates.length - 1];
  // Place the card on its first still-relevant date so an ongoing series surfaces
  // on the board even if it began before today.
  const sortDate = dates.find((d) => d >= today) ?? end;
  const rep = rows.find((r) => r.event_date === sortDate) ?? rows[0];
  const recurrenceLabel = start !== end ? `${monthDay(start)} – ${monthDay(end)}` : '';
  return { rep, start, end, recurrenceLabel, sortDate };
});

const groupedByDate = eventGroups.reduce<Record<string, EventGroup[]>>((groups, group) => {
  (groups[group.sortDate] ??= []).push(group);
  return groups;
}, {});

// One segment per calendar day; curated picks lead within a day.
const groupedEventEntries = Object.entries(groupedByDate)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([eventDate, dayGroups]) => ({
    eventDate,
    label: formatStopDate(eventDate),
    dayGroups: dayGroups.sort((a, b) => {
      if (a.rep.is_curated !== b.rep.is_curated) return a.rep.is_curated ? -1 : 1;
      return a.rep.title.localeCompare(b.rep.title);
    }),
  }));

// Calendar marks every distinct event date (including individual recurring days).
const eventDates = Array.from(
  new Set(events.map((event) => event.event_date).filter(Boolean))
).sort();

function isFreeEvent(event: TransitEvent) {
  const cost = event.cost_info?.toLowerCase() ?? '';
  return /\bfree\b/.test(cost) && !/\bnot free\b/.test(cost);
}

// Canonical order for the diaspora community tags; anything else falls to the end.
const CATEGORY_ORDER = [
  'South Asian',
  'SWANA',
  'East Asian',
  'Southeast Asian',
  'Black Diaspora',
  'Latine',
  'Afro-Latine',
  'Indigenous',
  'Cross-cultural',
];
const categories = Array.from(new Set(events.flatMap((event) => event.tags ?? []))).sort((a, b) => {
  const ia = CATEGORY_ORDER.indexOf(a);
  const ib = CATEGORY_ORDER.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});
const neighborhoods = Array.from(
  new Set(
    events
      .map((event) => event.neighborhood)
      .filter((value): value is string => Boolean(value && value.trim()))
  )
).sort((a, b) => a.localeCompare(b));
const controlsGridClass =
  neighborhoods.length > 0
    ? 'lg:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))]'
    : 'lg:grid-cols-[minmax(0,1.6fr)_repeat(2,minmax(0,1fr))]';
const stopColors = ['bg-babyPink', 'bg-mayaBlue', 'bg-celadon', 'bg-amber', 'bg-cayenne'];
const pageDescription =
  "A curated guide to Chicago's Global South diaspora arts, culture, and community events. Updated weekly.";

function getEventKind(event: TransitEvent) {
  if (event.is_giveaway) return 'giveaway';
  if (event.is_curated) return 'curated';
  return 'regular';
}

function getEventSearchText(event: TransitEvent) {
  return [
    event.title,
    event.description,
    event.venue,
    event.organizer,
    event.cost_info,
    event.neighborhood,
    ...(event.tags ?? []),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
}
---
<Layout
  title="Events | The Brown Line"
  description={pageDescription}
>
  <section class="px-6 py-16 md:py-24 lg:py-28">
    <div class="max-w-5xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-5">
        Now boarding
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] gap-10 lg:gap-14 items-end">
        <div>
          <h1 class="font-heading font-extrabold text-darkWalnut text-[2.5rem] sm:text-5xl md:text-6xl lg:text-7xl leading-[1.02] text-balance">
            Find your <em class="not-italic text-cayenne">next stop</em>.
          </h1>
        </div>
        <div class="max-w-xl">
          <p class="font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed">
            Curated events across Chicago's Global South diaspora: film screenings and artist talks, food pop-ups, fundraisers, dance floors, workshops, and more.
          </p>
          <a
            href={`${base}submit-event`}
            data-ga-event="submit_click"
            data-ga-label="events_hero"
            class="mt-6 inline-flex items-center gap-2 border-2 border-darkWalnut bg-amber px-4 py-2.5 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut shadow-retro transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
          >
            Submit an event
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6">
    <TransitDivider />
  </div>

  {events.length > 0 && (
    <section class="px-4 pt-8 sm:px-6 md:pt-20">
      <div
        data-event-controls
        data-event-dates={JSON.stringify(eventDates)}
        class="max-w-5xl mx-auto border-2 border-darkWalnut bg-[#FDFBF7] p-4 shadow-[3px_3px_0_#642713] md:p-5 md:shadow-retro"
      >
        <div class="flex items-start justify-between gap-3 md:items-center">
          <div class="min-w-0">
            <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">
              Route controls
            </p>
            <p
              data-event-result-count
              class="font-heading text-darkWalnut text-[2rem] sm:text-4xl md:text-5xl leading-none mt-1.5"
              aria-live="polite"
            >
              {events.length} stops
            </p>
          </div>
          <button
            type="button"
            data-reset-filters
            class="shrink-0 self-start font-body text-[10px] sm:text-xs font-bold uppercase tracking-widest text-darkWalnut border-2 border-darkWalnut px-3 py-2 transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:shadow-retro focus-visible:outline-none md:self-auto md:px-4"
          >
            Reset
          </button>
        </div>

        <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Quick filters">
          <button type="button" data-quick-filter="week" data-ga-event="events_filter" data-ga-label="this_week" class="quick-chip is-active" aria-pressed="true">This week</button>
          <button type="button" data-quick-filter="weekend" data-ga-event="events_filter" data-ga-label="this_weekend" class="quick-chip" aria-pressed="false">This weekend</button>
          <button type="button" data-quick-filter="all" data-ga-event="events_filter" data-ga-label="all_upcoming" class="quick-chip" aria-pressed="false">All upcoming</button>
          <button type="button" data-quick-filter="free" data-ga-event="events_filter" data-ga-label="free" class="quick-chip" aria-pressed="false">Free</button>
        </div>

        <div class:list={['mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 md:mt-5', controlsGridClass]}>
          <label class="block min-w-0 sm:col-span-2 lg:col-span-1">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Search
            </span>
            <input
              data-event-search-input
              type="search"
              placeholder="Title, venue, organizer"
              class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
            />
          </label>

          <div class="block min-w-0">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Date
            </span>
            <EventDatePicker />
          </div>

          <div class="block min-w-0">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Category
            </span>
            <EventSelect field="category-filter" label="Category" placeholder="All categories" options={categories} />
          </div>

          {neighborhoods.length > 0 && (
            <div class="block min-w-0">
              <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
                Neighborhood
              </span>
              <EventSelect field="neighborhood-filter" label="Neighborhood" placeholder="All neighborhoods" options={neighborhoods} />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {events.length > 0 && (
    <div
      data-floating-event-controls
      class="fixed inset-x-4 bottom-[calc(env(safe-area-inset-bottom)+5rem)] z-40 md:left-auto md:right-6 md:bottom-6 md:w-[min(31rem,calc(100vw-3rem))]"
      aria-label="Floating event filters"
      aria-hidden="true"
      inert
    >
      <div
        data-floating-panel-shell
        class="floating-event-panel max-h-[calc(100vh-7rem)] overflow-y-auto border-2 border-darkWalnut bg-[#FDFBF7] shadow-retro md:max-h-[calc(100vh-2rem)]"
      >
        <div class="h-1 bg-[linear-gradient(to_right,#F79CD0_0_20%,#5BC3FF_20%_40%,#90D393_40%_60%,#FFBC29_60%_80%,#F35A0F_80%_100%)]"></div>

        <div class="p-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="font-body text-[9px] font-bold uppercase tracking-[0.28em] text-cayenne">
                Line signal
              </p>
              <p
                data-event-result-count
                class="font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut/70"
                aria-live="polite"
              >
                {events.length} stops
              </p>
            </div>

            <div class="flex shrink-0 items-center gap-2">
              <button
                type="button"
                data-floating-minimize
                aria-label="Hide floating filters"
                class="inline-flex h-10 w-10 items-center justify-center border-2 border-darkWalnut bg-seashell font-body text-lg font-bold leading-none text-darkWalnut shadow-[2px_2px_0_#642713] transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >
                <span aria-hidden="true">&rarr;</span>
              </button>

              <button
                type="button"
                data-floating-filter-toggle
                aria-expanded="false"
                aria-controls="floating-event-filters"
                class="inline-flex h-10 w-10 items-center justify-center border-2 border-darkWalnut bg-amber font-body text-xl font-bold leading-none text-darkWalnut shadow-[2px_2px_0_#642713] transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >
                <span data-floating-toggle-symbol aria-hidden="true">+</span>
                <span data-floating-toggle-label class="sr-only">Open event filters</span>
              </button>
            </div>
          </div>

          <label class="mt-3 block">
            <span class="sr-only">Search events</span>
            <input
              data-event-search-input
              type="search"
              placeholder="Search the route"
              class="w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
            />
          </label>

          <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Quick filters">
            <button type="button" data-quick-filter="week" data-ga-event="events_filter" data-ga-label="this_week" class="quick-chip is-active" aria-pressed="true">This week</button>
            <button type="button" data-quick-filter="weekend" data-ga-event="events_filter" data-ga-label="this_weekend" class="quick-chip" aria-pressed="false">This weekend</button>
            <button type="button" data-quick-filter="all" data-ga-event="events_filter" data-ga-label="all_upcoming" class="quick-chip" aria-pressed="false">All upcoming</button>
            <button type="button" data-quick-filter="free" data-ga-event="events_filter" data-ga-label="free" class="quick-chip" aria-pressed="false">Free</button>
          </div>

          <div
            id="floating-event-filters"
            data-floating-filter-panel
            hidden
            class="mt-3 border-t-2 border-dashed border-darkWalnut/35 pt-3"
          >
            <div class="grid grid-cols-1 gap-3">
              <div class="block min-w-0">
                <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  Date
                </span>
                <EventDatePicker inline />
              </div>

              <div class="block min-w-0">
                <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  Category
                </span>
                <EventSelect field="category-filter" label="Category" placeholder="All categories" options={categories} inline />
              </div>

              {neighborhoods.length > 0 && (
                <div class="block min-w-0">
                  <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                    Neighborhood
                  </span>
                  <EventSelect field="neighborhood-filter" label="Neighborhood" placeholder="All neighborhoods" options={neighborhoods} inline />
                </div>
              )}
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-2">
              <button
                type="button"
                data-reset-filters
                class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut border-2 border-darkWalnut bg-seashell px-3 py-2 transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[2px_2px_0_#642713] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >
                Reset
              </button>
            </div>
          </div>
        </div>
      </div>

      <button
        type="button"
        data-floating-restore
        hidden
        aria-label="Show floating filters"
        class="floating-event-restore-tab"
      >
        <span aria-hidden="true">&larr;</span>
      </button>
    </div>
  )}

  <section class="px-6 py-16 md:py-24">
    <div class="max-w-5xl mx-auto">
      {events.length === 0 ? (
        <div class="border-2 border-darkWalnut bg-seashell p-8 md:p-10 shadow-retro">
          <p class="font-body uppercase text-xs tracking-[0.3em] text-cayenne font-bold">No scheduled stops</p>
          <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-none mt-3">
            New stops are on the way.
          </h2>
          <p class="font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed mt-5 max-w-2xl">
            The board updates every week. Check back soon, or submit an event to put it on the map.
          </p>
        </div>
      ) : (
        <>
          <div
            data-no-event-matches
            hidden
            class="border-2 border-darkWalnut bg-seashell p-8 md:p-10 shadow-retro"
          >
            <p class="font-body uppercase text-xs tracking-[0.3em] text-cayenne font-bold">
              No matching stops
            </p>
            <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-none mt-3">
              Try a different route.
            </h2>
            <p class="font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed mt-4 max-w-2xl">
              No stops match these filters. Try All upcoming, or clear a filter.
            </p>
          </div>

          <div data-events-board class="space-y-14 md:space-y-16">
            {groupedEventEntries.map(({ eventDate, label, dayGroups }, sectionIndex) => (
            <section
              data-event-day-section
              data-event-date={eventDate}
              class="grid grid-cols-1 md:grid-cols-[14rem_minmax(0,1fr)] gap-8 md:gap-10"
            >
              <div>
                {sectionIndex === 0 && (
                  <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold mb-3">
                    Platform
                  </p>
                )}
                <h2 class="font-heading font-semibold text-darkWalnut text-3xl md:text-4xl leading-none">
                  {label}
                </h2>
              </div>

              <ol class="events-route relative space-y-6">
                {dayGroups.map(({ rep, start, end, recurrenceLabel }, index) => (
                  <li
                    data-event-card
                    data-event-date={rep.event_date}
                    data-event-start={start}
                    data-event-end={end}
                    data-event-free={isFreeEvent(rep) ? 'true' : 'false'}
                    data-event-kind={getEventKind(rep)}
                    data-event-curated={rep.is_curated ? 'true' : 'false'}
                    data-event-giveaway={rep.is_giveaway ? 'true' : 'false'}
                    data-event-tags={(rep.tags ?? []).join('|')}
                    data-event-neighborhood={rep.neighborhood ?? ''}
                    data-event-search={getEventSearchText(rep)}
                    data-has-link={rep.event_url ? 'true' : 'false'}
                    class="relative pl-12 md:pl-14"
                  >
                    <span
                      class:list={[
                        'event-stop absolute left-0 top-7 h-[22px] w-[22px] rounded-full border-2 border-darkWalnut shadow-[2px_2px_0_#642713]',
                        stopColors[index % stopColors.length],
                      ]}
                      aria-hidden="true"
                    ></span>

                    <EventCard event={rep} recurrenceLabel={recurrenceLabel} />
                  </li>
                ))}
              </ol>
            </section>
          ))}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

<style>
  /* Quick-filter chips (This week / This weekend / All upcoming / Free) */
  .quick-chip {
    display: inline-flex;
    align-items: center;
    border: 2px solid #642713;
    background: #FAF1EC;
    color: #642713;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    transition: transform 120ms ease, background-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
  }

  .quick-chip:hover,
  .quick-chip:focus-visible {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 #642713;
    outline: none;
  }

  .quick-chip.is-active {
    background: #642713;
    color: #FAF1EC;
  }

  .events-route::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 2.25rem;
    bottom: 2.25rem;
    width: 2px;
    background: #642713;
  }

  @media (min-width: 768px) {
    .events-route::before {
      left: 10px;
    }
  }

  [data-event-card].is-past-event .event-stop {
    opacity: 0.35;
    filter: grayscale(1);
    box-shadow: none;
  }

  [data-event-card].is-past-event :is(article, a) {
    opacity: 0.45;
    filter: grayscale(1);
  }

  [data-event-card].is-past-event :is(article, a):hover {
    transform: none !important;
    box-shadow: none !important;
  }

  [data-event-day-section].is-past-day > div:first-child {
    opacity: 0.45;
    filter: grayscale(1);
  }

  [data-floating-event-controls] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  [data-floating-event-controls].is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .floating-event-panel {
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .floating-event-restore-tab {
    position: absolute;
    right: -0.25rem;
    bottom: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 3rem;
    border: 2px solid #642713;
    background: #FFBC29;
    color: #642713;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 2px 2px 0 #642713;
    pointer-events: auto;
  }

  .floating-event-restore-tab[hidden] {
    display: none;
  }

  [data-floating-event-controls].is-minimized .floating-event-panel {
    opacity: 0;
    pointer-events: none;
    transform: translateX(calc(100% + 1rem));
  }

  /* One filter block per breakpoint: the inline "Route controls" serve desktop,
     the floating "Line signal" serves mobile/tablet. Hide the floating copy on
     large screens so the two never appear at once. */
  @media (min-width: 1024px) {
    [data-floating-event-controls] {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-floating-event-controls],
    .floating-event-panel {
      transition: none;
    }
  }
</style>

<script>
  const controls = document.querySelector('[data-event-controls]');
  const floatingControls = document.querySelector('[data-floating-event-controls]');
  const controlScopes = [controls, floatingControls].filter(Boolean);

  if (controlScopes.length > 0) {
    const getControlFields = (selector) =>
      controlScopes.flatMap((scope) => Array.from(scope.querySelectorAll(selector)));
    const searchInputs = getControlFields('[data-event-search-input]');
    const categorySelects = getControlFields('[data-category-filter]');
    const neighborhoodSelects = getControlFields('[data-neighborhood-filter]');
    const resetButtons = getControlFields('[data-reset-filters]');
    const resultCounts = getControlFields('[data-event-result-count]');
    const calendarRoots = getControlFields('[data-calendar]');
    const quickFilterButtons = getControlFields('[data-quick-filter]');
    const floatingToggle = floatingControls?.querySelector('[data-floating-filter-toggle]');
    const floatingMinimize = floatingControls?.querySelector('[data-floating-minimize]');
    const floatingRestore = floatingControls?.querySelector('[data-floating-restore]');
    const floatingToggleSymbol = floatingControls?.querySelector('[data-floating-toggle-symbol]');
    const floatingToggleLabel = floatingControls?.querySelector('[data-floating-toggle-label]');
    const floatingPanel = floatingControls?.querySelector('[data-floating-filter-panel]');
    const floatingPanelShell = floatingControls?.querySelector('[data-floating-panel-shell]');
    const eventCards = Array.from(document.querySelectorAll('[data-event-card]'));
    const daySections = Array.from(document.querySelectorAll('[data-event-day-section]'));
    const noMatches = document.querySelector('[data-no-event-matches]');

    let eventDates = [];
    try {
      eventDates = JSON.parse(controls?.dataset.eventDates ?? '[]');
    } catch (_) {
      eventDates = [];
    }
    const eventDateSet = new Set(eventDates);

    let selectedDate = '';
    let pendingScrollDate = null;
    let controlsAreOutOfView = false;
    let floatingIsMinimized = false;
    // Date-range mode: 'week' (default) | 'weekend' | 'all'. 'free' is a separate toggle.
    let dateMode = 'week';
    let freeOnly = false;

    const normalize = (value) => value.toString().trim().toLowerCase();
    const pad = (value) => String(value).padStart(2, '0');

    function addDays(dateString, days) {
      const [y, m, d] = dateString.split('-').map(Number);
      const next = new Date(Date.UTC(y, m - 1, d + days));
      return `${next.getUTCFullYear()}-${pad(next.getUTCMonth() + 1)}-${pad(next.getUTCDate())}`;
    }

    function getSyncedValue(inputs) {
      return inputs.find((input) => input.value)?.value ?? '';
    }

    function setSyncedValue(inputs, value, source = null) {
      inputs.forEach((input) => {
        if (input !== source) input.value = value;
      });
    }

    function getChicagoDateString() {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(new Date());

      const byType = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      return `${byType.year}-${byType.month}-${byType.day}`;
    }

    const today = getChicagoDateString();

    // The lower/upper date bounds for the active quick-filter mode. A past
    // calendar pick lowers the floor so events from that day onward reappear.
    function getActiveRange() {
      const floor = selectedDate && selectedDate < today ? selectedDate : today;
      if (dateMode === 'all') {
        return { lo: floor, hi: '9999-12-31' };
      }
      if (dateMode === 'weekend') {
        const [, , ] = today.split('-');
        const dow = new Date(`${today}T00:00:00Z`).getUTCDay(); // 0 Sun .. 6 Sat
        let sat;
        let sun;
        if (dow === 0) {
          sat = addDays(today, -1);
          sun = today;
        } else {
          sat = addDays(today, (6 - dow + 7) % 7);
          sun = addDays(sat, 1);
        }
        return { lo: sat < floor ? floor : sat, hi: sun };
      }
      // 'week': today (or lowered floor) through the next 6 days.
      return { lo: floor, hi: addDays(floor, 6) };
    }

    function syncQuickFilters() {
      quickFilterButtons.forEach((button) => {
        const kind = button.dataset.quickFilter;
        const active = kind === 'free' ? freeOnly : dateMode === kind;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function formatDateLabel(dateString) {
      const [year, month, day] = dateString.split('-').map(Number);
      if (!year || !month || !day) return 'Any date';
      return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      });
    }

    function formatMonthTitle(year, month) {
      return new Date(Date.UTC(year, month, 1)).toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      });
    }

    /* ---------- Calendar widgets ---------- */
    const calendars = [];

    function closeAllCalendars(except = null) {
      calendars.forEach((calendar) => {
        if (calendar.root !== except) calendar.close();
      });
    }

    function setSelectedDate(date) {
      selectedDate = date || '';
      // Picking a specific day implies "show me everything from here": widen the
      // window to all upcoming so the chosen day isn't hidden by the week/weekend
      // chip, then jump to it. Clearing the date returns to the default week view.
      if (selectedDate) {
        dateMode = 'all';
        syncQuickFilters();
      }
      // Choosing a date is a JUMP, not a hard filter: scroll to that day while
      // keeping the surrounding events visible. Clearing it scrolls nowhere.
      pendingScrollDate = selectedDate || null;
      calendars.forEach((calendar) => {
        calendar.syncLabel();
        if (calendar.isOpen()) {
          // Move the (possibly always-open inline) calendar to the selected
          // month so the new selection is rendered and highlighted.
          calendar.syncView();
          calendar.renderGrid();
        }
      });
      renderFilters();
    }

    function createCalendar(root) {
      const inline = root.dataset.calendarInline === 'true';
      const trigger = root.querySelector('[data-calendar-trigger]');
      const label = root.querySelector('[data-calendar-label]');
      const popover = root.querySelector('[data-calendar-popover]');
      const title = root.querySelector('[data-calendar-title]');
      const grid = root.querySelector('[data-calendar-grid]');
      const prevButton = root.querySelector('[data-calendar-prev]');
      const nextButton = root.querySelector('[data-calendar-next]');
      const clearButton = root.querySelector('[data-calendar-clear]');

      const base = (selectedDate || today).split('-').map(Number);
      let viewYear = base[0];
      let viewMonth = base[1] - 1;

      function renderGrid() {
        if (!grid || !title) return;
        title.textContent = formatMonthTitle(viewYear, viewMonth);
        const firstWeekday = new Date(Date.UTC(viewYear, viewMonth, 1)).getUTCDay();
        const daysInMonth = new Date(Date.UTC(viewYear, viewMonth + 1, 0)).getUTCDate();

        let html = '';
        for (let i = 0; i < firstWeekday; i += 1) {
          html += '<span aria-hidden="true"></span>';
        }
        for (let day = 1; day <= daysInMonth; day += 1) {
          const dateString = `${viewYear}-${pad(viewMonth + 1)}-${pad(day)}`;
          const classes = ['bl-cal-day'];
          if (eventDateSet.has(dateString)) classes.push('has-event');
          if (dateString === today) classes.push('is-today');
          const isSelected = dateString === selectedDate;
          if (isSelected) classes.push('is-selected');
          html += `<button type="button" class="${classes.join(' ')}" data-calendar-day="${dateString}"${
            isSelected ? ' aria-pressed="true"' : ''
          }>${day}</button>`;
        }
        grid.innerHTML = html;
      }

      function syncView() {
        const next = (selectedDate || today).split('-').map(Number);
        viewYear = next[0];
        viewMonth = next[1] - 1;
      }

      function open() {
        if (inline || !popover) return;
        closeAllThemed();
        syncView();
        renderGrid();
        popover.hidden = false;
        trigger?.setAttribute('aria-expanded', 'true');
        // Move focus into the popover (selected day, else today, else first day).
        const focusTarget =
          grid?.querySelector('.bl-cal-day.is-selected') ||
          grid?.querySelector('.bl-cal-day.is-today') ||
          grid?.querySelector('.bl-cal-day');
        focusTarget?.focus({ preventScroll: true });
      }

      function close(returnFocus = false) {
        if (inline || !popover) return;
        popover.hidden = true;
        trigger?.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger?.focus();
      }

      function isOpen() {
        return inline || (popover ? !popover.hidden : false);
      }

      function syncLabel() {
        if (!label) return;
        label.textContent = selectedDate ? formatDateLabel(selectedDate) : 'Any date';
        label.classList.toggle('text-cayenne', Boolean(selectedDate));
      }

      trigger?.addEventListener('click', () => {
        if (popover && popover.hidden) {
          closeAllCalendars(root);
          open();
        } else {
          close();
        }
      });

      prevButton?.addEventListener('click', () => {
        viewMonth -= 1;
        if (viewMonth < 0) {
          viewMonth = 11;
          viewYear -= 1;
        }
        renderGrid();
      });

      nextButton?.addEventListener('click', () => {
        viewMonth += 1;
        if (viewMonth > 11) {
          viewMonth = 0;
          viewYear += 1;
        }
        renderGrid();
      });

      grid?.addEventListener('click', (event) => {
        const dayButton = event.target.closest('[data-calendar-day]');
        if (!dayButton) return;
        setSelectedDate(dayButton.dataset.calendarDay);
        close();
      });

      clearButton?.addEventListener('click', () => {
        setSelectedDate('');
        close();
      });

      popover?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !inline) {
          event.preventDefault();
          close(true);
        }
      });

      const api = { root, isOpen, open, close, renderGrid, syncLabel, syncView };
      if (inline) renderGrid();
      syncLabel();
      calendars.push(api);
      return api;
    }

    /* ---------- Themed dropdowns (desktop) ---------- */
    const themedSelects = [];

    function closeAllThemed(except = null) {
      themedSelects.forEach((select) => {
        if (select.root !== except) select.close();
      });
    }

    function refreshThemed() {
      themedSelects.forEach((select) => select.sync());
    }

    function initThemedSelect(root) {
      const native = root.querySelector('[data-themed-native]');
      const trigger = root.querySelector('[data-themed-trigger]');
      const label = root.querySelector('[data-themed-label]');
      const popover = root.querySelector('[data-themed-popover]');
      if (!native || !trigger || !label || !popover) return;

      const placeholder = native.options[0]?.textContent ?? '';
      const optionEls = () => Array.from(popover.querySelectorAll('[data-themed-option]'));

      function buildOptions() {
        popover.innerHTML = '';
        Array.from(native.options).forEach((option) => {
          // role="option" elements (not buttons) so they don't each become a tab
          // stop; keyboard navigation is handled by the listbox below.
          const el = document.createElement('div');
          el.setAttribute('role', 'option');
          el.tabIndex = -1;
          el.className = 'bl-themed-option';
          el.dataset.themedOption = option.value;
          el.textContent = option.textContent;
          popover.appendChild(el);
        });
      }

      function sync() {
        const selected = native.options[native.selectedIndex];
        label.textContent = selected ? selected.textContent : placeholder;
        label.classList.toggle('text-cayenne', Boolean(native.value));
        optionEls().forEach((el) => {
          const active = el.dataset.themedOption === native.value;
          el.setAttribute('aria-selected', active ? 'true' : 'false');
          el.classList.toggle('is-active', active);
        });
      }

      function selectValue(value) {
        native.value = value;
        native.dispatchEvent(new Event('change', { bubbles: true }));
      }

      function focusOption(index) {
        const els = optionEls();
        if (!els.length) return;
        els[Math.max(0, Math.min(index, els.length - 1))].focus();
      }

      function open() {
        closeAllThemed(root);
        closeAllCalendars();
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        sync();
        const els = optionEls();
        const activeIndex = els.findIndex((el) => el.dataset.themedOption === native.value);
        focusOption(activeIndex >= 0 ? activeIndex : 0);
      }

      function close(returnFocus = false) {
        if (popover.hidden) return;
        popover.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger.focus();
      }

      function isOpen() {
        return !popover.hidden;
      }

      trigger.addEventListener('click', () => {
        if (isOpen()) close();
        else open();
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (!isOpen()) open();
        }
      });

      popover.addEventListener('click', (event) => {
        const el = event.target.closest('[data-themed-option]');
        if (!el) return;
        selectValue(el.dataset.themedOption);
        close(true);
      });

      popover.addEventListener('keydown', (event) => {
        const els = optionEls();
        const current = els.indexOf(document.activeElement);
        switch (event.key) {
          case 'ArrowDown':
            event.preventDefault();
            focusOption(current + 1);
            break;
          case 'ArrowUp':
            event.preventDefault();
            focusOption(current - 1);
            break;
          case 'Home':
            event.preventDefault();
            focusOption(0);
            break;
          case 'End':
            event.preventDefault();
            focusOption(els.length - 1);
            break;
          case 'Enter':
          case ' ':
            event.preventDefault();
            if (document.activeElement?.dataset?.themedOption !== undefined) {
              selectValue(document.activeElement.dataset.themedOption);
              close(true);
            }
            break;
          case 'Escape':
            event.preventDefault();
            close(true);
            break;
          case 'Tab':
            close();
            break;
          default:
            break;
        }
      });

      native.addEventListener('change', sync);

      buildOptions();
      sync();
      themedSelects.push({ root, close, isOpen, sync });
    }

    /* ---------- Floating panel ---------- */
    function setFloatingExpanded(isExpanded) {
      if (!floatingPanel || !floatingToggle) return;
      floatingPanel.hidden = !isExpanded;
      floatingToggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      if (floatingToggleSymbol) {
        floatingToggleSymbol.textContent = isExpanded ? '-' : '+';
      }
      if (floatingToggleLabel) {
        floatingToggleLabel.textContent = isExpanded ? 'Close event filters' : 'Open event filters';
      }
    }

    function setFloatingVisible(isVisible) {
      if (!floatingControls) return;
      floatingControls.classList.toggle('is-visible', isVisible);
      floatingControls.toggleAttribute('inert', !isVisible);
      floatingControls.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
    }

    function setFloatingMinimized(isMinimized) {
      if (!floatingControls) return;

      floatingIsMinimized = isMinimized;
      floatingControls.classList.toggle('is-minimized', isMinimized);
      floatingPanelShell?.toggleAttribute('inert', isMinimized);
      floatingPanelShell?.setAttribute('aria-hidden', isMinimized ? 'true' : 'false');

      if (floatingRestore) {
        floatingRestore.hidden = !isMinimized;
      }

      if (isMinimized) {
        setFloatingExpanded(false);
      }

      syncFloatingVisibility();
    }

    function hasActiveFilters() {
      return Boolean(
        getSyncedValue(searchInputs) ||
        selectedDate ||
        getSyncedValue(categorySelects) ||
        getSyncedValue(neighborhoodSelects) ||
        freeOnly ||
        dateMode !== 'week'
      );
    }

    function shouldPinFloatingControls() {
      return Boolean(
        floatingControls?.contains(document.activeElement) ||
        floatingIsMinimized ||
        hasActiveFilters()
      );
    }

    function syncFloatingVisibility() {
      if (!floatingControls) return;
      setFloatingVisible(controlsAreOutOfView || shouldPinFloatingControls());
    }

    /* ---------- Filtering ---------- */
    function eventMatches(card) {
      const query = normalize(getSyncedValue(searchInputs));
      const category = getSyncedValue(categorySelects);
      const neighborhood = getSyncedValue(neighborhoodSelects);
      const cardStart = card.dataset.eventStart || card.dataset.eventDate || '';
      const cardEnd = card.dataset.eventEnd || card.dataset.eventDate || '';
      const cardTags = (card.dataset.eventTags ?? '').split('|').filter(Boolean);
      const cardNeighborhood = card.dataset.eventNeighborhood ?? '';
      const isFree = card.dataset.eventFree === 'true';

      if (query && !(card.dataset.eventSearch ?? '').includes(query)) return false;

      // A multi-day / recurring event matches when its [start, end] range overlaps
      // the active window. Searching expands the window to all upcoming, since a
      // search means "find this anywhere," not "only this week."
      const range = getActiveRange();
      const hi = query ? '9999-12-31' : range.hi;
      if (cardEnd && cardEnd < range.lo) return false;
      if (cardStart && cardStart > hi) return false;

      if (freeOnly && !isFree) return false;
      if (category && !cardTags.includes(category)) return false;
      if (neighborhood && cardNeighborhood !== neighborhood) return false;

      return true;
    }

    function renderFilters() {
      const shouldPreserveScroll = Boolean(floatingControls?.contains(document.activeElement));
      const previousScrollY = window.scrollY;
      let visibleCount = 0;

      eventCards.forEach((card) => {
        const shouldShow = eventMatches(card);
        card.hidden = !shouldShow;
        if (shouldShow) visibleCount += 1;
      });

      daySections.forEach((section) => {
        const sectionCards = Array.from(section.querySelectorAll('[data-event-card]'));
        const visibleCards = sectionCards.filter((card) => !card.hidden);
        const hasVisibleCard = visibleCards.length > 0;
        const isPastDay =
          hasVisibleCard &&
          visibleCards.every((card) => (card.dataset.eventDate ?? '') < today);
        section.hidden = !hasVisibleCard;
        section.classList.toggle('hidden', !hasVisibleCard);
        section.classList.toggle('is-past-day', isPastDay);
      });

      resultCounts.forEach((resultCount) => {
        resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'stop' : 'stops'}`;
      });

      if (noMatches) {
        noMatches.hidden = visibleCount > 0;
      }

      syncFloatingVisibility();

      if (pendingScrollDate) {
        // Jump to the chosen day (or the first stop on/after it) without hiding
        // the rest of the route. This wins over scroll preservation.
        const targetDate = pendingScrollDate;
        pendingScrollDate = null;
        window.requestAnimationFrame(() => {
          const target = daySections.find(
            (section) => !section.hidden && (section.dataset.eventDate ?? '') >= targetDate
          );
          target?.scrollIntoView({ block: 'start', behavior: 'smooth' });
          syncFloatingVisibility();
        });
      } else if (shouldPreserveScroll) {
        window.requestAnimationFrame(() => {
          const maxScrollY = Math.max(
            0,
            document.documentElement.scrollHeight - window.innerHeight
          );
          window.scrollTo({ top: Math.min(previousScrollY, maxScrollY), behavior: 'auto' });
          syncFloatingVisibility();
        });
      }
    }

    function resetFilters() {
      setSyncedValue(searchInputs, '');
      setSyncedValue(categorySelects, '');
      setSyncedValue(neighborhoodSelects, '');
      refreshThemed();
      dateMode = 'week';
      freeOnly = false;
      syncQuickFilters();
      setSelectedDate('');
    }

    /* ---------- Wiring ---------- */
    quickFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const kind = button.dataset.quickFilter;
        if (kind === 'free') {
          freeOnly = !freeOnly;
        } else {
          dateMode = kind;
        }
        syncQuickFilters();
        renderFilters();
      });
    });

    searchInputs.forEach((input) => {
      input.addEventListener('input', () => {
        setSyncedValue(searchInputs, input.value, input);
        renderFilters();
      });
    });

    categorySelects.forEach((select) => {
      select.addEventListener('change', () => {
        setSyncedValue(categorySelects, select.value, select);
        refreshThemed();
        renderFilters();
      });
    });

    neighborhoodSelects.forEach((select) => {
      select.addEventListener('change', () => {
        setSyncedValue(neighborhoodSelects, select.value, select);
        refreshThemed();
        renderFilters();
      });
    });

    resetButtons.forEach((button) => button.addEventListener('click', resetFilters));

    calendarRoots.forEach((root) => createCalendar(root));
    getControlFields('[data-themed-select]').forEach((root) => initThemedSelect(root));

    document.addEventListener('click', (event) => {
      if (!event.target.closest('[data-calendar]')) closeAllCalendars();
      if (!event.target.closest('[data-themed-select]')) closeAllThemed();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeAllCalendars();
        closeAllThemed();
      }
    });

    floatingToggle?.addEventListener('click', () => {
      setFloatingExpanded(floatingToggle.getAttribute('aria-expanded') !== 'true');
      syncFloatingVisibility();
    });
    floatingMinimize?.addEventListener('click', () => {
      setFloatingMinimized(true);
    });
    floatingRestore?.addEventListener('click', () => {
      setFloatingMinimized(false);
      setFloatingVisible(true);
    });
    floatingControls?.addEventListener('focusin', syncFloatingVisibility);
    floatingControls?.addEventListener('focusout', () => {
      window.setTimeout(syncFloatingVisibility, 0);
    });

    eventCards.forEach((card) => {
      card.classList.toggle('is-past-event', (card.dataset.eventDate ?? '') < today);
    });

    setSyncedValue(searchInputs, getSyncedValue(searchInputs));
    setSyncedValue(categorySelects, getSyncedValue(categorySelects));
    setSyncedValue(neighborhoodSelects, getSyncedValue(neighborhoodSelects));
    syncQuickFilters();
    setFloatingExpanded(false);

    if (floatingControls && controls && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          controlsAreOutOfView = !entry.isIntersecting;
          syncFloatingVisibility();
        },
        { rootMargin: '-80px 0px 0px 0px' }
      );
      observer.observe(controls);
    } else {
      controlsAreOutOfView = true;
      syncFloatingVisibility();
    }

    renderFilters();
  }
</script>
