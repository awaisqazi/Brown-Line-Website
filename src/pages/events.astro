---
import Layout from '../layouts/Layout.astro';
import TransitDivider from '../components/TransitDivider.astro';
import EventCard from '../components/EventCard.astro';
import { supabase } from '../lib/supabase';
import type { TransitEvent } from '../lib/supabase';

const { data, error } = await supabase
  .from('events')
  .select('*')
  .order('event_date', { ascending: true })
  .order('is_curated', { ascending: false })
  .order('title', { ascending: true })
  .returns<TransitEvent[]>();

if (error) {
  throw new Error(`Failed to load events: ${error.message}`);
}

const events = data ?? [];

const groupedEvents = events.reduce<Record<string, TransitEvent[]>>((groups, event) => {
  const label = event.display_date || event.event_date;
  groups[label] ??= [];
  groups[label].push(event);
  return groups;
}, {});

const groupedEventEntries = Object.entries(groupedEvents);
const dateStops = groupedEventEntries.map(([displayDate, dayEvents]) => ({
  displayDate,
  eventDate: dayEvents[0]?.event_date ?? '',
}));
const todayDateString = getChicagoDateString();
const dateFilterStopsByDate = new Map(
  dateStops
    .filter((dateStop) => dateStop.eventDate)
    .map((dateStop) => [dateStop.eventDate, dateStop])
);
if (todayDateString && !dateFilterStopsByDate.has(todayDateString)) {
  dateFilterStopsByDate.set(todayDateString, {
    displayDate: formatLongDate(todayDateString),
    eventDate: todayDateString,
  });
}
const dateFilterStops = Array.from(dateFilterStopsByDate.values()).sort((a, b) =>
  a.eventDate.localeCompare(b.eventDate)
);
const tags = Array.from(new Set(events.flatMap((event) => event.tags ?? []))).sort((a, b) =>
  a.localeCompare(b)
);
const stopColors = ['bg-babyPink', 'bg-mayaBlue', 'bg-celadon', 'bg-amber', 'bg-cayenne'];
const pageDescription =
  'A static, Supabase-powered guide to Chicago arts, culture, and community events from The Brown Line.';

function getEventKind(event: TransitEvent) {
  if (event.is_giveaway) return 'giveaway';
  if (event.is_curated) return 'curated';
  return 'regular';
}

function getEventSearchText(event: TransitEvent) {
  return [
    event.title,
    event.description,
    event.venue,
    event.organizer,
    event.cost_info,
    event.display_date,
    ...(event.tags ?? []),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
}

function getChicagoDateString() {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Chicago',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date());

  const byType = Object.fromEntries(parts.map((part) => [part.type, part.value]));
  return `${byType.year}-${byType.month}-${byType.day}`;
}

function formatLongDate(dateString: string) {
  const [year, month, day] = dateString.split('-').map(Number);

  if (!year || !month || !day) return dateString;

  return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---
<Layout
  title="Events | The Brown Line"
  description={pageDescription}
>
  <section class="px-6 py-16 md:py-24 lg:py-28">
    <div class="max-w-5xl mx-auto">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-5">
        Now boarding
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] gap-10 lg:gap-14 items-end">
        <div>
          <h1 class="font-heading text-darkWalnut text-[2.5rem] sm:text-5xl md:text-6xl lg:text-7xl leading-[1.02] text-balance">
            Chicago events, mapped like a <em class="not-italic text-cayenne">CTA ride</em>.
          </h1>
        </div>
        <p class="font-body text-darkWalnut/75 text-base md:text-lg leading-relaxed max-w-xl">
          Curated community stops, fundraisers, workshops, comedy nights, and neighborhood gatherings pulled from Supabase every time the site rebuilds.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6">
    <TransitDivider />
  </div>

  {events.length > 0 && (
    <section class="px-4 pt-8 sm:px-6 md:pt-20">
      <div
        data-event-controls
        class="max-w-5xl mx-auto overflow-hidden border-2 border-darkWalnut bg-[#FDFBF7] p-4 shadow-[3px_3px_0_#642713] md:p-5 md:shadow-retro"
      >
        <div class="flex items-start justify-between gap-3 md:items-center">
          <div class="min-w-0">
            <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">
              Route controls
            </p>
            <p
              data-event-result-count
              class="font-heading text-darkWalnut text-[2rem] sm:text-4xl md:text-5xl leading-none mt-1.5"
              aria-live="polite"
            >
              {events.length} stops
            </p>
          </div>
          <button
            type="button"
            data-reset-filters
            class="shrink-0 self-start font-body text-[10px] sm:text-xs font-bold uppercase tracking-widest text-darkWalnut border-2 border-darkWalnut px-3 py-2 transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:shadow-retro focus-visible:outline-none md:self-auto md:px-4"
          >
            Reset
          </button>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 md:mt-5 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_repeat(2,minmax(0,0.85fr))]">
          <label class="block min-w-0 sm:col-span-2 md:col-span-1">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Search
            </span>
            <input
              data-event-search
              data-event-search-input
              type="search"
              placeholder="Title, venue, organizer"
              class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
            />
          </label>

          <label class="block min-w-0 sm:col-span-2 md:col-span-1">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Jump
            </span>
            <select
              data-date-jump
              class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
            >
              <option value="">Choose date</option>
              {dateStops.map((dateStop) => (
                <option value={dateStop.displayDate}>{dateStop.displayDate}</option>
              ))}
            </select>
          </label>

          <label class="block min-w-0">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              From
            </span>
            <select
              data-start-date
              class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-2 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:px-3 md:text-sm"
            >
              <option value="">All dates</option>
              {dateFilterStops.map((dateStop) => (
                <option value={dateStop.eventDate}>{dateStop.displayDate}</option>
              ))}
            </select>
          </label>

          <label class="block min-w-0">
            <span class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              To
            </span>
            <select
              data-end-date
              class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-2 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:px-3 md:text-sm"
            >
              <option value="">No end date</option>
              {dateFilterStops.map((dateStop) => (
                <option value={dateStop.eventDate}>{dateStop.displayDate}</option>
              ))}
            </select>
          </label>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 md:mt-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
          <fieldset>
            <legend class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Line type
            </legend>
            <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {[
                { value: 'all', label: 'All' },
                { value: 'curated', label: 'Picks' },
                { value: 'giveaway', label: 'Giveaways' },
                { value: 'regular', label: 'Transfers' },
              ].map((option) => (
                <label class="cursor-pointer">
                  <input
                    class="peer sr-only"
                    type="radio"
                    name="event-kind"
                    value={option.value}
                    checked={option.value === 'all'}
                    data-kind-filter
                  />
                  <span class="block border-2 border-darkWalnut bg-seashell px-2 py-2 text-center font-body text-[10px] font-bold uppercase tracking-[0.16em] text-darkWalnut transition-colors peer-checked:bg-darkWalnut peer-checked:text-seashell peer-focus-visible:ring-2 peer-focus-visible:ring-mayaBlue sm:text-[11px] sm:tracking-widest">
                    {option.label}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Extras
            </p>
            <label class="mt-2 inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut sm:text-[11px]">
              <input
                data-linked-filter
                type="checkbox"
                class="h-4 w-4 accent-cayenne"
              />
              Has link
            </label>
          </div>
        </div>

        {tags.length > 0 && (
          <div class="mt-5">
            <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
              Tags
            </p>
            <div class="mt-2 flex flex-nowrap gap-2 overflow-x-auto pb-1 md:flex-wrap md:overflow-visible md:pb-0">
              <button
                type="button"
                data-clear-tags
                class="shrink-0 font-body text-[10px] font-bold uppercase tracking-widest text-seashell bg-darkWalnut border-2 border-darkWalnut px-3 py-2"
              >
                Any tag
              </button>
              {tags.map((tag) => (
                <button
                  type="button"
                  data-tag-filter={tag}
                  aria-pressed="false"
                  class="shrink-0 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/70 bg-seashell border-2 border-dashed border-darkWalnut/35 px-3 py-2 transition-colors hover:border-darkWalnut focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
                >
                  {tag}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {events.length > 0 && (
    <div
      data-floating-event-controls
      class="fixed inset-x-4 bottom-[calc(env(safe-area-inset-bottom)+5rem)] z-40 md:left-auto md:right-6 md:bottom-6 md:w-[min(31rem,calc(100vw-3rem))]"
      aria-label="Floating event filters"
      aria-hidden="true"
      inert
    >
      <div
        data-floating-panel-shell
        class="floating-event-panel max-h-[calc(100vh-7rem)] overflow-y-auto border-2 border-darkWalnut bg-[#FDFBF7] shadow-retro md:max-h-[calc(100vh-2rem)]"
      >
        <div class="h-1 bg-[linear-gradient(to_right,#F79CD0_0_20%,#5BC3FF_20%_40%,#90D393_40%_60%,#FFBC29_60%_80%,#F35A0F_80%_100%)]"></div>

        <div class="p-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="font-body text-[9px] font-bold uppercase tracking-[0.28em] text-cayenne">
                Line signal
              </p>
              <p
                data-event-result-count
                class="font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut/70"
                aria-live="polite"
              >
                {events.length} stops
              </p>
            </div>

            <div class="flex shrink-0 items-center gap-2">
              <button
                type="button"
                data-floating-minimize
                aria-label="Hide floating filters"
                class="inline-flex h-10 w-10 items-center justify-center border-2 border-darkWalnut bg-seashell font-body text-lg font-bold leading-none text-darkWalnut shadow-[2px_2px_0_#642713] transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >
                <span aria-hidden="true">&rarr;</span>
              </button>

              <button
                type="button"
                data-floating-filter-toggle
                aria-expanded="false"
                aria-controls="floating-event-filters"
                class="inline-flex h-10 w-10 items-center justify-center border-2 border-darkWalnut bg-amber font-body text-xl font-bold leading-none text-darkWalnut shadow-[2px_2px_0_#642713] transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >
                <span data-floating-toggle-symbol aria-hidden="true">+</span>
                <span data-floating-toggle-label class="sr-only">Open event filters</span>
              </button>
            </div>
          </div>

          <label class="mt-3 block">
            <span class="sr-only">Search events</span>
            <input
              data-event-search-input
              type="search"
              placeholder="Search the route"
              class="w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
            />
          </label>

          <div
            id="floating-event-filters"
            data-floating-filter-panel
            hidden
            class="mt-3 border-t-2 border-dashed border-darkWalnut/35 pt-3"
          >
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
              <label class="block min-w-0">
                <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  Jump
                </span>
                <select
                  data-date-jump
                  class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
                >
                  <option value="">Choose date</option>
                  {dateStops.map((dateStop) => (
                    <option value={dateStop.displayDate}>{dateStop.displayDate}</option>
                  ))}
                </select>
              </label>

              <label class="block min-w-0">
                <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  Line type
                </span>
                <select
                  data-kind-select
                  class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
                >
                  <option value="all">All</option>
                  <option value="curated">Picks</option>
                  <option value="giveaway">Giveaways</option>
                  <option value="regular">Transfers</option>
                </select>
              </label>

              <label class="block min-w-0">
                <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  From
                </span>
                <select
                  data-start-date
                  class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-2 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:px-3 md:text-sm"
                >
                  <option value="">All dates</option>
                  {dateFilterStops.map((dateStop) => (
                    <option value={dateStop.eventDate}>{dateStop.displayDate}</option>
                  ))}
                </select>
              </label>

              <label class="block min-w-0">
                <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  To
                </span>
                <select
                  data-end-date
                  class="mt-1 w-full min-w-0 border-2 border-darkWalnut bg-seashell px-2 py-2.5 font-body text-base font-bold text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue md:px-3 md:text-sm"
                >
                  <option value="">No end date</option>
                  {dateFilterStops.map((dateStop) => (
                    <option value={dateStop.eventDate}>{dateStop.displayDate}</option>
                  ))}
                </select>
              </label>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-2">
              <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut">
                <input
                  data-linked-filter
                  type="checkbox"
                  class="h-4 w-4 accent-cayenne"
                />
                Has link
              </label>

              <button
                type="button"
                data-reset-filters
                class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut border-2 border-darkWalnut bg-seashell px-3 py-2 transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[2px_2px_0_#642713] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >
                Reset
              </button>
            </div>

            {tags.length > 0 && (
              <div class="mt-3">
                <p class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/65">
                  Tags
                </p>
                <div class="mt-2 flex max-h-28 flex-wrap gap-2 overflow-y-auto pr-1">
                  <button
                    type="button"
                    data-clear-tags
                    class="font-body text-[9px] font-bold uppercase tracking-widest text-seashell bg-darkWalnut border-2 border-darkWalnut px-2.5 py-1.5"
                  >
                    Any tag
                  </button>
                  {tags.map((tag) => (
                    <button
                      type="button"
                      data-tag-filter={tag}
                      aria-pressed="false"
                      class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/70 bg-seashell border-2 border-dashed border-darkWalnut/35 px-2.5 py-1.5 transition-colors hover:border-darkWalnut focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
                    >
                      {tag}
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <button
        type="button"
        data-floating-restore
        hidden
        aria-label="Show floating filters"
        class="floating-event-restore-tab"
      >
        <span aria-hidden="true">&larr;</span>
      </button>
    </div>
  )}

  <section class="px-6 py-16 md:py-24">
    <div class="max-w-5xl mx-auto">
      {events.length === 0 ? (
        <div class="border-2 border-darkWalnut bg-seashell p-8 md:p-10 shadow-retro">
          <p class="font-body uppercase text-xs tracking-[0.3em] text-cayenne font-bold">No scheduled stops</p>
          <h2 class="font-heading text-darkWalnut text-4xl md:text-5xl leading-none mt-3">
            Events are loading soon.
          </h2>
          <p class="font-body text-darkWalnut/75 text-base md:text-lg leading-relaxed mt-5 max-w-2xl">
            Once the team imports the next CSV in Supabase Studio, this static page will update on the next scheduled rebuild.
          </p>
        </div>
      ) : (
        <>
          <div
            data-no-event-matches
            hidden
            class="border-2 border-darkWalnut bg-seashell p-8 md:p-10 shadow-retro"
          >
            <p class="font-body uppercase text-xs tracking-[0.3em] text-cayenne font-bold">
              No matching stops
            </p>
            <h2 class="font-heading text-darkWalnut text-4xl md:text-5xl leading-none mt-3">
              Try a different route.
            </h2>
          </div>

          <div data-events-board class="space-y-14 md:space-y-16">
            {groupedEventEntries.map(([displayDate, dayEvents]) => (
            <section
              data-event-day-section
              data-display-date={displayDate}
              data-event-date={dayEvents[0]?.event_date ?? ''}
              class="grid grid-cols-1 md:grid-cols-[14rem_minmax(0,1fr)] gap-8 md:gap-10"
            >
              <div>
                <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold mb-3">
                  Platform
                </p>
                <h2 class="font-heading text-darkWalnut text-4xl md:text-5xl leading-none">
                  {displayDate}
                </h2>
              </div>

              <ol class="events-route relative space-y-6">
                {dayEvents.map((event, index) => (
                  <li
                    data-event-card
                    data-event-date={event.event_date}
                    data-event-kind={getEventKind(event)}
                    data-event-curated={event.is_curated ? 'true' : 'false'}
                    data-event-giveaway={event.is_giveaway ? 'true' : 'false'}
                    data-event-tags={(event.tags ?? []).join('|')}
                    data-event-search={getEventSearchText(event)}
                    data-has-link={event.event_url ? 'true' : 'false'}
                    class="relative pl-12 md:pl-14"
                  >
                    <span
                      class:list={[
                        'event-stop absolute left-0 top-7 h-[22px] w-[22px] rounded-full border-2 border-darkWalnut shadow-[2px_2px_0_#642713]',
                        stopColors[index % stopColors.length],
                      ]}
                      aria-hidden="true"
                    ></span>

                    <EventCard event={event} />
                  </li>
                ))}
              </ol>
            </section>
          ))}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

<style>
  .events-route::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 2.25rem;
    bottom: 2.25rem;
    width: 2px;
    background: #642713;
  }

  @media (min-width: 768px) {
    .events-route::before {
      left: 10px;
    }
  }

  [data-event-card].is-past-event .event-stop {
    opacity: 0.35;
    filter: grayscale(1);
    box-shadow: none;
  }

  [data-event-card].is-past-event :is(article, a) {
    opacity: 0.45;
    filter: grayscale(1);
  }

  [data-event-card].is-past-event :is(article, a):hover {
    transform: none !important;
    box-shadow: none !important;
  }

  [data-event-day-section].is-past-day > div:first-child {
    opacity: 0.45;
    filter: grayscale(1);
  }

  [data-floating-event-controls] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  [data-floating-event-controls].is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .floating-event-panel {
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .floating-event-restore-tab {
    position: absolute;
    right: -0.25rem;
    bottom: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 3rem;
    border: 2px solid #642713;
    background: #FFBC29;
    color: #642713;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 2px 2px 0 #642713;
    pointer-events: auto;
  }

  .floating-event-restore-tab[hidden] {
    display: none;
  }

  [data-floating-event-controls].is-minimized .floating-event-panel {
    opacity: 0;
    pointer-events: none;
    transform: translateX(calc(100% + 1rem));
  }

  @media (prefers-reduced-motion: reduce) {
    [data-floating-event-controls],
    .floating-event-panel {
      transition: none;
    }
  }
</style>

<script>
  const controls = document.querySelector('[data-event-controls]');
  const floatingControls = document.querySelector('[data-floating-event-controls]');
  const controlScopes = [controls, floatingControls].filter(Boolean);

  if (controlScopes.length > 0) {
    const getControlFields = (selector) =>
      controlScopes.flatMap((scope) => Array.from(scope.querySelectorAll(selector)));
    const searchInputs = getControlFields('[data-event-search-input]');
    const jumpSelects = getControlFields('[data-date-jump]');
    const startDateInputs = getControlFields('[data-start-date]');
    const endDateInputs = getControlFields('[data-end-date]');
    const kindInputs = getControlFields('[data-kind-filter]');
    const kindSelects = getControlFields('[data-kind-select]');
    const linkedInputs = getControlFields('[data-linked-filter]');
    const resetButtons = getControlFields('[data-reset-filters]');
    const clearTagsButtons = getControlFields('[data-clear-tags]');
    const tagButtons = getControlFields('[data-tag-filter]');
    const resultCounts = getControlFields('[data-event-result-count]');
    const floatingToggle = floatingControls?.querySelector('[data-floating-filter-toggle]');
    const floatingMinimize = floatingControls?.querySelector('[data-floating-minimize]');
    const floatingRestore = floatingControls?.querySelector('[data-floating-restore]');
    const floatingToggleSymbol = floatingControls?.querySelector('[data-floating-toggle-symbol]');
    const floatingToggleLabel = floatingControls?.querySelector('[data-floating-toggle-label]');
    const floatingPanel = floatingControls?.querySelector('[data-floating-filter-panel]');
    const floatingPanelShell = floatingControls?.querySelector('[data-floating-panel-shell]');
    const eventCards = Array.from(document.querySelectorAll('[data-event-card]'));
    const daySections = Array.from(document.querySelectorAll('[data-event-day-section]'));
    const noMatches = document.querySelector('[data-no-event-matches]');
    const selectedTags = new Set();
    let selectedKind = kindInputs.find((input) => input.checked)?.value ?? kindSelects[0]?.value ?? 'all';
    let controlsAreOutOfView = false;
    let floatingIsMinimized = false;

    const normalize = (value) => value.toString().trim().toLowerCase();

    function getSyncedValue(inputs) {
      return inputs.find((input) => input.value)?.value ?? '';
    }

    function setSyncedValue(inputs, value, source = null) {
      inputs.forEach((input) => {
        if (input !== source) input.value = value;
      });
    }

    function setLinkedChecked(checked, source = null) {
      linkedInputs.forEach((input) => {
        if (input !== source) input.checked = checked;
      });
    }

    function setSelectedKind(value) {
      selectedKind = value || 'all';
      kindInputs.forEach((input) => {
        input.checked = input.value === selectedKind;
      });
      kindSelects.forEach((select) => {
        select.value = selectedKind;
      });
    }

    function setFloatingExpanded(isExpanded) {
      if (!floatingPanel || !floatingToggle) return;
      floatingPanel.hidden = !isExpanded;
      floatingToggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      if (floatingToggleSymbol) {
        floatingToggleSymbol.textContent = isExpanded ? '-' : '+';
      }
      if (floatingToggleLabel) {
        floatingToggleLabel.textContent = isExpanded ? 'Close event filters' : 'Open event filters';
      }
    }

    function setFloatingVisible(isVisible) {
      if (!floatingControls) return;
      floatingControls.classList.toggle('is-visible', isVisible);
      floatingControls.toggleAttribute('inert', !isVisible);
      floatingControls.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
    }

    function setFloatingMinimized(isMinimized) {
      if (!floatingControls) return;

      floatingIsMinimized = isMinimized;
      floatingControls.classList.toggle('is-minimized', isMinimized);
      floatingPanelShell?.toggleAttribute('inert', isMinimized);
      floatingPanelShell?.setAttribute('aria-hidden', isMinimized ? 'true' : 'false');

      if (floatingRestore) {
        floatingRestore.hidden = !isMinimized;
      }

      if (isMinimized) {
        setFloatingExpanded(false);
      }

      syncFloatingVisibility();
    }

    function getChicagoDateString() {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(new Date());

      const byType = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      return `${byType.year}-${byType.month}-${byType.day}`;
    }

    const today = getChicagoDateString();

    function getDefaultStartDate() {
      return today;
    }

    function hasActiveFilters() {
      const defaultStartDate = getDefaultStartDate();
      return Boolean(
        getSyncedValue(searchInputs) ||
        getSyncedValue(jumpSelects) ||
        (getSyncedValue(startDateInputs) && getSyncedValue(startDateInputs) !== defaultStartDate) ||
        getSyncedValue(endDateInputs) ||
        selectedKind !== 'all' ||
        linkedInputs.some((input) => input.checked) ||
        selectedTags.size > 0
      );
    }

    function shouldPinFloatingControls() {
      return Boolean(
        floatingControls?.contains(document.activeElement) ||
        floatingIsMinimized ||
        hasActiveFilters()
      );
    }

    function syncFloatingVisibility() {
      if (!floatingControls) return;
      setFloatingVisible(controlsAreOutOfView || shouldPinFloatingControls());
    }

    function updateTagButtons() {
      tagButtons.forEach((button) => {
        const isSelected = selectedTags.has(button.dataset.tagFilter);
        button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        button.classList.toggle('bg-darkWalnut', isSelected);
        button.classList.toggle('text-seashell', isSelected);
        button.classList.toggle('border-darkWalnut', isSelected);
        button.classList.toggle('bg-seashell', !isSelected);
        button.classList.toggle('text-darkWalnut/70', !isSelected);
        button.classList.toggle('border-darkWalnut/35', !isSelected);
      });
    }

    function eventMatches(card) {
      const query = normalize(getSyncedValue(searchInputs));
      const kind = selectedKind;
      const startDate = getSyncedValue(startDateInputs);
      const endDate = getSyncedValue(endDateInputs);
      const cardDate = card.dataset.eventDate ?? '';
      const isCurated = card.dataset.eventCurated === 'true';
      const isGiveaway = card.dataset.eventGiveaway === 'true';
      const cardTags = (card.dataset.eventTags ?? '').split('|').filter(Boolean);

      if (query && !(card.dataset.eventSearch ?? '').includes(query)) return false;
      if (kind === 'curated' && !isCurated) return false;
      if (kind === 'giveaway' && !isGiveaway) return false;
      if (kind === 'regular' && (isCurated || isGiveaway)) return false;
      if (startDate && cardDate < startDate) return false;
      if (endDate && cardDate > endDate) return false;
      if (linkedInputs.some((input) => input.checked) && card.dataset.hasLink !== 'true') return false;

      if (selectedTags.size > 0) {
        const hasMatchingTag = cardTags.some((tag) => selectedTags.has(tag));
        if (!hasMatchingTag) return false;
      }

      return true;
    }

    function renderFilters() {
      const shouldPreserveScroll = Boolean(floatingControls?.contains(document.activeElement));
      const previousScrollY = window.scrollY;
      let visibleCount = 0;

      eventCards.forEach((card) => {
        const shouldShow = eventMatches(card);
        card.hidden = !shouldShow;
        if (shouldShow) visibleCount += 1;
      });

      daySections.forEach((section) => {
        const sectionCards = Array.from(section.querySelectorAll('[data-event-card]'));
        const visibleCards = sectionCards.filter((card) => !card.hidden);
        const hasVisibleCard = visibleCards.length > 0;
        const isPastDay =
          hasVisibleCard &&
          visibleCards.every((card) => (card.dataset.eventDate ?? '') < today);
        section.hidden = !hasVisibleCard;
        section.classList.toggle('hidden', !hasVisibleCard);
        section.classList.toggle('is-past-day', isPastDay);
      });

      resultCounts.forEach((resultCount) => {
        resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'stop' : 'stops'}`;
      });

      if (noMatches) {
        noMatches.hidden = visibleCount > 0;
      }

      updateTagButtons();
      syncFloatingVisibility();

      if (shouldPreserveScroll) {
        window.requestAnimationFrame(() => {
          const maxScrollY = Math.max(
            0,
            document.documentElement.scrollHeight - window.innerHeight
          );
          window.scrollTo({ top: Math.min(previousScrollY, maxScrollY), behavior: 'auto' });
          syncFloatingVisibility();
        });
      }
    }

    function resetFilters() {
      setSyncedValue(searchInputs, '');
      setSyncedValue(jumpSelects, '');
      setSyncedValue(startDateInputs, getDefaultStartDate());
      setSyncedValue(endDateInputs, '');
      setLinkedChecked(false);
      setSelectedKind('all');
      selectedTags.clear();
      renderFilters();
    }

    function handleJumpChange(selectedDate, source = null) {
      setSyncedValue(jumpSelects, selectedDate, source);
      if (!selectedDate) {
        renderFilters();
        return;
      }

      const section = daySections.find((daySection) => daySection.dataset.displayDate === selectedDate);
      const sectionDate = section?.dataset.eventDate ?? '';
      const currentStartDate = getSyncedValue(startDateInputs) || today;

      if (sectionDate && sectionDate < currentStartDate) {
        setSyncedValue(startDateInputs, sectionDate);
      }

      renderFilters();
      section?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    searchInputs.forEach((input) => {
      input.addEventListener('input', () => {
        setSyncedValue(searchInputs, input.value, input);
        renderFilters();
      });
    });

    startDateInputs.forEach((input) => {
      input.addEventListener('input', () => {
        setSyncedValue(startDateInputs, input.value, input);
        renderFilters();
      });
      input.addEventListener('change', () => {
        setSyncedValue(startDateInputs, input.value, input);
        renderFilters();
      });
    });

    endDateInputs.forEach((input) => {
      input.addEventListener('input', () => {
        setSyncedValue(endDateInputs, input.value, input);
        renderFilters();
      });
      input.addEventListener('change', () => {
        setSyncedValue(endDateInputs, input.value, input);
        renderFilters();
      });
    });

    linkedInputs.forEach((input) => {
      input.addEventListener('change', () => {
        setLinkedChecked(input.checked, input);
        renderFilters();
      });
    });

    kindInputs.forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        setSelectedKind(input.value);
        renderFilters();
      });
    });

    kindSelects.forEach((select) => {
      select.addEventListener('change', () => {
        setSelectedKind(select.value);
        renderFilters();
      });
    });

    jumpSelects.forEach((select) => {
      select.addEventListener('change', () => {
        handleJumpChange(select.value, select);
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tagFilter;
        if (!tag) return;

        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
        } else {
          selectedTags.add(tag);
        }

        renderFilters();
      });
    });

    clearTagsButtons.forEach((button) => button.addEventListener('click', () => {
      selectedTags.clear();
      renderFilters();
    }));

    resetButtons.forEach((button) => button.addEventListener('click', resetFilters));
    floatingToggle?.addEventListener('click', () => {
      setFloatingExpanded(floatingToggle.getAttribute('aria-expanded') !== 'true');
      syncFloatingVisibility();
    });
    floatingMinimize?.addEventListener('click', () => {
      setFloatingMinimized(true);
    });
    floatingRestore?.addEventListener('click', () => {
      setFloatingMinimized(false);
      setFloatingVisible(true);
    });
    floatingControls?.addEventListener('focusin', syncFloatingVisibility);
    floatingControls?.addEventListener('focusout', () => {
      window.setTimeout(syncFloatingVisibility, 0);
    });
    eventCards.forEach((card) => {
      card.classList.toggle('is-past-event', (card.dataset.eventDate ?? '') < today);
    });

    setSelectedKind(selectedKind);
    setSyncedValue(searchInputs, getSyncedValue(searchInputs));
    setSyncedValue(jumpSelects, getSyncedValue(jumpSelects));
    setSyncedValue(startDateInputs, getSyncedValue(startDateInputs) || getDefaultStartDate());
    setSyncedValue(endDateInputs, getSyncedValue(endDateInputs));
    setLinkedChecked(linkedInputs.some((input) => input.checked));
    setFloatingExpanded(false);

    if (floatingControls && controls && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          controlsAreOutOfView = !entry.isIntersecting;
          syncFloatingVisibility();
        },
        { rootMargin: '-80px 0px 0px 0px' }
      );
      observer.observe(controls);
    } else {
      controlsAreOutOfView = true;
      syncFloatingVisibility();
    }

    renderFilters();
  }
</script>
