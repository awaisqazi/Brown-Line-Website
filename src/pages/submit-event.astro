---
import Layout from '../layouts/Layout.astro';
import TransitDivider from '../components/TransitDivider.astro';
import { LOCATION_TYPES, DIASPORA_TAGS, NEIGHBORHOOD_GROUPS, SUBURBS } from '../lib/locations';

const supabaseUrl = import.meta.env.SUPABASE_URL;
if (!supabaseUrl) {
  throw new Error('Missing Supabase environment variables.');
}
const functionUrl = `${supabaseUrl}/functions/v1/submit-event`;
// Cloudflare Turnstile site key. Defaults to Cloudflare's public TEST key (always
// passes) so the form works before a real key is set. Provide the real key via
// PUBLIC_TURNSTILE_SITE_KEY (and the matching secret in the edge function) for prod.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

// Shared field styling. Inputs get appearance resets so iOS does not smuggle
// in rounded corners and inner shadows; selects keep their native arrow, and
// date/time fields get a minimum height so an empty value never collapses.
const fieldBase =
  'mt-2 w-full min-h-[2.75rem] rounded-none border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm';
const inputClass = `${fieldBase} appearance-none`;
const selectClass = fieldBase;
const labelClass = 'block font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65';
// Section headers break the single-column mobile form into short stretches.
const sectionClass =
  'md:col-span-2 mt-4 first:mt-0 border-b border-darkWalnut/15 pb-2 font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne';
const hintClass =
  'mt-1.5 block font-body text-[11px] font-normal normal-case leading-relaxed tracking-normal text-darkWalnut/60';
const buttonClass =
  'border-2 border-darkWalnut bg-cayenne px-5 py-3 font-body text-xs font-bold uppercase tracking-widest text-seashell shadow-retro transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-x-0 disabled:hover:translate-y-0';
const reqClass = 'ml-2 text-[9px] tracking-widest text-cayenne';

const pageDescription =
  'Submit a Chicago arts, culture, or community event for The Brown Line to review and feature.';
---

<Layout title="Submit an event | The Brown Line" description={pageDescription}>
  <section class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenne font-bold mb-5">
        Flag a stop
      </p>
      <h1 class="font-heading text-darkWalnut text-[2.5rem] sm:text-5xl md:text-6xl leading-[1.02] text-balance">
        Put your event <em class="not-italic text-cayenne">on the map</em>.
      </h1>
      <p class="mt-6 font-body text-darkWalnut/80 text-base md:text-lg leading-relaxed max-w-2xl">
        Hosting a show, screening, fundraiser, workshop, pop-up, watch party, or community gathering
        rooted in Chicago's Global South diaspora? Send it our way.
      </p>
      <p class="mt-4 font-body text-darkWalnut/75 text-base md:text-lg leading-relaxed max-w-2xl">
        The Brown Line is curated by a human, not scraped by an algorithm. Submission doesn't guarantee
        inclusion, but every event is reviewed by hand.
      </p>
    </div>
  </section>

  {/* ---------- Who should submit / What we look for ---------- */}
  <section class="px-6 pb-4">
    <div class="mx-auto grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <p class="mb-2 font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
          Who should submit
        </p>
        <p class="font-body text-sm leading-relaxed text-darkWalnut/80 md:text-base">
          Artists, organizers, venues, collectives, bookstores, museums, restaurants, mutual aid
          groups, DJs, film programmers, workshop hosts, and community groups.
        </p>
      </div>
      <div>
        <p class="mb-2 font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
          What we look for
        </p>
        <p class="font-body text-sm leading-relaxed text-darkWalnut/80 md:text-base">
          Events rooted in Global South diaspora communities: culturally specific programming,
          underpromoted neighborhood events, community fundraisers, independent artists,
          immigrant-owned spaces, cross-cultural solidarity, and accessible, free, or low-cost
          gatherings.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-6">
    <TransitDivider />
  </div>

  <section class="px-6 py-12 md:py-16">
    <div
      data-submit-app
      data-function-url={functionUrl}
      class="mx-auto max-w-3xl border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-8"
    >
      <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
        Event request
      </p>
      <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
        Tell us about the stop
      </h2>
      <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
        Fields marked Required keep the form moving. Everything else is optional, so leave it blank
        if you are not sure.
      </p>

      <form data-submit-form class="mt-7 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-x-5 md:gap-y-5" novalidate>
        <p class={sectionClass}>Who's flagging it</p>

        <label class={labelClass} for="submitter-name">
          Your name<span class={reqClass}>Required</span>
          <input id="submitter-name" name="submitter_name" type="text" autocomplete="name" maxlength="200" placeholder="First and last" class={inputClass} required />
        </label>

        <label class={labelClass} for="submitter-email">
          Your email
          <input id="submitter-email" name="submitter_email" type="email" autocomplete="email" placeholder="So we can follow up" class={inputClass} />
        </label>

        <p class={sectionClass}>The stop</p>

        <label class={`${labelClass} md:col-span-2`} for="event-title">
          Event title<span class={reqClass}>Required</span>
          <input id="event-title" name="title" type="text" maxlength="300" placeholder="What's it called?" class={inputClass} required />
        </label>

        <label class={`${labelClass} md:col-span-2`} for="event-date">
          Event date<span class={reqClass}>Required</span>
          <input id="event-date" name="event_date" type="date" class={inputClass} required />
          <span class={hintClass}>
            For best consideration, submit at least 7&ndash;10 days ahead. Events submitted by Thursday
            may make that Sunday's newsletter.
          </span>
        </label>

        {/* Plain text inputs, not type="time": Safari's native time widget can
            get stuck reporting "Invalid value" on keyboard-typed times, which
            blocked real submissions. We parse "6pm" / "6:00 PM" / "18:00"
            ourselves at submit and normalize to HH:MM for the edge function. */}
        <label class={labelClass} for="event-time">
          Start time
          <input id="event-time" name="event_time" type="text" maxlength="20" placeholder="e.g. 6:00 PM" class={inputClass} />
        </label>

        <label class={labelClass} for="event-time-end">
          End time
          <input id="event-time-end" name="event_time_end" type="text" maxlength="20" placeholder="e.g. 9:00 PM" class={inputClass} />
        </label>

        <p class={sectionClass}>Where it is</p>

        <label class={labelClass} for="event-venue">
          Venue name<span class={reqClass}>Required</span>
          <input id="event-venue" name="venue" type="text" maxlength="300" placeholder="Where it happens" class={inputClass} required />
        </label>

        <label class={labelClass} for="event-address">
          Address
          <input id="event-address" name="address" type="text" placeholder="Street address" class={inputClass} />
        </label>

        <label class={labelClass} for="event-tag">
          Community tag<span class={reqClass}>Required</span>
          <select id="event-tag" name="diaspora_tag" class={selectClass} required>
            <option value="" selected disabled>Choose one</option>
            {DIASPORA_TAGS.map((tag) => (
              <option value={tag.value}>{tag.label}</option>
            ))}
          </select>
        </label>

        <label class={labelClass} for="location-type">
          Location type<span class={reqClass}>Required</span>
          <select id="location-type" name="location_type" data-location-type class={selectClass} required>
            <option value="" selected disabled>Choose one</option>
            {LOCATION_TYPES.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </label>

        <label class={labelClass} for="chicago-neighborhood" data-when-location="Chicago" hidden>
          Chicago neighborhood<span class={reqClass}>Required</span>
          <select id="chicago-neighborhood" name="chicago_neighborhood" class={selectClass} disabled>
            <option value="" selected disabled>Choose a community area</option>
            {NEIGHBORHOOD_GROUPS.map((group) => (
              <optgroup label={group.side}>
                {group.names.map((name) => (
                  <option value={name}>{name}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>

        <div class="md:col-span-2" data-when-location="Suburb" hidden>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <label class={labelClass} for="suburb">
              Suburb<span class={reqClass}>Required</span>
              <select id="suburb" name="suburb" data-suburb-select class={selectClass} disabled>
                <option value="" selected disabled>Choose a suburb</option>
                {SUBURBS.map((suburb) => (
                  <option value={suburb}>{suburb}</option>
                ))}
              </select>
            </label>

            <label class={labelClass} for="suburb-other" data-suburb-other hidden>
              Which suburb?<span class={reqClass}>Required</span>
              <input id="suburb-other" name="suburb_other" type="text" placeholder="Type the suburb" class={inputClass} disabled />
            </label>
          </div>
        </div>

        <p class={sectionClass}>The details</p>

        <label class={labelClass} for="event-organizer">
          Organizer
          <input id="event-organizer" name="organizer" type="text" placeholder="Host or group" class={inputClass} />
        </label>

        <label class={labelClass} for="event-cost">
          Cost
          <input id="event-cost" name="cost" type="text" placeholder="Free, $10, sliding scale" class={inputClass} />
        </label>

        <label class={`${labelClass} md:col-span-2`} for="event-url">
          Event URL / RSVP link
          <input id="event-url" name="event_url" type="url" placeholder="https://..." class={inputClass} />
        </label>

        <label class={`${labelClass} md:col-span-2`} for="event-image-url">
          Photo or flyer URL
          <input id="event-image-url" name="image_url" type="url" maxlength="2000" placeholder="https://... (link to a flyer or photo)" class={inputClass} />
          <span class={hintClass}>
            A link to your event flyer or a photo helps your event stand out during review. Paste an
            image link from your site, Google Drive, or anywhere public.
          </span>
        </label>

        <label class={`${labelClass} md:col-span-2`} for="event-description">
          Event description<span class={reqClass}>Required, 150 words max</span>
          <textarea id="event-description" name="description" rows="5" maxlength="6000" data-word-limit="150" placeholder="What's happening, who it's for, and why it matters" class={inputClass} required></textarea>
          <span data-word-count class="mt-1.5 block font-body text-[11px] font-bold normal-case tracking-normal text-darkWalnut/60" aria-live="polite">0 / 150 words</span>
        </label>

        {/* Honeypot: hidden from people, tempting to bots. Leave it empty. The name
            avoids browser autofill tokens (the old "company" matched "organization"
            and could be filled by real browsers). */}
        <div class="submit-honeypot" aria-hidden="true">
          <label>
            Event sponsor
            <input name="event_sponsor" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="md:col-span-2">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-size="flexible"></div>
        </div>

        <div class="md:col-span-2 mt-1 flex flex-wrap items-center gap-4">
          <button type="submit" data-submit-button class={`${buttonClass} inline-flex w-full items-center justify-center sm:w-auto`}>Submit for review</button>
          <p data-form-status class="font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
        </div>
      </form>

      <div data-submit-success hidden class="mt-2 border-2 border-darkWalnut bg-seashell p-6 shadow-retro md:p-8">
        <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
          On the platform
        </p>
        <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
          Thanks, your stop is in the queue.
        </h2>
        <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
          Our conductor reviews every submission by hand before it reaches the board. If it's a fit,
          you may see it on the events page, in the weekly newsletter, or on social.
        </p>
        <button type="button" data-submit-another class={`${buttonClass} mt-6`}>Submit another</button>
      </div>
    </div>
  </section>
</Layout>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<style>
  [data-submit-app] [hidden] {
    display: none !important;
  }
  .submit-honeypot {
    position: absolute;
    left: -5000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  const app = document.querySelector('[data-submit-app]') as HTMLElement | null;

  if (app) {
    const functionUrl = app.dataset.functionUrl ?? '';
    const form = app.querySelector('[data-submit-form]') as HTMLFormElement | null;
    const statusEl = app.querySelector('[data-form-status]') as HTMLElement | null;
    const submitButton = app.querySelector('[data-submit-button]') as HTMLButtonElement | null;
    const successPanel = app.querySelector('[data-submit-success]') as HTMLElement | null;
    const submitAnother = app.querySelector('[data-submit-another]') as HTMLButtonElement | null;
    const locationSelect = app.querySelector('[data-location-type]') as HTMLSelectElement | null;
    const suburbSelect = app.querySelector('[data-suburb-select]') as HTMLSelectElement | null;
    const suburbOtherField = app.querySelector('[data-suburb-other]') as HTMLElement | null;

    const conditionalFields = Array.from(
      app.querySelectorAll('[data-when-location]')
    ) as HTMLElement[];

    function fieldControl(field: HTMLElement) {
      return field.querySelector('select, input') as HTMLInputElement | HTMLSelectElement | null;
    }

    function setStatus(message: string, isError: boolean) {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle('text-cayenne', isError);
      statusEl.classList.toggle('text-darkWalnut', !isError);
    }

    function syncSuburbOther() {
      if (!suburbSelect || !suburbOtherField) return;
      const showOther = !suburbSelect.disabled && suburbSelect.value === 'Other';
      suburbOtherField.hidden = !showOther;
      const otherInput = fieldControl(suburbOtherField);
      if (otherInput) {
        otherInput.disabled = !showOther;
        otherInput.required = showOther;
        if (!showOther) otherInput.value = '';
      }
    }

    function syncConditionalFields() {
      const selected = locationSelect?.value ?? '';
      conditionalFields.forEach((field) => {
        const show = field.dataset.whenLocation === selected;
        field.hidden = !show;
        const control = fieldControl(field);
        if (control) {
          control.disabled = !show;
          // Both conditional location fields are required when visible.
          control.required = show;
          if (!show && 'value' in control) control.value = '';
        }
      });
      syncSuburbOther();
    }

    locationSelect?.addEventListener('change', syncConditionalFields);
    suburbSelect?.addEventListener('change', syncSuburbOther);

    // Past dates are rejected server-side; the min attribute stops them earlier.
    const dateInput = app.querySelector('#event-date') as HTMLInputElement | null;
    if (dateInput) {
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      dateInput.min = now.toISOString().slice(0, 10);
    }

    // Description word limit: live counter plus a submit-time check. The same
    // 150-word cap is enforced server-side in the submit-event edge function.
    const DESCRIPTION_WORD_LIMIT = 150;
    const descriptionInput = app.querySelector('#event-description') as HTMLTextAreaElement | null;
    const wordCountEl = app.querySelector('[data-word-count]') as HTMLElement | null;

    function countWords(value: string) {
      return value.trim().split(/\s+/).filter(Boolean).length;
    }

    function updateWordCounter() {
      if (!descriptionInput || !wordCountEl) return;
      const words = countWords(descriptionInput.value);
      wordCountEl.textContent = `${words} / ${DESCRIPTION_WORD_LIMIT} words`;
      wordCountEl.classList.toggle('text-cayenne', words > DESCRIPTION_WORD_LIMIT);
      wordCountEl.classList.toggle('text-darkWalnut/60', words <= DESCRIPTION_WORD_LIMIT);
    }

    descriptionInput?.addEventListener('input', updateWordCounter);
    updateWordCounter();

    // Forgiving time parser for the free-text time fields. Accepts "6pm",
    // "6 PM", "6:00pm", "18:00", "6.30pm", etc. and returns 24-hour "HH:MM",
    // or null when the text is not a recognizable time.
    function parseTimeText(raw: string): string | null {
      const text = raw.trim().toLowerCase().replace(/\./g, ':');
      if (!text) return '';
      const match = text.match(/^(\d{1,2})(?::(\d{2}))?\s*(am|pm|a|p)?$/);
      if (!match) return null;
      let hours = Number(match[1]);
      const minutes = Number(match[2] ?? '0');
      const meridiem = match[3];
      if (minutes > 59) return null;
      if (meridiem) {
        if (hours < 1 || hours > 12) return null;
        if (hours === 12) hours = 0;
        if (meridiem.startsWith('p')) hours += 12;
      } else if (hours > 23) {
        return null;
      } else if (hours < 13) {
        // "6:00" or "9" without AM/PM is ambiguous; make the submitter say which.
        return null;
      }
      return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
    }

    function getTurnstileToken() {
      const input = form?.querySelector(
        '[name="cf-turnstile-response"]'
      ) as HTMLInputElement | null;
      return input?.value ?? '';
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const descriptionWords = countWords(descriptionInput?.value ?? '');
      if (descriptionWords > DESCRIPTION_WORD_LIMIT) {
        setStatus(
          `Your description is ${descriptionWords} words; the limit is ${DESCRIPTION_WORD_LIMIT}. Trim it down and resubmit.`,
          true
        );
        descriptionInput?.focus();
        return;
      }

      const data = new FormData(form);

      const startTime = parseTimeText(String(data.get('event_time') ?? ''));
      const endTime = parseTimeText(String(data.get('event_time_end') ?? ''));
      if (startTime === null || endTime === null) {
        const badField = app.querySelector(
          startTime === null ? '#event-time' : '#event-time-end'
        ) as HTMLInputElement | null;
        setStatus(
          `We couldn't read the ${startTime === null ? 'start' : 'end'} time. Try a format like "6:00 PM".`,
          true
        );
        badField?.focus();
        return;
      }

      const token = getTurnstileToken();
      if (!token) {
        setStatus('Please complete the captcha below.', true);
        return;
      }

      const suburbValue =
        suburbSelect && !suburbSelect.disabled && suburbSelect.value === 'Other'
          ? String(data.get('suburb_other') ?? '')
          : String(data.get('suburb') ?? '');

      const payload = {
        token,
        event_sponsor: String(data.get('event_sponsor') ?? ''),
        submitter_name: String(data.get('submitter_name') ?? ''),
        submitter_email: String(data.get('submitter_email') ?? ''),
        title: String(data.get('title') ?? ''),
        event_date: String(data.get('event_date') ?? ''),
        event_time: startTime,
        event_time_end: endTime,
        venue: String(data.get('venue') ?? ''),
        address: String(data.get('address') ?? ''),
        organizer: String(data.get('organizer') ?? ''),
        diaspora_tag: String(data.get('diaspora_tag') ?? ''),
        location_type: String(data.get('location_type') ?? ''),
        chicago_neighborhood: String(data.get('chicago_neighborhood') ?? ''),
        suburb: suburbValue,
        cost: String(data.get('cost') ?? ''),
        event_url: String(data.get('event_url') ?? ''),
        image_url: String(data.get('image_url') ?? ''),
        description: String(data.get('description') ?? ''),
      };

      void (async () => {
        if (submitButton) submitButton.disabled = true;
        setStatus('Sending your submission...', false);

        try {
          const res = await fetch(functionUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await res.json().catch(() => ({}));

          if (!res.ok || !result.ok) {
            throw new Error(result.error || 'Something went wrong. Please try again.');
          }

          form.reset();
          syncConditionalFields();
          (window as any).turnstile?.reset();
          (window as any).gtag?.('event', 'submit_event_success');
          setStatus('', false);
          form.hidden = true;
          if (successPanel) {
            successPanel.hidden = false;
            // Move focus so screen readers announce the confirmation copy.
            const heading = successPanel.querySelector('h2') as HTMLElement | null;
            if (heading) {
              heading.setAttribute('tabindex', '-1');
              heading.focus();
            }
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Something went wrong.';
          setStatus(message, true);
          (window as any).turnstile?.reset();
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
      })();
    });

    submitAnother?.addEventListener('click', () => {
      if (successPanel) successPanel.hidden = true;
      if (form) form.hidden = false;
      syncConditionalFields();
      form?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    syncConditionalFields();
  }
</script>
