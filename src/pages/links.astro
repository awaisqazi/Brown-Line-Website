---
import Layout from '../layouts/Layout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import TransitDivider from '../components/TransitDivider.astro';
import { getRecentIssues } from '../lib/issues';
import { getUpcomingStops } from '../lib/upcoming';
import { formatStopDate } from '../lib/dates';
import { buildEventPath } from '../lib/seo';

const base = import.meta.env.BASE_URL;

const issues = await getRecentIssues();
const latestIssueHref = issues[0]?.href ?? `${base}newsletter`;

// The next three stops, chosen exactly the way the homepage rail chooses its
// five (runs collapsed, at most one long run), so the bio page never
// disagrees with the site.
const LINKS_EVENTS_LIMIT = 3;
const upcomingStops = await getUpcomingStops({ limit: LINKS_EVENTS_LIMIT, seriesLimit: 1 });
const boardEvents = upcomingStops.map(({ event, recurrenceLabel }) => ({
  href: buildEventPath(event, base),
  title: event.title,
  venue: event.venue,
  dateLabel: recurrenceLabel || formatStopDate(event.event_date),
  isCurated: Boolean(event.is_curated),
}));

// The three latest issues. Issues with an on-site page link there; older
// platform-only issues keep their off-site link.
const recentIssues = issues.slice(0, 3).map((issue) => ({
  ...issue,
  external: /^https?:\/\//.test(issue.href),
}));

const stops = [
  {
    label: 'Read the latest issue',
    href: latestIssueHref,
    external: /^https?:\/\//.test(latestIssueHref),
  },
  {
    label: 'Browse the full newsletter',
    href: `${base}newsletter`,
    external: false,
  },
  {
    label: 'About the founder',
    href: `${base}about`,
    external: false,
  },
  {
    label: 'Instagram @thebrownlinechi',
    href: 'https://www.instagram.com/thebrownlinechi',
    external: true,
  },
  {
    label: 'Browse the events board',
    href: `${base}events`,
    external: false,
  },
];
---
<Layout
  minimal
  title="The Brown Line: Links"
  description="The Brown Line: Chicago's Global South diaspora arts, culture, and community. Subscribe, read, and follow."
  ogImage="logos/4.png"
>
  <TransitDivider />

  <section class="links-page bg-seashell">
    <div class="links-frame relative max-w-md md:max-w-lg mx-auto min-h-[calc(100vh-6px)] px-6 md:px-10 pt-8 md:pt-16 pb-12 md:pb-16 flex flex-col">

      {/* Profile header */}
      <header class="text-center">
        <div class="inline-block relative">
          <img
            src={`${base}logos/4.png`}
            alt="The Brown Line"
            class="w-28 h-28 md:w-36 md:h-36 rounded-full border-2 border-darkWalnut object-cover relative z-10 bg-seashell"
            width="144"
            height="144"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
          <span class="absolute inset-0 rounded-full translate-x-1 translate-y-1 bg-cayenne -z-0" aria-hidden="true"></span>
        </div>

        <p class="font-body uppercase text-[10px] md:text-xs tracking-[0.3em] text-cayenneInk font-bold mt-6 inline-flex items-center gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-cayenne animate-pulse"></span>
          Now boarding
        </p>
        <h1 class="font-heading text-darkWalnut text-3xl md:text-5xl leading-none mt-1">@thebrownlinechi</h1>
        <p class="font-body text-darkWalnut/80 text-sm md:text-base mt-3 md:mt-4 leading-relaxed max-w-sm md:max-w-md mx-auto">
          Underground culture, elevated. Always moving, always above ground.
        </p>
      </header>

      {/* Subscribe (priority CTA) */}
      <section class="mt-10 md:mt-12" aria-labelledby="subscribe-eyebrow">
        <p id="subscribe-eyebrow" class="font-body uppercase text-[10px] md:text-xs tracking-[0.3em] text-darkWalnut/70 font-bold mb-3 md:mb-4">
          Get the newsletter
        </p>
        <SubscribeForm />
      </section>

      <div class="my-10 md:my-14">
        <TransitDivider />
      </div>

      {/* Transit stops (links) */}
      <section aria-labelledby="stops-eyebrow">
        <p id="stops-eyebrow" class="font-body uppercase text-[10px] md:text-xs tracking-[0.3em] text-darkWalnut/70 font-bold mb-3 md:mb-4">
          Next stops
        </p>
        <nav aria-label="Profile links">
          <ul class="link-stops flex flex-col">
            {stops.map(({ label, href, external }) => (
              <li class="link-stop-item">
                <a
                  href={href}
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="link-stop"
                >
                  <span class="link-stop-dot" aria-hidden="true"></span>
                  <span class="link-stop-label">{label}</span>
                  <span class="link-stop-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </section>

      {boardEvents.length > 0 && (
        <section class="mt-10 md:mt-14" aria-labelledby="board-eyebrow">
          <p id="board-eyebrow" class="font-body uppercase text-[10px] md:text-xs tracking-[0.3em] text-darkWalnut/70 font-bold mb-3 md:mb-4">
            Upcoming stops
          </p>
          <ul class="flex flex-col gap-3">
            {boardEvents.map((event, index) => (
              <li>
                <a
                  href={event.href}
                  data-ga-event="rsvp_click"
                  data-ga-label={`links: ${event.title}`}
                  class="link-card group"
                >
                  <span class:list={['link-card-date', ['bg-babyPink', 'bg-mayaBlue', 'bg-celadon'][index % 3]]}>
                    {event.dateLabel}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="link-card-title">
                      {event.isCurated && <span class="link-card-pick" aria-label="Conductor's pick">★</span>}
                      {event.title}
                    </span>
                    <span class="link-card-meta">{event.venue}</span>
                  </span>
                  <span class="link-card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={`${base}events`} class="link-more" data-ga-event="browse_click" data-ga-label="links_board">
            See every stop <span aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {recentIssues.length > 0 && (
        <section class="mt-10 md:mt-14" aria-labelledby="dispatches-eyebrow">
          <p id="dispatches-eyebrow" class="font-body uppercase text-[10px] md:text-xs tracking-[0.3em] text-darkWalnut/70 font-bold mb-3 md:mb-4">
            Recent dispatches
          </p>
          <ul class="flex flex-col gap-3">
            {recentIssues.map((issue) => (
              <li>
                <a
                  href={issue.href}
                  {...(issue.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="link-card group"
                >
                  <span class="min-w-0 flex-1">
                    <span class="link-card-kicker">{issue.date}</span>
                    <span class="link-card-title">{issue.title}</span>
                  </span>
                  <span class="link-card-arrow" aria-hidden="true">{issue.external ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={`${base}newsletter`} class="link-more" data-ga-event="browse_click" data-ga-label="links_dispatches">
            All dispatches <span aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {/* Tagline closer pushed to bottom */}
      <footer class="mt-auto pt-12">
        <p class="font-body text-darkWalnut/55 text-[10px] md:text-xs uppercase tracking-[0.3em] text-center">
          Your go-to guide for Chicago's Global South diaspora arts, culture, and community.
        </p>
      </footer>
    </div>
  </section>
</Layout>

<style>
  /* Desktop "platform rails": two faint walnut lines flank the content column,
     suggesting the column is a train platform. Hidden on mobile. */
  @media (min-width: 768px) {
    .links-frame::before,
    .links-frame::after {
      content: '';
      position: absolute;
      top: 1.5rem;
      bottom: 1.5rem;
      width: 2px;
      background: rgba(100, 39, 19, 0.1);
      pointer-events: none;
    }
    .links-frame::before { left: -1.5rem; }
    .links-frame::after  { right: -1.5rem; }
  }

  /* Vertical transit track that connects the stops */
  .link-stops {
    position: relative;
  }
  .link-stops::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: #642713;
    transform-origin: top;
    transform: scaleY(0);
    animation: track-draw 700ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
    animation-delay: 140ms;
  }
  @keyframes track-draw {
    to { transform: scaleY(1); }
  }

  /* Stop colors: Cayenne leads (priority CTA), then Maya Blue, Celadon, Baby Pink, Amber */
  .link-stop-item:nth-child(1) .link-stop-dot { background: #F35A0F; }
  .link-stop-item:nth-child(2) .link-stop-dot { background: #5BC3FF; }
  .link-stop-item:nth-child(3) .link-stop-dot { background: #90D393; }
  .link-stop-item:nth-child(4) .link-stop-dot { background: #F79CD0; }
  .link-stop-item:nth-child(5) .link-stop-dot { background: #FFBC29; }

  /* Stagger entry: stops slide in one at a time like cars arriving */
  .link-stop-item {
    opacity: 0;
    transform: translateX(20px);
    animation: stop-arrive 450ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .link-stop-item:nth-child(1) { animation-delay: 220ms; }
  .link-stop-item:nth-child(2) { animation-delay: 300ms; }
  .link-stop-item:nth-child(3) { animation-delay: 380ms; }
  .link-stop-item:nth-child(4) { animation-delay: 460ms; }
  .link-stop-item:nth-child(5) { animation-delay: 540ms; }
  @keyframes stop-arrive {
    to { opacity: 1; transform: translateX(0); }
  }

  .link-stop {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0;
    font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #642713;
    line-height: 1;
    transition: color 200ms ease, transform 220ms ease;
  }

  @media (min-width: 768px) {
    .link-stop {
      padding: 1.2rem 0;
      font-size: 1.125rem;
    }
  }

  .link-stop-dot {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    border: 2px solid #642713;
    box-shadow: 2px 2px 0 #642713;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .link-stop-label {
    flex: 1;
  }

  .link-stop-arrow {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0;
    color: #642713;
    opacity: 0.55;
    transition: opacity 200ms ease, transform 200ms ease, color 200ms ease;
  }

  .link-stop:hover,
  .link-stop:focus-visible {
    color: #B8420A;
    transform: translateX(4px);
    outline: none;
  }
  .link-stop:hover .link-stop-dot,
  .link-stop:focus-visible .link-stop-dot {
    transform: scale(1.15);
    box-shadow: 3px 3px 0 #642713;
  }
  .link-stop:hover .link-stop-arrow,
  .link-stop:focus-visible .link-stop-arrow {
    opacity: 1;
    color: #B8420A;
    transform: translateX(3px);
  }

  /* Compact cards for the upcoming stops and recent dispatches: the site's
     bordered card at bio-page scale, one retro shadow step on hover. */
  .link-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border: 2px solid #642713;
    background: #FDFBF7;
    padding: 0.75rem 0.9rem;
    color: #642713;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .link-card:hover,
  .link-card:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 #642713;
    outline: none;
  }
  .link-card-date {
    flex-shrink: 0;
    border: 2px solid #642713;
    padding: 0.3rem 0.5rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    color: #642713;
  }
  .link-card-kicker {
    display: block;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(100, 39, 19, 0.7);
    margin-bottom: 0.2rem;
  }
  .link-card-title {
    display: block;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .link-card-pick {
    color: #B8420A;
    margin-right: 0.3rem;
  }
  .link-card-meta {
    display: block;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.75rem;
    line-height: 1.3;
    color: rgba(100, 39, 19, 0.75);
    margin-top: 0.2rem;
  }
  .link-card-arrow {
    flex-shrink: 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.125rem;
    opacity: 0.55;
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .link-card:hover .link-card-arrow,
  .link-card:focus-visible .link-card-arrow {
    opacity: 1;
    transform: translateX(3px);
  }
  .link-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #642713;
    text-decoration: underline;
    text-decoration-color: #5BC3FF;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .link-more:hover,
  .link-more:focus-visible {
    color: #B8420A;
    text-decoration-color: #F35A0F;
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .link-card,
    .link-card-arrow {
      transition: none !important;
    }
    .link-stop-item,
    .link-stops::before,
    .link-stop,
    .link-stop-dot,
    .link-stop-arrow {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
