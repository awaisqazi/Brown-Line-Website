---
import Layout from '../../layouts/Layout.astro';
import TransitDivider from '../../components/TransitDivider.astro';

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabasePublishableKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY;
const base = import.meta.env.BASE_URL;

if (!supabaseUrl || !supabasePublishableKey) {
  throw new Error('Missing Supabase environment variables.');
}

const inputClass =
  'mt-2 w-full border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-sm text-darkWalnut placeholder:text-darkWalnut/45 focus:outline-none focus:ring-2 focus:ring-mayaBlue';
const labelClass = 'block font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65';
const buttonClass =
  'border-2 border-darkWalnut bg-cayenne px-4 py-3 font-body text-xs font-bold uppercase tracking-widest text-seashell shadow-retro transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue';
const secondaryButtonClass =
  'inline-flex border-2 border-darkWalnut bg-amber px-4 py-3 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut shadow-retro transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue';
const fieldMarkerClass = 'ml-2 text-[9px] tracking-widest';
// The fixed diaspora category taxonomy. Events carry only these tags.
const DIASPORA_TAGS = [
  'South Asian',
  'SWANA',
  'East Asian',
  'Southeast Asian',
  'Black Diaspora',
  'Latine',
  'Afro-Latine',
  'Indigenous',
  'Cross-cultural',
];
const csvHeaders = [
  'event_date',
  'title',
  'venue',
  'start_time',
  'end_time',
  'neighborhood',
  'description',
  'organizer',
  'cost_info',
  'event_url',
  'image_url',
  'author_note',
  'emoji',
  'tags',
  'is_curated',
  'is_giveaway',
];
const csvTemplateHref = `data:text/csv;charset=utf-8,${encodeURIComponent(`${csvHeaders.join(',')}\n`)}`;
---

<Layout
  title="Events Admin | The Brown Line"
  description="Internal event management for The Brown Line."
  minimal
  noindex
>
  <section
    data-admin-events-app
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabasePublishableKey}
    data-functions-base={`${supabaseUrl}/functions/v1`}
    class="min-h-screen px-6 py-8 md:px-10 md:py-12"
  >
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <img src={`${base}logos/logo.png`} alt="The Brown Line" class="h-12 w-auto" />
          <p class="mt-8 font-body text-xs font-bold uppercase tracking-[0.3em] text-cayenne">
            Internal platform
          </p>
          <h1 class="mt-3 font-heading text-[2.75rem] leading-none text-darkWalnut md:text-6xl">
            Events admin portal
          </h1>
          <p class="mt-5 max-w-2xl font-body text-base leading-relaxed text-darkWalnut/75 md:text-lg">
            Add single events, scan a flyer, import a spreadsheet, review community submissions, or edit the full schedule. Every change saves to the database instantly; the public page rebuilds every 4 hours, or push it out right away with Publish live site.
          </p>
          <p class="mt-5">
            <a
              href={`${base}admin/articles`}
              class="inline-flex border-2 border-darkWalnut bg-amber px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
            >Go to articles admin</a>
          </p>
        </div>

        <button
          type="button"
          data-admin-logout
          hidden
          class="self-start border-2 border-darkWalnut bg-seashell px-4 py-2 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
        >
          Lock portal
        </button>
      </div>

      <div class="mt-10">
        <TransitDivider />
      </div>

      <section
        data-login-panel
        class="mt-10 max-w-xl border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-7"
      >
        <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
          Staff only
        </p>
        <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
          Enter the line room.
        </h2>
        {/* onsubmit guard: if the module script has not attached yet, a native submit
            would GET the page with ?password=... in the URL. Block it outright. */}
        <form data-password-form class="mt-6 space-y-4" onsubmit="return false">
          <label class={labelClass} for="admin-password">
            Password
            <input
              id="admin-password"
              name="password"
              type="password"
              autocomplete="current-password"
              class={inputClass}
              required
            />
          </label>
          <button type="submit" data-login-submit class={buttonClass}>Unlock admin</button>
          <p data-login-status class="font-body text-sm font-bold text-cayenne" role="status" aria-live="polite"></p>
        </form>
      </section>

      <section data-scanner-section hidden class="mt-10 border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-7">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
              Camera car
            </p>
            <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
              Scan a flyer
            </h2>
          </div>
          <p
            data-scan-quota
            class="border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut"
            role="status"
            aria-live="polite"
          >
            Checking today's scans...
          </p>
        </div>

        <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
          Upload a flyer photo and Gemini reads it into a draft event. The draft lands in the
          Add one event form below, so review every field before saving. Scans come from a shared
          daily pool across all admins and reset at midnight Chicago time.
        </p>

        <form data-scan-form class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <label class={labelClass} for="scan-file">
            Flyer photo
            <input
              id="scan-file"
              data-scan-file
              type="file"
              accept="image/*"
              class="mt-2 w-full border-2 border-dashed border-darkWalnut bg-seashell px-3 py-6 font-body text-sm text-darkWalnut file:mr-4 file:border-2 file:border-darkWalnut file:bg-amber file:px-3 file:py-2 file:font-body file:text-xs file:font-bold file:uppercase file:tracking-widest file:text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue"
              required
            />
          </label>
          <button type="submit" data-scan-submit class={buttonClass}>Scan with Gemini</button>
        </form>

        <div data-scan-preview-wrap hidden class="mt-4 border-2 border-dashed border-darkWalnut/35 bg-seashell p-3">
          <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45">
            Selected photo
          </p>
          <img
            data-scan-preview
            alt="Selected flyer"
            class="mt-2 max-h-64 w-auto max-w-full border-2 border-darkWalnut object-contain"
          />
        </div>

        <p data-scan-status class="mt-4 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
      </section>

      <section data-admin-portal hidden class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
        <div class="border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-7">
          <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
            Single stop
          </p>
          <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
            Add one event
          </h2>
          <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
            Fill the fields marked Required. Optional fields can stay blank if we do not have that detail yet.
          </p>

          {/* novalidate: native validation stops at the first empty required field.
              The submit handler collects every missing one and names them all in a
              single message instead. */}
          <form data-single-event-form novalidate class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">
            <label class={labelClass} for="event-title">
              Title
              <span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input id="event-title" name="title" type="text" class={inputClass} required />
            </label>

            <label class={labelClass} for="event-date">
              Event date
              <span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input id="event-date" name="event_date" type="date" class={inputClass} required />
            </label>

            <label class={labelClass} for="event-venue">
              Venue
              <span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input id="event-venue" name="venue" type="text" class={inputClass} required />
            </label>

            <label class={labelClass} for="event-start-time">
              Start time
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-start-time" name="start_time" type="time" class={inputClass} />
            </label>

            <label class={labelClass} for="event-end-time">
              End time
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-end-time" name="end_time" type="time" class={inputClass} />
            </label>

            <label class={labelClass} for="event-neighborhood">
              Neighborhood
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-neighborhood" name="neighborhood" type="text" placeholder="Pilsen, Hyde Park" class={inputClass} />
            </label>

            <label class={labelClass} for="event-organizer">
              Organizer
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-organizer" name="organizer" type="text" class={inputClass} />
            </label>

            <label class={labelClass} for="event-cost-info">
              Cost info
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-cost-info" name="cost_info" type="text" class={inputClass} />
            </label>

            <label class={`${labelClass} md:col-span-2`} for="event-url">
              Event URL
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-url" name="event_url" type="url" placeholder="https://..." class={inputClass} />
            </label>

            <label class={`${labelClass} md:col-span-2`} for="event-image-url">
              Photo or flyer URL
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-image-url" name="image_url" type="url" placeholder="https://... (link to a flyer or photo)" class={inputClass} />
            </label>

            <label class={labelClass} for="event-emoji">
              Emoji
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input id="event-emoji" name="emoji" type="text" class={inputClass} />
            </label>

            <fieldset class="md:col-span-2">
              <legend class={labelClass}>
                Community tags
                <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional, pick any that apply</span>
              </legend>
              <div class="mt-2 flex flex-wrap gap-2">
                {DIASPORA_TAGS.map((tag) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut has-[:checked]:bg-amber">
                    <input name="tags" value={tag} type="checkbox" class="h-4 w-4 accent-cayenne" />
                    {tag}
                  </label>
                ))}
              </div>
            </fieldset>

            <label class={`${labelClass} md:col-span-2`} for="event-description">
              Description
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <textarea id="event-description" name="description" rows="5" class={inputClass}></textarea>
            </label>

            <label class={`${labelClass} md:col-span-2`} for="event-author-note">
              Author note
              <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <textarea id="event-author-note" name="author_note" rows="3" class={inputClass}></textarea>
            </label>

            <div class="flex flex-wrap gap-3 md:col-span-2">
              <p class="basis-full font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45">
                Optional flags
              </p>
              <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
                <input name="is_curated" type="checkbox" class="h-4 w-4 accent-cayenne" />
                Conductor's pick
              </label>

              <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
                <input name="is_giveaway" type="checkbox" class="h-4 w-4 accent-cayenne" />
                Giveaway
              </label>
            </div>

            <div class="md:col-span-2">
              <button type="submit" data-single-submit class={buttonClass}>Add event</button>
              {/* A div, not a p: the success confirmation renders a block-level
                  banner inside this same live region so it is announced. */}
              <div data-single-status class="mt-3 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></div>
            </div>
          </form>
        </div>

        <div class="border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-7">
          <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
            Spreadsheet transfer
          </p>
          <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
            Bulk CSV upload
          </h2>

          <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
            Download the template, fill one row per event, then upload the finished CSV here. Optional columns can stay blank or be removed from the file.
          </p>

          <a
            href={csvTemplateHref}
            download="brown-line-events-template.csv"
            class={`${secondaryButtonClass} mt-5`}
          >
            Download CSV template
          </a>

          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="border-2 border-darkWalnut bg-seashell p-4">
              <p class="font-body text-[10px] font-bold uppercase tracking-widest text-cayenne">
                Required columns
              </p>
              <p class="mt-2 font-body text-sm leading-relaxed text-darkWalnut/75">
                event_date, title, venue
              </p>
            </div>

            <div class="border-2 border-dashed border-darkWalnut/35 bg-seashell p-4">
              <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/55">
                Optional columns
              </p>
              <p class="mt-2 font-body text-sm leading-relaxed text-darkWalnut/75">
                start_time, end_time, neighborhood, description, organizer, cost_info, event_url, image_url, author_note, emoji, tags, is_curated, is_giveaway
              </p>
            </div>
          </div>

          <p class="mt-4 font-body text-sm leading-relaxed text-darkWalnut/75">
            Tags can be comma-separated inside one cell and must come from the fixed community tag
            list: {DIASPORA_TAGS.join(', ')}. For pick or giveaway columns, use true, false, yes,
            no, 1, or 0. Start time and end time both use 24-hour HH:MM. An end time may be
            earlier than its start time when the event runs past midnight.
          </p>

          <form data-csv-form class="mt-7 space-y-5">
            <label class={labelClass} for="event-csv">
              CSV file
              <input
                id="event-csv"
                data-csv-file
                type="file"
                accept=".csv,text/csv"
                class="mt-2 w-full border-2 border-dashed border-darkWalnut bg-seashell px-3 py-8 font-body text-sm text-darkWalnut file:mr-4 file:border-2 file:border-darkWalnut file:bg-amber file:px-3 file:py-2 file:font-body file:text-xs file:font-bold file:uppercase file:tracking-widest file:text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue"
                required
              />
            </label>

            <div class="border-2 border-dashed border-darkWalnut/35 bg-seashell p-4">
              <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
                When will it show up?
              </p>
              <p class="mt-2 font-body text-sm leading-relaxed text-darkWalnut/75">
                Saves land in the database instantly. The public page rebuilds every 4 hours on its own, or press Publish live site in the schedule section to push everything out in a couple of minutes.
              </p>
            </div>

            <button type="submit" data-csv-submit class={buttonClass}>Upload CSV</button>
            <div data-csv-status class="font-body text-sm font-bold leading-relaxed text-darkWalnut" role="status" aria-live="polite"></div>
          </form>
        </div>
      </section>

      <section data-database-section hidden class="mt-12 border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-7">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
              Control tower
            </p>
            <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
              The full schedule
              <span data-db-count class="ml-2 align-middle font-body text-base font-bold text-darkWalnut/60"></span>
            </h2>
          </div>
          <p data-db-live class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45" role="status">
            Live updates: connecting...
          </p>
        </div>

        <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
          Every event in the database. Edits and deletes save to Supabase the moment you confirm
          them, and this list refreshes by itself when anyone makes a change. The public page is a
          static rebuild of this data: press Publish live site to push changes out in a couple of
          minutes instead of waiting for the 4-hour refresh.
        </p>

        <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto_auto] md:items-end">
          <label class={labelClass} for="db-scope">
            Show
            <select id="db-scope" data-db-scope class={inputClass}>
              <option value="upcoming" selected>Upcoming events</option>
              <option value="all">All events, including past</option>
            </select>
          </label>
          <label class={labelClass} for="db-search">
            Search
            <input
              id="db-search"
              data-db-search
              type="search"
              placeholder="Title, venue, organizer, tag..."
              class={inputClass}
            />
          </label>
          <button type="button" data-db-refresh class={secondaryButtonClass}>Refresh</button>
          <button type="button" data-db-publish class={buttonClass}>Publish live site</button>
        </div>

        <p data-db-publish-status class="mt-3 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
        <p data-db-status class="mt-3 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>

        <div data-db-list class="mt-6 space-y-3"></div>
      </section>

      <section data-submissions-section hidden class="mt-12 border-2 border-darkWalnut bg-[#FDFBF7] p-5 shadow-retro md:p-7">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenne">
              Community inbox
            </p>
            <h2 class="mt-3 font-heading text-4xl leading-none text-darkWalnut">
              Review submissions
              <span data-submissions-count class="ml-2 align-middle font-body text-base font-bold text-darkWalnut/60"></span>
            </h2>
          </div>
          <button type="button" data-refresh-submissions class={secondaryButtonClass}>Refresh</button>
        </div>

        <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
          Public requests from the submit form land here. Edit anything, set the editorial flags, then
          Approve to publish into the live events table, or Reject to dismiss.
        </p>

        <p data-submissions-status class="mt-5 font-body text-sm font-bold text-darkWalnut/70" role="status" aria-live="polite"></p>

        <div data-submissions-list class="mt-6 space-y-8"></div>
      </section>

      <template data-submission-template>
        <article data-submission-card class="border-2 border-darkWalnut bg-seashell p-5 shadow-[3px_3px_0_#642713] md:p-6">
          <div class="flex flex-wrap items-start justify-between gap-3 border-b-2 border-dashed border-darkWalnut/35 pb-4">
            <div class="min-w-0">
              <p class="font-body text-[10px] font-bold uppercase tracking-widest text-cayenne">
                From <span data-display="submitter_name"></span>
              </p>
              <p class="mt-1 font-body text-xs text-darkWalnut/70">
                <span data-display="submitter_email"></span>
                <span data-display="created_at" class="ml-2 text-darkWalnut/45"></span>
              </p>
            </div>
            <div class="border-2 border-darkWalnut bg-[#FDFBF7] px-2 py-1 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut">
              <span data-display="location_type"></span>
            </div>
          </div>

          <div data-raw-location class="mt-3 font-body text-xs leading-relaxed text-darkWalnut/65" hidden>
            <span class="font-bold uppercase tracking-widest text-darkWalnut/45">Submitted location</span>
            <span data-display="raw_location" class="ml-2"></span>
          </div>

          <div data-photo-wrap class="mt-4 border-2 border-dashed border-darkWalnut/35 bg-[#FDFBF7] p-3" hidden>
            <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45">
              Submitted photo
            </p>
            <img
              data-photo
              alt="Submitted event photo or flyer"
              loading="lazy"
              referrerpolicy="no-referrer"
              class="mt-2 max-h-64 w-auto max-w-full border-2 border-darkWalnut object-contain"
            />
            <a
              data-photo-link
              href="#"
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="mt-2 inline-block break-all font-body text-xs font-bold text-cayenne underline"
            >Open original</a>
          </div>

          <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
            <label class={`${labelClass} md:col-span-2`}>
              Title<span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input data-field="title" type="text" class={inputClass} required />
            </label>

            <label class={labelClass}>
              Event date<span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input data-field="event_date" type="date" class={inputClass} required />
            </label>

            <label class={labelClass}>
              Start time<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input data-field="start_time" type="time" class={inputClass} />
            </label>

            <label class={labelClass}>
              End time<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input data-field="end_time" type="time" class={inputClass} />
            </label>

            <label class={labelClass}>
              Venue<span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input data-field="venue" type="text" class={inputClass} required />
            </label>

            <label class={labelClass}>
              Neighborhood<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
