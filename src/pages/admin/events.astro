            <label class={`${labelClass} md:col-span-2`}>
              Description<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <textarea name="description" rows="4" class={inputClass}></textarea>
            </label>

            <label class={`${labelClass} md:col-span-2`}>
              Author note<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <textarea name="author_note" rows="2" class={inputClass}></textarea>
            </label>

            <div class="flex flex-wrap gap-3 md:col-span-2">
              <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
                <input name="is_curated" type="checkbox" class="h-4 w-4 accent-cayenne" />
                Conductor's pick
              </label>
              <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
                <input name="is_giveaway" type="checkbox" class="h-4 w-4 accent-cayenne" />
                Giveaway
              </label>
