              >Edit</button>
              <button
                type="button"
                data-row-delete
                class="border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-cayenne transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue disabled:cursor-not-allowed disabled:opacity-60"
              >Delete</button>
            </div>
          </div>

          <form data-row-editor hidden class="grid grid-cols-1 gap-4 border-t-2 border-dashed border-darkWalnut/35 p-4 md:grid-cols-2">
            <label class={labelClass}>
              Title<span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input name="title" type="text" class={inputClass} required />
            </label>

            <label class={labelClass}>
              Event date<span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input name="event_date" type="date" class={inputClass} required />
            </label>

            <label class={labelClass}>
              Venue<span class={`${fieldMarkerClass} text-cayenne`}>Required</span>
              <input name="venue" type="text" class={inputClass} required />
            </label>

            <label class={labelClass}>
              Start time<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input name="start_time" type="time" class={inputClass} />
            </label>

            <label class={labelClass}>
