            <div class="flex flex-wrap items-center gap-3 border-t-2 border-dashed border-darkWalnut/35 pt-4 md:col-span-2">
              <button type="submit" data-row-save class={`${buttonClass} disabled:cursor-not-allowed disabled:opacity-60`}>Save changes</button>
              <button
                type="button"
                data-row-cancel
                class="border-2 border-darkWalnut bg-seashell px-4 py-3 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
              >Cancel</button>
              <p data-row-status class="font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
            </div>
          </form>
        </article>
      </template>
    </div>
  </section>
</Layout>

<style>
  [data-admin-events-app] [hidden] {
    display: none !important;
  }
</style>

<script>
  import Papa from 'papaparse';
  import {
    createClient,
    type RealtimeChannel,
    type SupabaseClient,
  } from '@supabase/supabase-js';

  type AdminEventRecord = {
    event_date: string;
    title: string;
    venue: string;
    start_time: string | null;
    end_time: string | null;
    neighborhood: string | null;
    description: string | null;
    organizer: string | null;
    cost_info: string | null;
    event_url: string | null;
    image_url: string | null;
    author_note: string | null;
    emoji: string | null;
    tags: string[] | null;
    is_curated: boolean;
    is_giveaway: boolean;
  };

  // Keep in sync with DIASPORA_TAGS in the frontmatter and the public submit form.
  const ALLOWED_TAGS = [
    'South Asian',
    'SWANA',
    'East Asian',
    'Southeast Asian',
    'Black Diaspora',
    'Latine',
    'Afro-Latine',
    'Indigenous',
    'Cross-cultural',
  ];

  type CsvRow = Record<string, unknown>;

  const app = document.querySelector('[data-admin-events-app]') as HTMLElement | null;

  if (app) {
    const supabaseUrl = app.dataset.supabaseUrl ?? '';
    const supabaseKey = app.dataset.supabaseKey ?? '';
    const functionsBase = app.dataset.functionsBase ?? '';
    let adminSupabase: SupabaseClient | null = null;
    // Kept in memory only, same threat model as the client above: the scanner
    // and publish endpoints re-verify it server-side on every call.
    let adminPassword = '';
    let dbChannel: RealtimeChannel | null = null;
    let dbReloadTimer: ReturnType<typeof setTimeout> | undefined;
    let scanPreviewUrl: string | null = null;

    const loginPanel = app.querySelector('[data-login-panel]') as HTMLElement | null;
    const portal = app.querySelector('[data-admin-portal]') as HTMLElement | null;
    const passwordForm = app.querySelector('[data-password-form]') as HTMLFormElement | null;
    const loginSubmit = app.querySelector('[data-login-submit]') as HTMLButtonElement | null;
    const loginStatus = app.querySelector('[data-login-status]') as HTMLElement | null;
    const logoutButton = app.querySelector('[data-admin-logout]') as HTMLButtonElement | null;
    const singleEventForm = app.querySelector('[data-single-event-form]') as HTMLFormElement | null;
    const singleSubmit = app.querySelector('[data-single-submit]') as HTMLButtonElement | null;
    const singleStatus = app.querySelector('[data-single-status]') as HTMLElement | null;
    const csvForm = app.querySelector('[data-csv-form]') as HTMLFormElement | null;
    const csvSubmit = app.querySelector('[data-csv-submit]') as HTMLButtonElement | null;
    const csvStatus = app.querySelector('[data-csv-status]') as HTMLElement | null;
    const csvFileInput = app.querySelector('[data-csv-file]') as HTMLInputElement | null;
    const submissionsSection = app.querySelector('[data-submissions-section]') as HTMLElement | null;
    const submissionsList = app.querySelector('[data-submissions-list]') as HTMLElement | null;
    const submissionsStatus = app.querySelector('[data-submissions-status]') as HTMLElement | null;
    const submissionsCount = app.querySelector('[data-submissions-count]') as HTMLElement | null;
    const refreshSubmissionsButton = app.querySelector('[data-refresh-submissions]') as HTMLButtonElement | null;
    const submissionTemplate = app.querySelector('[data-submission-template]') as HTMLTemplateElement | null;
    const scannerSection = app.querySelector('[data-scanner-section]') as HTMLElement | null;
    const scanForm = app.querySelector('[data-scan-form]') as HTMLFormElement | null;
    const scanFile = app.querySelector('[data-scan-file]') as HTMLInputElement | null;
    const scanSubmit = app.querySelector('[data-scan-submit]') as HTMLButtonElement | null;
    const scanStatus = app.querySelector('[data-scan-status]') as HTMLElement | null;
    const scanQuota = app.querySelector('[data-scan-quota]') as HTMLElement | null;
    const scanPreviewWrap = app.querySelector('[data-scan-preview-wrap]') as HTMLElement | null;
    const scanPreview = app.querySelector('[data-scan-preview]') as HTMLImageElement | null;
    const databaseSection = app.querySelector('[data-database-section]') as HTMLElement | null;
    const dbList = app.querySelector('[data-db-list]') as HTMLElement | null;
    const dbCount = app.querySelector('[data-db-count]') as HTMLElement | null;
    const dbStatus = app.querySelector('[data-db-status]') as HTMLElement | null;
    const dbLive = app.querySelector('[data-db-live]') as HTMLElement | null;
    const dbScopeSelect = app.querySelector('[data-db-scope]') as HTMLSelectElement | null;
    const dbSearch = app.querySelector('[data-db-search]') as HTMLInputElement | null;
    const dbRefresh = app.querySelector('[data-db-refresh]') as HTMLButtonElement | null;
    const dbPublish = app.querySelector('[data-db-publish]') as HTMLButtonElement | null;
    const dbPublishStatus = app.querySelector('[data-db-publish-status]') as HTMLElement | null;
    const eventRowTemplate = app.querySelector('[data-event-row-template]') as HTMLTemplateElement | null;
    let dbEvents: Array<AdminEventRecord & { id: string }> = [];

    function setUnlocked(isUnlocked: boolean) {
      if (loginPanel) loginPanel.hidden = isUnlocked;
      if (portal) portal.hidden = !isUnlocked;
      if (logoutButton) logoutButton.hidden = !isUnlocked;
      if (submissionsSection) submissionsSection.hidden = !isUnlocked;
      if (scannerSection) scannerSection.hidden = !isUnlocked;
      if (databaseSection) databaseSection.hidden = !isUnlocked;
      if (isUnlocked) {
        void loadSubmissions();
        void loadDbEvents();
        subscribeDbRealtime();
        void refreshScanQuota();
      } else {
        teardownDbRealtime();
        dbEvents = [];
        if (dbList) dbList.innerHTML = '';
        if (dbCount) dbCount.textContent = '';
        if (dbStatus) dbStatus.textContent = '';
        if (dbPublishStatus) dbPublishStatus.textContent = '';
        if (dbSearch) dbSearch.value = '';
        scanForm?.reset();
        clearScanPreview();
        if (scanQuota) scanQuota.textContent = "Checking today's scans...";
        if (scanStatus) scanStatus.textContent = '';
        if (submissionsList) {
          submissionsList.innerHTML = '';
          if (submissionsCount) submissionsCount.textContent = '';
          if (submissionsStatus) submissionsStatus.textContent = '';
        }
      }
    }

    function createAdminClient(password: string) {
      return createClient(supabaseUrl, supabaseKey, {
        auth: {
          autoRefreshToken: false,
          persistSession: false,
        },
        global: {
          headers: {
            'x-admin-password': password,
          },
        },
      });
    }

    function cleanText(value: unknown) {
      return typeof value === 'string' ? value.trim() : '';
    }

    function nullableText(value: unknown) {
      const clean = cleanText(value);
      return clean.length > 0 ? clean : null;
    }

    function requiredText(value: unknown, fieldName: string) {
      const clean = cleanText(value);
      if (!clean) throw new Error(`${fieldName} is required.`);
      return clean;
    }

    function requiredDate(value: unknown) {
      const clean = requiredText(value, 'event_date');
      if (!/^\d{4}-\d{2}-\d{2}$/.test(clean)) {
        throw new Error('event_date must use YYYY-MM-DD format.');
      }
      return clean;
    }

    function normalizeUrl(value: unknown, fieldName = 'event_url') {
      const clean = nullableText(value);
      if (!clean) return null;
      if (!/^https?:\/\//i.test(clean)) {
        throw new Error(`${fieldName} must start with http:// or https://.`);
      }
      return clean;
    }

    // Shared by start_time and end_time. An end time is never compared against
    // its start time: events that run past midnight legitimately end earlier in
    // clock terms than they begin.
    function normalizeTimeOfDay(value: unknown, fieldName: string) {
      const clean = nullableText(value);
      if (!clean) return null;
      if (!/^\d{2}:\d{2}(:\d{2})?$/.test(clean)) {
        throw new Error(`${fieldName} must use 24-hour HH:MM format.`);
      }
      return clean.slice(0, 5);
    }

    // Case-insensitive match against the fixed taxonomy, normalized to the
    // canonical casing. Unknown tags are an error so free-form labels can
    // never leak onto the public board.
    function validateTags(tags: string[] | null) {
      if (!tags) return null;
      const normalized = tags.map((tag) => {
        const match = ALLOWED_TAGS.find((allowed) => allowed.toLowerCase() === tag.toLowerCase());
        if (!match) {
          throw new Error(`Unknown tag "${tag}". Allowed tags: ${ALLOWED_TAGS.join(', ')}.`);
        }
        return match;
      });
      return [...new Set(normalized)];
    }

    function parseTags(value: unknown) {
      const clean = cleanText(value);
      if (!clean) return null;

      if (clean.startsWith('[')) {
        try {
          const parsed = JSON.parse(clean);
          if (Array.isArray(parsed)) {
            const tags = parsed.map((tag) => cleanText(tag)).filter(Boolean);
            return tags.length > 0 ? tags : null;
          }
        } catch (_) {
          // Fall back to delimiter parsing below.
        }
      }

      const tags = clean
        .split(/[|,]/)
        .map((tag) => tag.trim())
        .filter(Boolean);

      return tags.length > 0 ? tags : null;
    }

    function setInlineStatus(el: HTMLElement | null, message: string, isError = false) {
      if (!el) return;
      el.textContent = message;
      el.classList.toggle('text-cayenne', isError);
      el.classList.toggle('text-darkWalnut', !isError);
    }

    // The single-add form confirms with a themed banner rather than a text line.
    // It is built inside the existing status element so the same live region
    // announces it, and so the next setInlineStatus call wipes it.
    function setSingleSuccessBanner(title: string) {
      if (!singleStatus) return;
      singleStatus.textContent = '';
      singleStatus.classList.remove('text-cayenne');
      singleStatus.classList.add('text-darkWalnut');

      const banner = document.createElement('div');
      banner.className = 'border-2 border-darkWalnut bg-celadon p-4 shadow-retro';

      const heading = document.createElement('p');
      heading.className = 'font-body text-[10px] font-bold uppercase tracking-[0.3em] text-darkWalnut';
      heading.textContent = 'Now boarding';

      const body = document.createElement('p');
      body.className = 'mt-2 font-body text-sm font-normal leading-relaxed text-darkWalnut';
      body.textContent = `"${title}" is on the schedule. Press Publish live site to show it publicly now, or wait for the scheduled rebuild.`;

      banner.append(heading, body);
      singleStatus.appendChild(banner);
    }

    // Disable a button and show progress text while `work` runs.
    async function withBusy<T>(button: HTMLButtonElement | null, busyLabel: string, work: () => Promise<T>) {
      const restore = button?.textContent ?? '';
      if (button) {
        button.disabled = true;
        button.textContent = busyLabel;
      }
      try {
        return await work();
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = restore;
        }
      }
    }

    function parseBoolean(value: unknown) {
      const clean = cleanText(value).toLowerCase();
      if (!clean) return false;
      return ['true', '1', 'yes', 'y', 'x'].includes(clean);
    }

    function getFormValue(formData: FormData, name: string) {
      return formData.get(name);
    }

    function recordFromForm(form: HTMLFormElement): AdminEventRecord {
      const formData = new FormData(form);
      const checkedTags = formData.getAll('tags').map((tag) => cleanText(tag)).filter(Boolean);
      return {
        title: requiredText(getFormValue(formData, 'title'), 'title'),
        event_date: requiredDate(getFormValue(formData, 'event_date')),
        venue: requiredText(getFormValue(formData, 'venue'), 'venue'),
        start_time: normalizeTimeOfDay(getFormValue(formData, 'start_time'), 'start_time'),
        end_time: normalizeTimeOfDay(getFormValue(formData, 'end_time'), 'end_time'),
        neighborhood: nullableText(getFormValue(formData, 'neighborhood')),
        organizer: nullableText(getFormValue(formData, 'organizer')),
        cost_info: nullableText(getFormValue(formData, 'cost_info')),
        event_url: normalizeUrl(getFormValue(formData, 'event_url')),
        image_url: normalizeUrl(getFormValue(formData, 'image_url'), 'image_url'),
        description: nullableText(getFormValue(formData, 'description')),
        author_note: nullableText(getFormValue(formData, 'author_note')),
        emoji: nullableText(getFormValue(formData, 'emoji')),
        tags: validateTags(checkedTags.length > 0 ? checkedTags : null),
        is_curated: formData.get('is_curated') === 'on',
        is_giveaway: formData.get('is_giveaway') === 'on',
      };
    }

    // Only the single-add form runs this pass. The review cards and the row
    // editor keep their native validation, which is fine on a form the admin is
    // correcting one field at a time.
    const SINGLE_REQUIRED_FIELDS = [
      { name: 'title', label: 'Title' },
      { name: 'event_date', label: 'Event date' },
      { name: 'venue', label: 'Venue' },
    ];

    function missingRequiredLabels(form: HTMLFormElement) {
      const formData = new FormData(form);
      return SINGLE_REQUIRED_FIELDS.filter(
        (field) => !cleanText(getFormValue(formData, field.name))
      ).map((field) => field.label);
    }

    function recordFromCsvRow(row: CsvRow, rowNumber: number): AdminEventRecord {
      try {
        return {
          event_date: requiredDate(row.event_date),
          title: requiredText(row.title, 'title'),
          venue: requiredText(row.venue, 'venue'),
          start_time: normalizeTimeOfDay(row.start_time, 'start_time'),
          end_time: normalizeTimeOfDay(row.end_time, 'end_time'),
          neighborhood: nullableText(row.neighborhood),
          description: nullableText(row.description),
          organizer: nullableText(row.organizer),
          cost_info: nullableText(row.cost_info),
          event_url: normalizeUrl(row.event_url),
          image_url: normalizeUrl(row.image_url, 'image_url'),
          author_note: nullableText(row.author_note),
          emoji: nullableText(row.emoji),
          tags: validateTags(parseTags(row.tags)),
          is_curated: parseBoolean(row.is_curated),
          is_giveaway: parseBoolean(row.is_giveaway),
        };
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Invalid row.';
        throw new Error(`Row ${rowNumber}: ${message}`);
      }
    }

    function isBlankCsvRow(row: CsvRow) {
      return Object.values(row).every((value) => cleanText(value) === '');
    }

    async function insertEvents(records: AdminEventRecord[]) {
      if (!adminSupabase) {
        throw new Error('Unlock the admin portal first.');
      }

      const { error } = await adminSupabase.from('events').insert(records);
      if (error) throw new Error(error.message);
    }

    /* ---------- Community submissions review ---------- */
    type SubmissionRow = Record<string, any>;

    function setSubmissionsStatus(message: string) {
      if (submissionsStatus) submissionsStatus.textContent = message;
    }

    function updateSubmissionsCount() {
      if (!submissionsCount || !submissionsList) return;
      const count = submissionsList.querySelectorAll('[data-submission-card]').length;
      submissionsCount.textContent = count > 0 ? `(${count} pending)` : '';
    }

    function cardField(card: HTMLElement, name: string) {
      return card.querySelector(`[data-field="${name}"]`) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
    }

    function cardFieldValue(card: HTMLElement, name: string) {
      return cardField(card, name)?.value ?? '';
    }

    function cardFieldChecked(card: HTMLElement, name: string) {
      const el = card.querySelector(`[data-field="${name}"]`) as HTMLInputElement | null;
      return Boolean(el?.checked);
    }

    function setDisplay(card: HTMLElement, name: string, value: string) {
      const el = card.querySelector(`[data-display="${name}"]`);
      if (el) el.textContent = value;
    }

    function setFieldValue(card: HTMLElement, name: string, value: string) {
      const el = cardField(card, name);
      if (el) el.value = value;
    }

    function setFieldChecked(card: HTMLElement, name: string, checked: boolean) {
      const el = card.querySelector(`[data-field="${name}"]`) as HTMLInputElement | null;
      if (el) el.checked = checked;
    }

    function formatSubmittedAt(value: unknown) {
      const raw = cleanText(value);
      if (!raw) return '';
      const date = new Date(raw);
      if (Number.isNaN(date.getTime())) return '';
      return `Submitted ${date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;
    }

    function cardTags(card: HTMLElement) {
      const checked = Array.from(
        card.querySelectorAll('[data-tag-option]:checked')
      ) as HTMLInputElement[];
      const tags = checked.map((el) => cleanText(el.value)).filter(Boolean);
      return tags.length > 0 ? tags : null;
    }

    function eventRecordFromCard(card: HTMLElement) {
      return {
        title: requiredText(cardFieldValue(card, 'title'), 'title'),
        event_date: requiredDate(cardFieldValue(card, 'event_date')),
        venue: requiredText(cardFieldValue(card, 'venue'), 'venue'),
        start_time: normalizeTimeOfDay(cardFieldValue(card, 'start_time'), 'start_time'),
        end_time: normalizeTimeOfDay(cardFieldValue(card, 'end_time'), 'end_time'),
        neighborhood: nullableText(cardFieldValue(card, 'neighborhood')),
        organizer: nullableText(cardFieldValue(card, 'organizer')),
        cost_info: nullableText(cardFieldValue(card, 'cost_info')),
        event_url: normalizeUrl(cardFieldValue(card, 'event_url')),
        image_url: normalizeUrl(cardFieldValue(card, 'image_url'), 'image_url'),
        description: nullableText(cardFieldValue(card, 'description')),
        author_note: nullableText(cardFieldValue(card, 'author_note')),
        emoji: nullableText(cardFieldValue(card, 'emoji')),
        tags: validateTags(cardTags(card)),
        is_curated: cardFieldChecked(card, 'is_curated'),
        is_giveaway: cardFieldChecked(card, 'is_giveaway'),
      };
    }

    function removeCard(card: HTMLElement) {
      card.remove();
      updateSubmissionsCount();
      if (
        submissionsList &&
        submissionsList.querySelectorAll('[data-submission-card]').length === 0
      ) {
        setSubmissionsStatus('No pending submissions right now.');
      }
    }

    function cardButtons(card: HTMLElement) {
      return {
        approve: card.querySelector('[data-approve]') as HTMLButtonElement | null,
        reject: card.querySelector('[data-reject]') as HTMLButtonElement | null,
        retry: card.querySelector('[data-retry-approved]') as HTMLButtonElement | null,
      };
    }

    // Marks the submission row reviewed after its event was published. Split out
    // so the Retry button can re-run just this step if it fails the first time.
    async function markSubmissionApproved(id: string, eventId: string) {
      if (!adminSupabase) throw new Error('Unlock the admin portal first.');
      const { error } = await adminSupabase
        .from('event_submissions')
        .update({
          status: 'approved',
          reviewed_at: new Date().toISOString(),
          approved_event_id: eventId,
        })
        .eq('id', id);
      if (error) throw new Error(error.message);
    }

    async function approveSubmission(card: HTMLElement, id: string, statusEl: HTMLElement | null) {
      if (!adminSupabase) return;
      const { approve, reject, retry } = cardButtons(card);
      if (approve?.disabled) return;
      if (approve) approve.disabled = true;
      if (reject) reject.disabled = true;
      try {
        if (statusEl) statusEl.textContent = 'Publishing...';
        const record = eventRecordFromCard(card);
        const { data, error } = await adminSupabase
          .from('events')
          .insert(record)
          .select('id')
          .single();
        if (error) throw new Error(error.message);
        if (!data) throw new Error('Could not read the new event id.');

        try {
          await markSubmissionApproved(id, String(data.id));
        } catch (_) {
          // The event IS live; only the bookkeeping failed. Keep Approve disabled
          // (a second click would publish a duplicate) and offer a retry.
          if (statusEl) {
            statusEl.textContent =
              'Event published, but marking the submission reviewed failed. Use "Retry marking reviewed" so it leaves this queue.';
          }
          if (retry) {
            retry.hidden = false;
            retry.onclick = () => {
              void withBusy(retry, 'Retrying...', async () => {
                try {
                  await markSubmissionApproved(id, String(data.id));
                  removeCard(card);
                } catch (retryError) {
                  const message =
                    retryError instanceof Error ? retryError.message : 'Still failing.';
                  if (statusEl) statusEl.textContent = `Still failing: ${message}`;
                }
              });
            };
          }
          return;
        }
        removeCard(card);
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Could not approve this submission.';
        if (statusEl) statusEl.textContent = message;
        if (approve) approve.disabled = false;
        if (reject) reject.disabled = false;
      }
    }

    async function rejectSubmission(card: HTMLElement, id: string, statusEl: HTMLElement | null) {
      if (!adminSupabase) return;
      if (!window.confirm('Reject this submission? It will not be published.')) return;
      const { approve, reject } = cardButtons(card);
      if (approve) approve.disabled = true;
      if (reject) reject.disabled = true;
      try {
        if (statusEl) statusEl.textContent = 'Rejecting...';
        const { error } = await adminSupabase
          .from('event_submissions')
          .update({ status: 'rejected', reviewed_at: new Date().toISOString() })
          .eq('id', id);
        if (error) throw new Error(error.message);
        removeCard(card);
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Could not reject this submission.';
        if (statusEl) statusEl.textContent = message;
        if (approve) approve.disabled = false;
        if (reject) reject.disabled = false;
      }
    }

    function buildSubmissionCard(submission: SubmissionRow) {
      if (!submissionTemplate) return null;
      const fragment = submissionTemplate.content.cloneNode(true) as DocumentFragment;
      const card = fragment.querySelector('[data-submission-card]') as HTMLElement | null;
      if (!card) return null;

      setDisplay(card, 'submitter_name', cleanText(submission.submitter_name) || 'Anonymous');
      setDisplay(card, 'submitter_email', cleanText(submission.submitter_email) || 'No email provided');
      setDisplay(card, 'created_at', formatSubmittedAt(submission.created_at));
      setDisplay(card, 'location_type', cleanText(submission.location_type));

      const rawParts = [submission.address, submission.chicago_neighborhood, submission.suburb]
        .map((value) => cleanText(value))
        .filter(Boolean);
      const rawWrap = card.querySelector('[data-raw-location]') as HTMLElement | null;
      if (rawWrap && rawParts.length > 0) {
        rawWrap.hidden = false;
        setDisplay(card, 'raw_location', rawParts.join(' · '));
      }

      setFieldValue(card, 'title', cleanText(submission.title));
      setFieldValue(card, 'event_date', cleanText(submission.event_date));
      setFieldValue(card, 'start_time', cleanText(submission.start_time).slice(0, 5));
      setFieldValue(card, 'end_time', cleanText(submission.end_time).slice(0, 5));
      setFieldValue(card, 'venue', cleanText(submission.venue));
      setFieldValue(card, 'neighborhood', cleanText(submission.neighborhood));
      setFieldValue(card, 'organizer', cleanText(submission.organizer));
      setFieldValue(card, 'cost_info', cleanText(submission.cost_info));
      setFieldValue(card, 'event_url', cleanText(submission.event_url));
      setFieldValue(card, 'image_url', cleanText(submission.image_url));
      setFieldValue(card, 'emoji', cleanText(submission.emoji));
      setFieldValue(card, 'description', cleanText(submission.description));
      setFieldValue(card, 'author_note', cleanText(submission.author_note));
      setFieldChecked(card, 'is_curated', Boolean(submission.is_curated));
      setFieldChecked(card, 'is_giveaway', Boolean(submission.is_giveaway));

      // Check the taxonomy boxes matching the submitted tags.
      const submittedTags = Array.isArray(submission.tags)
        ? submission.tags.map((tag: unknown) => cleanText(tag).toLowerCase())
        : [];
      (card.querySelectorAll('[data-tag-option]') as NodeListOf<HTMLInputElement>).forEach((el) => {
        el.checked = submittedTags.includes(el.value.toLowerCase());
      });

      // Photo preview: only http(s) URLs, hide the image (keep the link) if it 404s.
      const photoUrl = cleanText(submission.image_url);
      const photoWrap = card.querySelector('[data-photo-wrap]') as HTMLElement | null;
      const photo = card.querySelector('[data-photo]') as HTMLImageElement | null;
      const photoLink = card.querySelector('[data-photo-link]') as HTMLAnchorElement | null;
      if (photoWrap && photo && photoLink && /^https?:\/\//i.test(photoUrl)) {
        photoWrap.hidden = false;
        photoLink.href = photoUrl;
        photo.addEventListener('error', () => {
          photo.hidden = true;
        });
        photo.src = photoUrl;
      }

      const cardStatus = card.querySelector('[data-card-status]') as HTMLElement | null;
      card.querySelector('[data-approve]')?.addEventListener('click', () => {
        void approveSubmission(card, String(submission.id), cardStatus);
      });
      card.querySelector('[data-reject]')?.addEventListener('click', () => {
        void rejectSubmission(card, String(submission.id), cardStatus);
      });

      return card;
    }

    // In-flight guard: overlapping loads would each append a full copy of the
    // queue (duplicate cards mean a submission could be approved twice).
    let submissionsLoading = false;

    async function loadSubmissions() {
      if (!adminSupabase || !submissionsList || submissionsLoading) return;
      submissionsLoading = true;
      setSubmissionsStatus('Loading submissions...');
      try {
        const { data, error } = await adminSupabase
          .from('event_submissions')
          .select('*')
          .eq('status', 'pending')
          .order('created_at', { ascending: true });
        if (error) throw new Error(error.message);

        const rows = (data ?? []) as SubmissionRow[];
        // Clear only after the fetch resolves so a failed load keeps the
        // current cards instead of blanking the queue.
        submissionsList.innerHTML = '';
        rows.forEach((submission) => {
          const card = buildSubmissionCard(submission);
          if (card) submissionsList.appendChild(card);
        });
        updateSubmissionsCount();
        setSubmissionsStatus(rows.length === 0 ? 'No pending submissions right now.' : '');
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Could not load submissions.';
        setSubmissionsStatus(message);
      } finally {
        submissionsLoading = false;
      }
    }

    refreshSubmissionsButton?.addEventListener('click', () => {
      void loadSubmissions();
    });

    /* ---------- Database manager ---------- */
    type DbEventRow = AdminEventRecord & { id: string };

    function chicagoToday() {
      return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(new Date());
    }

    function dbScopeValue() {
      return dbScopeSelect?.value === 'all' ? 'all' : 'upcoming';
    }

    // Returns a 12-hour clock label, or an empty string when the value is not a
    // usable HH:MM time.
    function formatClockTime(timeStr: string | null) {
      const clean = (timeStr ?? '').slice(0, 5);
      if (!/^\d{2}:\d{2}$/.test(clean)) return '';
      const [hour, minute] = clean.split(':').map(Number);
      const hour12 = ((hour + 11) % 12) + 1;
      return `${hour12}:${String(minute).padStart(2, '0')} ${hour < 12 ? 'AM' : 'PM'}`;
    }

    // An end time only appears alongside a start time: "9:00 PM" on its own
    // would read as the moment the event begins.
    function formatRowDate(dateStr: string, timeStr: string | null, endTimeStr: string | null = null) {
      const date = new Date(`${dateStr}T12:00:00`);
      let label = Number.isNaN(date.getTime())
        ? dateStr
        : date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
      const start = formatClockTime(timeStr);
      if (start) {
        const end = formatClockTime(endTimeStr);
        label += ` · ${start}${end ? ` to ${end}` : ''}`;
      }
      return label;
    }

    // A realtime change that arrives while a row editor is open waits here so
    // the re-render cannot wipe unsaved edits.
    let dbPendingReload = false;
    // Generation counter: with overlapping loads (realtime + scope change +
    // refresh), only the newest response may write the list.
    let dbLoadGeneration = 0;

    function dbEditorOpen() {
      return Boolean(dbList?.querySelector('[data-row-editor]:not([hidden])'));
    }

    function runPendingDbReload() {
      if (dbPendingReload && !dbEditorOpen()) {
        void loadDbEvents();
      }
    }

    async function loadDbEvents() {
      if (!adminSupabase || !dbList) return;
      dbPendingReload = false;
      const generation = ++dbLoadGeneration;
      setInlineStatus(dbStatus, 'Loading events...');
      try {
        let query = adminSupabase
          .from('events')
          .select('*')
          .order('event_date', { ascending: true })
          .order('start_time', { ascending: true, nullsFirst: false })
          .order('title', { ascending: true });
        if (dbScopeValue() === 'upcoming') {
          query = query.gte('event_date', chicagoToday());
        }
        const { data, error } = await query;
        if (generation !== dbLoadGeneration) return;
        if (error) throw new Error(error.message);
        dbEvents = (data ?? []) as DbEventRow[];
        renderDbList();
      } catch (error) {
        if (generation !== dbLoadGeneration) return;
        const message = error instanceof Error ? error.message : 'Unknown error.';
        setInlineStatus(dbStatus, `Could not load events: ${message}`, true);
      }
    }

    function matchesDbSearch(row: DbEventRow, needle: string) {
      if (!needle) return true;
      return [
        row.title,
        row.venue,
        row.organizer,
        row.neighborhood,
        row.description,
        (row.tags ?? []).join(' '),
      ]
        .map((value) => (value ?? '').toString().toLowerCase())
        .join(' ')
        .includes(needle);
    }

    function renderDbList() {
      if (!dbList || !eventRowTemplate) return;
      const needle = cleanText(dbSearch?.value).toLowerCase();
      const rows = dbEvents.filter((row) => matchesDbSearch(row, needle));
      const today = chicagoToday();
      dbList.innerHTML = '';
      rows.forEach((row) => {
        const card = buildEventRow(row, today);
        if (card) dbList.appendChild(card);
      });
      if (dbCount) {
        const scopeLabel = dbScopeValue() === 'upcoming' ? 'upcoming' : 'total';
        dbCount.textContent = needle
          ? `(${rows.length} of ${dbEvents.length} ${scopeLabel})`
          : `(${dbEvents.length} ${scopeLabel})`;
      }
      if (rows.length === 0) {
        setInlineStatus(
          dbStatus,
          dbEvents.length === 0 ? 'No events in this view.' : 'No events match the search.'
        );
      } else {
        setInlineStatus(dbStatus, '');
      }
    }

    function fillRowEditor(editor: HTMLFormElement, row: DbEventRow) {
      const setValue = (name: string, value: string) => {
        const el = editor.querySelector(`[name="${name}"]`) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | null;
        if (el) el.value = value;
      };
      setValue('title', row.title ?? '');
      setValue('event_date', row.event_date ?? '');
      setValue('venue', row.venue ?? '');
      setValue('start_time', (row.start_time ?? '').slice(0, 5));
      setValue('end_time', (row.end_time ?? '').slice(0, 5));
      setValue('neighborhood', row.neighborhood ?? '');
      setValue('organizer', row.organizer ?? '');
      setValue('cost_info', row.cost_info ?? '');
      setValue('event_url', row.event_url ?? '');
      setValue('image_url', row.image_url ?? '');
      setValue('emoji', row.emoji ?? '');
      setValue('description', row.description ?? '');
      setValue('author_note', row.author_note ?? '');
      const rowTags = (row.tags ?? []).map((tag) => tag.toLowerCase());
      (editor.querySelectorAll('input[name="tags"]') as NodeListOf<HTMLInputElement>).forEach((el) => {
        el.checked = rowTags.includes(el.value.toLowerCase());
      });
      const setChecked = (name: string, checked: boolean) => {
        const el = editor.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
        if (el) el.checked = checked;
      };
      setChecked('is_curated', Boolean(row.is_curated));
      setChecked('is_giveaway', Boolean(row.is_giveaway));
    }

    function buildEventRow(row: DbEventRow, today: string) {
      if (!eventRowTemplate) return null;
      const fragment = eventRowTemplate.content.cloneNode(true) as DocumentFragment;
      const card = fragment.querySelector('[data-event-row]') as HTMLElement | null;
      if (!card) return null;

      const setText = (name: string, value: string) => {
        const el = card.querySelector(`[data-row-${name}]`);
        if (el) el.textContent = value;
      };
      setText('date', formatRowDate(row.event_date, row.start_time, row.end_time));
      setText('title', row.title ?? '');
      setText('emoji', row.emoji ?? '');
      setText('venue', row.venue ?? '');
      setText(
        'meta',
        [
          ...(row.tags ?? []),
          row.is_curated ? "Conductor's pick" : '',
          row.is_giveaway ? 'Giveaway' : '',
        ]
          .filter(Boolean)
          .join(' · ')
      );
      if (row.event_date < today) card.classList.add('opacity-60');

      const editor = card.querySelector('[data-row-editor]') as HTMLFormElement | null;
      const editButton = card.querySelector('[data-row-edit]') as HTMLButtonElement | null;
      const deleteButton = card.querySelector('[data-row-delete]') as HTMLButtonElement | null;
      const cancelButton = card.querySelector('[data-row-cancel]') as HTMLButtonElement | null;
      const saveButton = card.querySelector('[data-row-save]') as HTMLButtonElement | null;
      const rowStatus = card.querySelector('[data-row-status]') as HTMLElement | null;

      editButton?.setAttribute('aria-label', `Edit ${row.title}`);
      deleteButton?.setAttribute('aria-label', `Delete ${row.title}`);

      editButton?.addEventListener('click', () => {
        if (!editor) return;
        if (!editor.hidden) {
          editor.hidden = true;
          runPendingDbReload();
          return;
        }
        fillRowEditor(editor, row);
        if (rowStatus) rowStatus.textContent = '';
        editor.hidden = false;
      });

      cancelButton?.addEventListener('click', () => {
        if (editor) editor.hidden = true;
        if (rowStatus) rowStatus.textContent = '';
        runPendingDbReload();
      });

      editor?.addEventListener('submit', (event) => {
        event.preventDefault();
        void withBusy(saveButton, 'Saving...', async () => {
          try {
            if (!adminSupabase) throw new Error('Unlock the admin portal first.');
            setInlineStatus(rowStatus, '');
            const record = recordFromForm(editor);
            // .select() so a silent zero-row update (stale password, deleted
            // row) surfaces as an error instead of a fake success.
            const { data, error } = await adminSupabase
              .from('events')
              .update(record)
              .eq('id', row.id)
              .select('id');
            if (error) throw new Error(error.message);
            if (!data || data.length === 0) {
              throw new Error('The database rejected the change. Lock the portal, unlock it again, and retry.');
            }
            setInlineStatus(
              dbPublishStatus,
              `Saved "${record.title}". It is in the database now; press Publish live site to show it publicly, or wait for the scheduled rebuild.`
            );
            dbPublishStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            await loadDbEvents();
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Unknown error.';
            setInlineStatus(rowStatus, `Could not save: ${message}`, true);
          }
        });
      });

      deleteButton?.addEventListener('click', () => {
        if (
          !window.confirm(
            `Delete "${row.title}" from the database? This cannot be undone. The public page keeps showing it until the next publish.`
          )
        )
          return;
        void withBusy(deleteButton, 'Deleting...', async () => {
          try {
            if (!adminSupabase) throw new Error('Unlock the admin portal first.');
            const { data, error } = await adminSupabase
              .from('events')
              .delete()
              .eq('id', row.id)
              .select('id');
            if (error) throw new Error(error.message);
            if (!data || data.length === 0) {
              throw new Error('The database rejected the delete. Lock the portal, unlock it again, and retry.');
            }
            setInlineStatus(
              dbPublishStatus,
              `Deleted "${row.title}". Press Publish live site to update the public page, or wait for the scheduled rebuild.`
            );
            dbPublishStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            await loadDbEvents();
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Unknown error.';
            setInlineStatus(dbPublishStatus, `Could not delete: ${message}`, true);
          }
        });
      });

      return card;
    }

    function teardownDbRealtime() {
      if (dbChannel) {
        void dbChannel.unsubscribe();
        dbChannel = null;
      }
      clearTimeout(dbReloadTimer);
      if (dbLive) dbLive.textContent = 'Live updates: off';
    }

    function subscribeDbRealtime() {
      if (!adminSupabase) return;
      teardownDbRealtime();
      if (dbLive) dbLive.textContent = 'Live updates: connecting...';
      dbChannel = adminSupabase
        .channel('admin-events-db')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'events' }, () => {
          // Debounced: a CSV import fires one change per row.
          clearTimeout(dbReloadTimer);
          dbReloadTimer = setTimeout(() => {
            if (dbEditorOpen()) {
              // Re-rendering now would destroy the open editor's unsaved
              // edits. Reload once it closes.
              dbPendingReload = true;
              setInlineStatus(
                dbStatus,
                'The schedule changed elsewhere. It will refresh when you close the open editor.'
              );
              return;
            }
            void loadDbEvents();
          }, 400);
        })
        .subscribe((status) => {
          if (!dbLive) return;
          dbLive.textContent =
            status === 'SUBSCRIBED' ? 'Live updates: on' : 'Live updates: reconnecting...';
        });
    }

    dbScopeSelect?.addEventListener('change', () => {
      void loadDbEvents();
    });
    dbSearch?.addEventListener('input', () => {
      renderDbList();
    });
    dbRefresh?.addEventListener('click', () => {
      void loadDbEvents();
    });

    dbPublish?.addEventListener('click', () => {
      void withBusy(dbPublish, 'Publishing...', async () => {
        try {
          setInlineStatus(dbPublishStatus, '');
          const res = await fetch(`${functionsBase}/trigger-deploy`, {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-admin-password': adminPassword },
            body: '{}',
          });
          const payload = await res.json().catch(() => null);
          if (!res.ok) throw new Error(payload?.error ?? `Publish failed (status ${res.status}).`);
          setInlineStatus(dbPublishStatus, payload?.message ?? 'Site rebuild started.');
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Unknown error.';
          setInlineStatus(dbPublishStatus, message, true);
        }
      });
    });

    /* ---------- Flyer scanner (Gemini) ---------- */

    function setScanQuota(quota: { remaining?: unknown; limit?: unknown } | null | undefined) {
      if (!scanQuota) return;
      if (!quota || typeof quota.remaining !== 'number' || typeof quota.limit !== 'number') {
        scanQuota.textContent = 'Scan counter unavailable';
        return;
      }
      scanQuota.textContent = `${quota.remaining} of ${quota.limit} scans left today`;
    }

    async function refreshScanQuota() {
      if (!scanQuota) return;
      scanQuota.textContent = "Checking today's scans...";
      try {
        const res = await fetch(`${functionsBase}/parse-event-image`, {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-admin-password': adminPassword },
          body: JSON.stringify({ action: 'status' }),
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok) throw new Error(payload?.error ?? 'Status check failed.');
        setScanQuota(payload?.quota);
      } catch (_) {
        scanQuota.textContent = 'Scan counter unavailable';
      }
    }

    function clearScanPreview() {
      if (scanPreviewUrl) {
        URL.revokeObjectURL(scanPreviewUrl);
        scanPreviewUrl = null;
      }
      if (scanPreviewWrap) scanPreviewWrap.hidden = true;
      if (scanPreview) scanPreview.removeAttribute('src');
    }

    // Downscale in the browser so uploads stay small for the edge function and
    // Gemini. Falls back to the original bytes for formats canvas cannot
    // decode (HEIC outside Safari); the server enforces its own size cap.
    async function imageFileToPayload(file: File): Promise<{ data: string; mime: string }> {
      try {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const context = canvas.getContext('2d');
        if (!context) throw new Error('Canvas unavailable.');
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
        const data = dataUrl.split(',')[1] ?? '';
        if (!data) throw new Error('Could not encode the image.');
        return { data, mime: 'image/jpeg' };
      } catch (_) {
        const buffer = await file.arrayBuffer();
        const bytes = new Uint8Array(buffer);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < bytes.length; i += chunk) {
          binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
        }
        return { data: btoa(binary), mime: file.type || 'image/jpeg' };
      }
    }

    function prefillSingleForm(eventDraft: Record<string, unknown>) {
      if (!singleEventForm) return;
      const setValue = (name: string, value: unknown) => {
        const el = singleEventForm.querySelector(
          `input[name="${name}"]:not([type="checkbox"]), textarea[name="${name}"]`
        ) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = typeof value === 'string' ? value : '';
      };
      setValue('title', eventDraft.title);
      setValue('event_date', eventDraft.event_date);
      setValue('venue', eventDraft.venue);
      setValue('start_time', eventDraft.start_time);
      // The scanner may not return an end_time yet; setValue blanks the field
      // for anything that is not a string, so an absent key is safe.
      setValue('end_time', eventDraft.end_time);
      setValue('neighborhood', eventDraft.neighborhood);
      setValue('organizer', eventDraft.organizer);
      setValue('cost_info', eventDraft.cost_info);
      setValue('event_url', eventDraft.event_url);
      setValue('image_url', '');
      setValue('description', eventDraft.description);
      setValue('author_note', '');
      setValue('emoji', eventDraft.emoji);
      const draftTags = Array.isArray(eventDraft.tags)
        ? eventDraft.tags.map((tag) => cleanText(tag).toLowerCase())
        : [];
      (singleEventForm.querySelectorAll('input[name="tags"]') as NodeListOf<HTMLInputElement>).forEach(
        (el) => {
          el.checked = draftTags.includes(el.value.toLowerCase());
        }
      );
      const setChecked = (name: string, checked: boolean) => {
        const el = singleEventForm.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
        if (el) el.checked = checked;
      };
      setChecked('is_giveaway', eventDraft.is_giveaway === true);
      setChecked('is_curated', false);
    }

    scanFile?.addEventListener('change', () => {
      clearScanPreview();
      const file = scanFile.files?.[0];
      if (file && scanPreview && scanPreviewWrap) {
        scanPreviewUrl = URL.createObjectURL(file);
        scanPreview.src = scanPreviewUrl;
        scanPreviewWrap.hidden = false;
      }
      if (scanStatus) scanStatus.textContent = '';
    });

    scanForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const file = scanFile?.files?.[0];
      if (!file) {
        setInlineStatus(scanStatus, 'Choose a flyer photo first.', true);
        return;
      }
      void withBusy(scanSubmit, 'Scanning...', async () => {
        try {
          setInlineStatus(scanStatus, 'Reading the flyer with Gemini...');
          const payload = await imageFileToPayload(file);
          const res = await fetch(`${functionsBase}/parse-event-image`, {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-admin-password': adminPassword },
            body: JSON.stringify({
              action: 'parse',
              mime_type: payload.mime,
              image_base64: payload.data,
            }),
          });
          const body = await res.json().catch(() => null);
          if (body?.quota) setScanQuota(body.quota);
          if (!res.ok) throw new Error(body?.error ?? `Scan failed (status ${res.status}).`);
          prefillSingleForm(body?.event ?? {});
          const note = cleanText(body?.event?.scan_notes);
          setInlineStatus(
            scanStatus,
            `Draft loaded into the Add one event form. Review every field, then press Add event.${
              note ? ` Scanner note: ${note}` : ''
            }`
          );
          singleEventForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Unknown error.';
          setInlineStatus(scanStatus, message, true);
        }
      });
    });

    passwordForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void withBusy(loginSubmit, 'Checking...', async () => {
        const formData = new FormData(passwordForm);
        const password = cleanText(formData.get('password'));
        setInlineStatus(loginStatus, '');

        try {
          const client = createAdminClient(password);
          // Verify against the database before unlocking, so a typo is caught
          // here instead of surfacing as an empty queue or a failed insert.
          const { data, error } = await client.rpc('events_admin_login_check');
          if (error) throw new Error(error.message);
          if (data !== true) {
            setInlineStatus(loginStatus, 'Wrong password. Try again.', true);
            return;
          }
          adminSupabase = client;
          adminPassword = password;
          passwordForm.reset();
          setUnlocked(true);
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Unknown error.';
          setInlineStatus(loginStatus, `Could not unlock the portal: ${message}`, true);
        }
      });
    });

    logoutButton?.addEventListener('click', () => {
      adminSupabase = null;
      adminPassword = '';
      setUnlocked(false);
    });

    singleEventForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void withBusy(singleSubmit, 'Saving...', async () => {
        try {
          setInlineStatus(singleStatus, '');
          const missing = missingRequiredLabels(singleEventForm);
          if (missing.length > 0) {
            setInlineStatus(
              singleStatus,
              `Still needed before this event can board: ${missing.join(', ')}.`,
              true
            );
            return;
          }
          const record = recordFromForm(singleEventForm);
          await insertEvents([record]);
          singleEventForm.reset();
          setSingleSuccessBanner(record.title);
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Unknown error.';
          setInlineStatus(singleStatus, `Could not add event: ${message}`, true);
        }
      });
    });

    function setCsvErrors(lines: string[]) {
      if (!csvStatus) return;
      csvStatus.textContent = '';
      csvStatus.classList.add('text-cayenne');
      csvStatus.classList.remove('text-darkWalnut');
      const intro = document.createElement('p');
      intro.textContent =
        lines.length === 1 ? 'Fix this row and upload again:' : `Fix these ${lines.length} rows and upload again:`;
      csvStatus.appendChild(intro);
      const list = document.createElement('ul');
      list.className = 'mt-2 list-disc space-y-1 pl-5 font-normal';
      lines.forEach((line) => {
        const item = document.createElement('li');
        item.textContent = line;
        list.appendChild(item);
      });
      csvStatus.appendChild(list);
    }

    csvForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const file = csvFileInput?.files?.[0];

      if (!file) {
        setInlineStatus(csvStatus, 'Choose a CSV file first.', true);
        return;
      }

      void withBusy(csvSubmit, 'Uploading...', () =>
        new Promise<void>((resolve) => {
          setInlineStatus(csvStatus, '');
          Papa.parse<CsvRow>(file, {
            header: true,
            skipEmptyLines: 'greedy',
            transformHeader: (header) => header.trim().toLowerCase(),
            complete: (results) => {
              void (async () => {
                try {
                  // Row numbers everywhere are spreadsheet rows: header is row 1,
                  // first data row is row 2. Papa reports 0-based data indexes.
                  const problems: string[] = [];
                  results.errors.forEach((parseError) => {
                    const rowNumber =
                      typeof parseError.row === 'number' ? parseError.row + 2 : 'unknown';
                    problems.push(`Row ${rowNumber}: ${parseError.message}`);
                  });

                  const records: AdminEventRecord[] = [];
                  results.data.forEach((row, index) => {
                    if (isBlankCsvRow(row)) return;
                    try {
                      records.push(recordFromCsvRow(row, index + 2));
                    } catch (rowError) {
                      problems.push(
                        rowError instanceof Error ? rowError.message : `Row ${index + 2}: invalid row.`
                      );
                    }
                  });

                  if (problems.length > 0) {
                    setCsvErrors(problems);
                    return;
                  }
                  if (records.length === 0) {
                    setInlineStatus(csvStatus, 'No event rows found in the CSV.', true);
                    return;
                  }

                  await insertEvents(records);
                  csvForm.reset();
                  setInlineStatus(
                    csvStatus,
                    `${records.length} ${records.length === 1 ? 'event' : 'events'} added. Press Publish live site in the schedule section to show them publicly now, or wait for the scheduled rebuild.`
                  );
                } catch (error) {
                  const message = error instanceof Error ? error.message : 'Unknown error.';
                  setInlineStatus(csvStatus, `Could not upload CSV: ${message}`, true);
                } finally {
                  resolve();
                }
              })();
            },
            error: (error) => {
              setInlineStatus(csvStatus, `Could not read CSV: ${error.message}`, true);
              resolve();
            },
          });
        })
      );
    });

    setUnlocked(false);
  }
</script>
