            <label class={labelClass}>
              Emoji<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input name="emoji" type="text" class={inputClass} />
            </label>

            <label class={`${labelClass} md:col-span-2`}>
              Event URL<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input name="event_url" type="url" class={inputClass} />
            </label>

            <label class={`${labelClass} md:col-span-2`}>
              Photo or flyer URL<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
              <input name="image_url" type="url" class={inputClass} />
            </label>

            <fieldset class="md:col-span-2">
              <legend class={labelClass}>
                Community tags<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Pick any that apply</span>
              </legend>
              <div class="mt-2 flex flex-wrap gap-2">
                {DIASPORA_TAGS.map((tag) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut has-[:checked]:bg-amber">
                    <input name="tags" value={tag} type="checkbox" class="h-4 w-4 accent-cayenne" />
                    {tag}
                  </label>
                ))}
