---
import Layout from '../../layouts/Layout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import IssueCard from '../../components/IssueCard.astro';
import TransitDivider from '../../components/TransitDivider.astro';
import { getRecentIssues } from '../../lib/issues';
import { formatArchiveCutoff } from '../../lib/archive';

const issues = await getRecentIssues();
// Issues from before the public-archive cutoff (and any premium issue) live on
// the newsletter platform behind its subscriber wall and open there; the
// caption below explains the arrow. See src/lib/archive.ts for the rule.
const offSiteCount = issues.filter((issue) => /^https?:\/\//.test(issue.href)).length;
const archiveCutoff = formatArchiveCutoff();

const description =
  'Read The Brown Line newsletter: weekly dispatches on Chicago Global South diaspora events, arts, culture, community, and media. Subscribe free and ride along.';
---
<Layout title="Newsletter | The Brown Line: Chicago Global South Diaspora Media" description={description}>
  {/* ---------- Hero + subscribe ---------- */}
  <section id="subscribe" class="px-6 pt-16 md:pt-24 pb-12">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-body uppercase text-xs md:text-sm tracking-[0.3em] text-cayenneInk font-bold mb-6">
        The newsletter
      </p>
      <h1 class="font-heading text-darkWalnut text-4xl md:text-6xl leading-[1.02] tracking-tight text-balance">
        One stop a week in your inbox.
      </h1>
      <p class="font-body text-darkWalnut/85 text-lg md:text-xl mt-8 leading-relaxed">
        Arts, culture, and community from the corners of Chicago you actually want to know. Free,
        always.
      </p>
      <div class="mt-10 flex justify-center">
        <SubscribeForm caption="" />
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6">
    <TransitDivider />
  </div>

  {/* ---------- All dispatches: every issue, on-site pages first ---------- */}
  <section class="px-6 py-16 md:py-24">
    <div class="max-w-5xl mx-auto">
      <div class="mb-12">
        <h2 class="font-heading font-semibold text-darkWalnut text-4xl md:text-[2.5rem] tracking-tight leading-none">
          All dispatches
        </h2>
        {offSiteCount > 0 && (
          <p class="font-body text-darkWalnut/70 text-sm mt-3">
            Every issue, newest first. Issues from before {archiveCutoff} are in the subscriber
            archive and open in a new tab.
          </p>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {issues.map((issue, i) => (
          <div class:list={[i === 0 ? 'md:col-span-2' : '']}>
            <IssueCard
              category={issue.category}
              date={issue.date}
              datetime={issue.publishedAt ? new Date(issue.publishedAt).toISOString().slice(0, 10) : undefined}
              title={issue.title}
              href={issue.href}
              accent={issue.accent as 'amber' | 'cayenne'}
              featured={i === 0}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
