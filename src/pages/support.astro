---
// Support now lives on the About page (/about#support). This stub keeps the
// old URL working for bookmarks, old newsletters, and search results.
const target = `${import.meta.env.BASE_URL}about#support`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).toString()} />
    <title>Support · The Brown Line</title>
  </head>
  <body>
    <p>This page has moved. <a href={target}>Continue to Support The Brown Line</a>.</p>
  </body>
</html>
