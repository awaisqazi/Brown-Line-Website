---
// Brand-styled single-date calendar used by the events filter.
// `inline` renders the calendar open-in-place (for the floating panel);
// otherwise it renders a trigger button that toggles a popover.
interface Props {
  inline?: boolean;
}

const { inline = false } = Astro.props;

const navButtonClass =
  'inline-flex h-8 w-8 shrink-0 items-center justify-center border-2 border-darkWalnut bg-seashell font-body text-lg font-bold leading-none text-darkWalnut transition-colors hover:bg-darkWalnut hover:text-seashell focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue';
---

<div class="relative" data-calendar data-calendar-inline={inline ? 'true' : 'false'}>
  {!inline && (
    <button
      type="button"
      data-calendar-trigger
      aria-haspopup="dialog"
      aria-expanded="false"
      class="mt-1 flex w-full min-w-0 items-center justify-between gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2.5 font-body text-base font-bold text-darkWalnut transition-colors focus:outline-none focus:ring-2 focus:ring-mayaBlue md:text-sm"
    >
      <span class="truncate"><span class="sr-only">Date: </span><span data-calendar-label>Any date</span></span>
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-4 w-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="4.5" width="18" height="17" rx="1.5" />
        <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
      </svg>
    </button>
  )}

  <div
    data-calendar-popover
    hidden={!inline}
    role="group"
    aria-label="Choose a date"
    class:list={[
      inline
        ? 'mt-1 border-2 border-darkWalnut bg-seashell p-3'
        : 'absolute left-0 z-50 mt-2 w-[min(20rem,calc(100vw-2.5rem))] border-2 border-darkWalnut bg-[#FDFBF7] p-3 shadow-retro',
    ]}
  >
    <div class="flex items-center justify-between gap-2">
      <button type="button" data-calendar-prev aria-label="Previous month" class={navButtonClass}>
        <span aria-hidden="true">&lsaquo;</span>
      </button>
      <span data-calendar-title class="font-heading text-darkWalnut text-xl leading-none">Month</span>
      <button type="button" data-calendar-next aria-label="Next month" class={navButtonClass}>
        <span aria-hidden="true">&rsaquo;</span>
      </button>
    </div>

    <div class="mt-3 grid grid-cols-7 gap-1 text-center font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45">
      <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
    </div>

    <div data-calendar-grid class="mt-1 grid grid-cols-7 gap-1"></div>

    <button
      type="button"
      data-calendar-clear
      class="mt-3 w-full border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut transition-colors hover:bg-darkWalnut hover:text-seashell focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
    >
      Any date
    </button>
  </div>
</div>
