---
import { getChicagoDateString, formatStopDate, formatTimeRange } from '../lib/dates';
import { supabase } from '../lib/supabase';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const MONTH_NAMES = [
  'JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN',
  'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC',
];
const WEEKDAY_LABELS = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const PANEL_WEEKDAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

// Anchored to Chicago time (not the build server's local clock) so the
// widget always matches the "today" used elsewhere on the site.
const todayString = getChicagoDateString();
const [todayYear, todayMonth, todayDay] = todayString.split('-').map(Number);

const firstOfMonth = new Date(Date.UTC(todayYear, todayMonth - 1, 1));
const daysInMonth = new Date(Date.UTC(todayYear, todayMonth, 0)).getUTCDate();
const leadingBlanks = firstOfMonth.getUTCDay();

const pad = (value: number) => String(value).padStart(2, '0');
const toDateString = (date: Date) =>
  `${date.getUTCFullYear()}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;

// Build-time window: a month back (so recently passed days still show context)
// through roughly four months out, which is enough for the panel's month arrows.
const todayUtc = Date.UTC(todayYear, todayMonth - 1, todayDay);
const DAY_MS = 86400000;
const windowStart = toDateString(new Date(todayUtc - 30 * DAY_MS));
const windowEnd = toDateString(new Date(todayUtc + 120 * DAY_MS));

type PanelEvent = {
  date: string;
  title: string;
  venue: string;
  dateLabel: string;
  timeLabel: string;
  blurb: string;
};

const panelEvents: PanelEvent[] = [];
let loadError = false;

try {
  const { data, error } = await supabase
    .from('events')
    .select('event_date, title, venue, start_time, end_time, description')
    .gte('event_date', windowStart)
    .lte('event_date', windowEnd)
    .order('event_date', { ascending: true })
    .order('start_time', { ascending: true, nullsFirst: true });

  if (error) throw error;

  for (const row of data ?? []) {
    const blurb = (row.description ?? '').replace(/\s+/g, ' ').trim();
    panelEvents.push({
      date: row.event_date,
      title: row.title ?? '',
      venue: row.venue ?? '',
      dateLabel: formatStopDate(row.event_date),
      timeLabel: formatTimeRange(row.start_time, row.end_time),
      blurb: blurb.length > 160 ? `${blurb.slice(0, 157)}...` : blurb,
    });
  }
} catch (error) {
  // Never let a Supabase hiccup break the nav; the calendar still renders,
  // just without event dots and with a note in the panel.
  loadError = true;
  console.warn('MiniCalendar: could not load events', error);
}

// Dots on the small calendar come from the same dataset as the panel.
const monthPrefix = `${todayYear}-${pad(todayMonth)}-`;
const eventDays = new Set<number>();
for (const event of panelEvents) {
  if (event.date.startsWith(monthPrefix)) {
    eventDays.add(Number(event.date.slice(8, 10)));
  }
}

type Cell = { day: number | null };
const cells: Cell[] = [];
for (let i = 0; i < leadingBlanks; i++) cells.push({ day: null });
for (let day = 1; day <= daysInMonth; day++) cells.push({ day });
while (cells.length % 7 !== 0) cells.push({ day: null });

const monthLabel = `${MONTH_NAMES[todayMonth - 1]} ${todayYear}`;
const fullMonthLabel = new Date(Date.UTC(todayYear, todayMonth - 1, 1)).toLocaleString('en-US', {
  month: 'long',
  timeZone: 'UTC',
});
const eventsHref = `${import.meta.env.BASE_URL}events`;

// Unique ids so more than one mini calendar could live on a page.
const uid = `mini-cal-${Math.random().toString(36).slice(2, 8)}`;
const buttonId = `${uid}-button`;
const panelId = `${uid}-panel`;

// Month arrows are clamped to the months covered by the fetched window.
const [startYear, startMonth] = windowStart.split('-').map(Number);
const [endYear, endMonth] = windowEnd.split('-').map(Number);
const minMonthIndex = startYear * 12 + (startMonth - 1);
const maxMonthIndex = endYear * 12 + (endMonth - 1);
---

<div class:list={['mini-calendar-wrap relative', className]} data-mini-calendar>
  <button
    type="button"
    id={buttonId}
    aria-expanded="false"
    aria-controls={panelId}
    aria-label={`Open the events calendar for ${fullMonthLabel} ${todayYear}`}
    data-mini-calendar-button
    class="mini-calendar block w-[10.5rem] border-2 border-darkWalnut bg-[#FDFBF7] p-2.5 text-left shadow-[2px_2px_0_#642713] transition-transform duration-150 ease-out hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
  >
    <div class="flex items-baseline justify-between">
      <span class="font-body text-[10px] font-bold uppercase tracking-widest text-cayenne">{monthLabel}</span>
      <span class="font-body text-[8px] font-bold uppercase tracking-widest text-darkWalnut/50">Events &rarr;</span>
    </div>
    <div class="mt-1.5 grid grid-cols-7 gap-y-0.5 text-center">
      {WEEKDAY_LABELS.map((label) => (
        <span class="font-body text-[8px] font-bold uppercase text-darkWalnut/50">{label}</span>
      ))}
      {cells.map((cell) => (
        <span class="relative flex h-4 items-center justify-center">
          {cell.day && (
            <>
              <span
                class:list={[
                  'relative z-10 flex h-3.5 w-3.5 items-center justify-center font-body text-[9px] font-bold',
                  cell.day === todayDay ? 'rounded-full bg-cayenne text-seashell' : 'text-darkWalnut',
                ]}
              >
                {cell.day}
              </span>
              {eventDays.has(cell.day) && (
                <span class="absolute bottom-0 h-[3px] w-[3px] rounded-full bg-amber" aria-hidden="true"></span>
              )}
            </>
          )}
        </span>
      ))}
    </div>
  </button>

  <div
    id={panelId}
    data-mini-calendar-panel
    aria-hidden="true"
    class="mini-cal-panel absolute right-0 top-[calc(100%+0.65rem)] z-50 w-[21rem] border-2 border-darkWalnut bg-[#FDFBF7] p-3.5 shadow-[4px_4px_0_#642713]"
  >
    <div class="flex items-center justify-between gap-2">
      <button
        type="button"
        data-mini-cal-prev
        aria-label="Previous month"
        class="mini-cal-arrow flex h-6 w-6 items-center justify-center border-2 border-darkWalnut bg-seashell font-body text-[11px] font-bold text-darkWalnut focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
      >&lsaquo;</button>
      <span
        data-mini-cal-month
        class="font-body text-[11px] font-bold uppercase tracking-widest text-cayenne"
      >{fullMonthLabel} {todayYear}</span>
      <button
        type="button"
        data-mini-cal-next
        aria-label="Next month"
        class="mini-cal-arrow flex h-6 w-6 items-center justify-center border-2 border-darkWalnut bg-seashell font-body text-[11px] font-bold text-darkWalnut focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
      >&rsaquo;</button>
    </div>

    <div class="mt-3 grid grid-cols-7 text-center">
      {PANEL_WEEKDAY_LABELS.map((label) => (
        <span class="font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/50">{label}</span>
      ))}
    </div>

    <div data-mini-cal-grid class="mt-1 grid grid-cols-7 gap-y-1 text-center"></div>

    {loadError && (
      <p class="mt-3 border-t-2 border-darkWalnut/15 pt-2 font-body text-[11px] text-darkWalnut/60">
        Couldn't load events right now.
      </p>
    )}

    <div data-mini-cal-list class="mt-3 border-t-2 border-darkWalnut/15 pt-2"></div>

    <a
      href={eventsHref}
      class="mt-3 block border-t-2 border-darkWalnut/15 pt-2 font-body text-[10px] font-bold uppercase tracking-widest text-cayenne hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
    >View all events &rarr;</a>
  </div>
</div>

<script
  is:inline
  define:vars={{ uid, panelEvents, todayString, minMonthIndex, maxMonthIndex, eventsHref }}
>
  (() => {
    const root = document.getElementById(`${uid}-button`)?.closest('[data-mini-calendar]');
    if (!root) return;
    const button = root.querySelector('[data-mini-calendar-button]');
    const panel = root.querySelector('[data-mini-calendar-panel]');
    const grid = root.querySelector('[data-mini-cal-grid]');
    const list = root.querySelector('[data-mini-cal-list]');
    const monthEl = root.querySelector('[data-mini-cal-month]');
    const prevBtn = root.querySelector('[data-mini-cal-prev]');
    const nextBtn = root.querySelector('[data-mini-cal-next]');
    if (!button || !panel || !grid || !list || !monthEl || !prevBtn || !nextBtn) return;

    const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const MONTHS_LONG = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December',
    ];

    const pad = (value) => String(value).padStart(2, '0');

    // All date math runs in UTC so the calendar day never drifts by time zone.
    function shiftDate(dateString, days) {
      const [y, m, d] = dateString.split('-').map(Number);
      const next = new Date(Date.UTC(y, m - 1, d + days));
      return `${next.getUTCFullYear()}-${pad(next.getUTCMonth() + 1)}-${pad(next.getUTCDate())}`;
    }

    function shortLabel(dateString) {
      const [y, m, d] = dateString.split('-').map(Number);
      const date = new Date(Date.UTC(y, m - 1, d));
      return `${WEEKDAYS[date.getUTCDay()]}. ${MONTHS_SHORT[m - 1]} ${d}`;
    }

    const byDate = {};
    for (const event of panelEvents) {
      (byDate[event.date] = byDate[event.date] || []).push(event);
    }

    const [todayYear, todayMonth] = todayString.split('-').map(Number);
    let viewIndex = todayYear * 12 + (todayMonth - 1);
    let selected = todayString;

    function renderGrid() {
      const year = Math.floor(viewIndex / 12);
      const month = (viewIndex % 12) + 1;
      monthEl.textContent = `${MONTHS_LONG[month - 1]} ${year}`;
      prevBtn.disabled = viewIndex <= minMonthIndex;
      nextBtn.disabled = viewIndex >= maxMonthIndex;

      const blanks = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();
      const days = new Date(Date.UTC(year, month, 0)).getUTCDate();

      grid.textContent = '';
      for (let i = 0; i < blanks; i++) {
        grid.appendChild(document.createElement('span'));
      }
      for (let day = 1; day <= days; day++) {
        const dateString = `${year}-${pad(month)}-${pad(day)}`;
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.dataset.date = dateString;
        cell.setAttribute('aria-pressed', dateString === selected ? 'true' : 'false');
        cell.className =
          'mini-cal-day relative mx-auto flex h-7 w-7 flex-col items-center justify-center font-body text-[11px] font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue';

        const number = document.createElement('span');
        number.textContent = String(day);
        number.className =
          'flex h-6 w-6 items-center justify-center rounded-full ' +
          (dateString === todayString
            ? 'bg-cayenne text-seashell'
            : dateString === selected
              ? 'bg-amber text-darkWalnut'
              : 'text-darkWalnut');
        cell.appendChild(number);

        if (byDate[dateString]) {
          const dot = document.createElement('span');
          dot.className = 'absolute bottom-0 h-[4px] w-[4px] rounded-full bg-amber';
          dot.setAttribute('aria-hidden', 'true');
          cell.appendChild(dot);
        }

        grid.appendChild(cell);
      }
    }

    function eventRow(event) {
      const row = document.createElement('a');
      // Deep link so the events page preselects this day and jumps to it.
      row.href = `${eventsHref}?date=${event.date}`;
      row.className =
        'mini-cal-event block border-b border-darkWalnut/10 py-1.5 last:border-b-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue';

      const title = document.createElement('span');
      title.className = 'block font-body text-[11px] font-bold leading-snug text-darkWalnut';
      title.textContent = event.title;
      row.appendChild(title);

      const meta = document.createElement('span');
      meta.className = 'block font-body text-[10px] leading-snug text-cayenne';
      meta.textContent = [event.dateLabel, event.timeLabel].filter(Boolean).join(' · ');
      row.appendChild(meta);

      if (event.venue) {
        const venue = document.createElement('span');
        venue.className = 'block font-body text-[10px] leading-snug text-darkWalnut/60';
        venue.textContent = event.venue;
        row.appendChild(venue);
      }

      if (event.blurb) {
        const blurb = document.createElement('span');
        blurb.className = 'mini-cal-blurb block font-body text-[10px] leading-snug text-darkWalnut/50';
        blurb.textContent = event.blurb;
        row.appendChild(blurb);
      }

      return row;
    }

    function renderList() {
      list.textContent = '';

      const heading = document.createElement('p');
      heading.className = 'font-body text-[9px] font-bold uppercase tracking-widest text-darkWalnut/50';
      list.appendChild(heading);

      let rows = byDate[selected] ? byDate[selected].slice() : [];
      if (rows.length) {
        heading.textContent = shortLabel(selected);
      } else {
        // Nothing that day, so pull the closest events within three days either way.
        const nearby = [];
        for (let offset = 1; offset <= 3 && nearby.length < 4; offset++) {
          for (const step of [offset, -offset]) {
            const day = byDate[shiftDate(selected, step)];
            if (day) nearby.push(...day);
          }
        }
        rows = nearby.slice(0, 4);
        heading.textContent = rows.length
          ? `Nothing on ${shortLabel(selected)}. Nearby:`
          : `Nothing on ${shortLabel(selected)}`;
      }

      if (!rows.length) {
        const empty = document.createElement('p');
        empty.className = 'mt-1 font-body text-[10px] text-darkWalnut/50';
        empty.textContent = 'No events within a few days of this date.';
        list.appendChild(empty);
        return;
      }

      const wrap = document.createElement('div');
      wrap.className = 'mt-1 max-h-40 overflow-y-auto';
      for (const event of rows.slice(0, 5)) wrap.appendChild(eventRow(event));
      list.appendChild(wrap);
    }

    grid.addEventListener('click', (event) => {
      const cell = event.target.closest('[data-date]');
      if (!cell) return;
      selected = cell.dataset.date;
      renderGrid();
      renderList();
    });

    prevBtn.addEventListener('click', () => {
      if (viewIndex <= minMonthIndex) return;
      viewIndex -= 1;
      renderGrid();
    });
    nextBtn.addEventListener('click', () => {
      if (viewIndex >= maxMonthIndex) return;
      viewIndex += 1;
      renderGrid();
    });

    function setOpen(open) {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', open ? 'false' : 'true');
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        viewIndex = todayYear * 12 + (todayMonth - 1);
        selected = todayString;
        renderGrid();
        renderList();
      }
    }

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', (event) => {
      if (button.getAttribute('aria-expanded') !== 'true') return;
      // composedPath is captured when the event is dispatched, so it still
      // reports the panel even though picking a day rebuilds (and detaches)
      // the cell that was clicked before this listener runs.
      const path = typeof event.composedPath === 'function' ? event.composedPath() : [];
      const inside = path.length ? path.includes(root) : root.contains(event.target);
      if (!inside) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (button.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      button.focus();
    });

    renderGrid();
    renderList();
  })();
</script>

<style>
  .mini-cal-panel {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 200ms ease, transform 250ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 250ms;
  }

  .mini-cal-panel.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition: opacity 200ms ease, transform 250ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
  }

  .mini-cal-arrow {
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .mini-cal-arrow:not(:disabled):hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 #642713;
  }
  .mini-cal-arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Day cells and event rows are built by the script, so these rules have to
     escape Astro's scoping to reach them. */
  :global(.mini-cal-day) {
    transition: transform 120ms ease;
  }
  :global(.mini-cal-day:hover) {
    transform: scale(1.1);
  }

  :global(.mini-cal-event:hover) {
    background: #FAF1EC;
  }

  /* Keep the description to two tidy lines inside a compact row. */
  :global(.mini-cal-blurb) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-cal-panel,
    .mini-cal-arrow,
    :global(.mini-cal-day) {
      transition: none !important;
    }
  }
</style>
