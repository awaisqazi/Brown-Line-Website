---
interface Props {
  class?: string;
  caption?: string;
}

const {
  class: className = '',
  caption = 'No spam. No transfers. One stop a week.',
} = Astro.props;

const BEEHIIV_FORM_ID = 'ca1b5de3-a598-4e22-82d6-6aa2c32dfae7';
---

<!--
  Strategy: Use the real Beehiiv V3 embed for reliable subscription, but
  wrap it in our design language. The iframe renders Beehiiv's own form
  which handles email capture and subscription natively.
-->
<div class:list={['subscribe-wrapper w-full max-w-xl', className]}>
  <!-- Beehiiv embed form — the V3 loader injects an iframe here -->
  <div id="beehiiv-form-container" class="beehiiv-embed-wrapper">
    <script
      async
      src="https://subscribe-forms.beehiiv.com/v3/loader.js"
      data-beehiiv-form={BEEHIIV_FORM_ID}
    ></script>
  </div>

  {caption && (
    <p
      class="font-body text-darkWalnut/60 text-xs mt-3 uppercase tracking-widest text-center"
    >
      {caption}
    </p>
  )}
</div>

<style>
  /* 
   * Override Beehiiv's default embed wrapper styling.
   * The V3 loader injects a <div> + <iframe>. We target both to ensure
   * the form fills our container properly and feels native to the design.
   */
  .beehiiv-embed-wrapper {
    width: 100%;
    /*
     * Beehiiv's embedded form has a fixed natural width (~440px) and
     * left-aligns itself inside any iframe that's wider than that, which
     * left-shifts the field on the page. Constrain the embed to that width
     * so the centered iframe hugs the form and the field stays centered.
     */
    max-width: 27.5rem;  /* 440px — matches the Beehiiv form's natural width */
    margin: 0 auto;
  }

  /* The loader creates a wrapper div with class containing "beehiiv" */
  .beehiiv-embed-wrapper :global(div) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .beehiiv-embed-wrapper :global(iframe) {
    width: 100% !important;
    max-width: 100% !important;
    border: none !important;
    min-height: 80px;
  }
</style>
