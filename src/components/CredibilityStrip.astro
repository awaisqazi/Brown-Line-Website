---
// Shared "Supported by / Featured in" credibility strip, used on the homepage
// and the (investor-facing) About page so the two never drift. Real, accurate
// labels only: do not add orgs or imply partnership beyond these (see design.md
// § 8). Width/height set per logo aspect ratio (normalized to ~32px tall) to
// avoid layout shift.
const base = import.meta.env.BASE_URL;
const supportedBy = [
  { src: 'logos/medill.png',   name: 'Northwestern Medill', href: 'https://www.medill.northwestern.edu', w: 124, h: 32 },
  { src: 'logos/projectc.png', name: 'Project C',           href: 'https://projectc.biz',                w: 48, h: 32 },
  { src: 'logos/neighbor.png', name: 'Meet Your Neighbor',  href: 'https://www.meetyourneighborchi.com', w: 41, h: 32, imgClass: 'h-14' },
];
const featuredIn = [
  { src: 'logos/creader.png',  name: 'Chicago Reader',      href: 'https://chicagoreader.com',           w: 75, h: 32 },
];
---
<div class="max-w-5xl mx-auto flex flex-col items-center gap-7 md:flex-row md:items-stretch md:justify-center md:gap-10">
  <div class="flex flex-col items-center gap-3">
    <span class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-darkWalnut/75">Supported by</span>
    <ul class="flex flex-wrap items-center justify-center gap-3">
      {supportedBy.map((logo) => (
        <li>
          <a
            href={logo.href}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="partner_click"
            data-ga-label={logo.name}
            aria-label={`${logo.name} (opens in a new tab)`}
            class="flex h-14 items-center justify-center border-2 border-darkWalnut bg-[#FDFBF7] px-4 transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[2px_2px_0_#642713] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
          >
            <img
              src={`${base}${logo.src}`}
              alt={logo.name}
              width={logo.w}
              height={logo.h}
              class={`${(logo as any).imgClass ?? 'h-7 md:h-8'} w-auto object-contain`}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <span class="hidden md:block w-px self-stretch bg-darkWalnut/20" aria-hidden="true"></span>

  <div class="flex flex-col items-center gap-3">
    <span class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-darkWalnut/75">Featured in</span>
    <ul class="flex items-center justify-center">
      {featuredIn.map((logo) => (
        <li>
          <a
            href={logo.href}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="partner_click"
            data-ga-label={logo.name}
            aria-label={`${logo.name} (opens in a new tab)`}
            class="flex h-14 items-center justify-center border-2 border-darkWalnut bg-[#FDFBF7] px-4 transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[2px_2px_0_#642713] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
          >
            <img
              src={`${base}${logo.src}`}
              alt={logo.name}
              width={logo.w}
              height={logo.h}
              class="h-7 md:h-8 w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
