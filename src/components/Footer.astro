---
import TransitDivider from './TransitDivider.astro';
import CredibilityStrip from './CredibilityStrip.astro';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const instagramUrl = 'https://www.instagram.com/thebrownlinechi';
const tiktokUrl = 'https://www.tiktok.com/@thebrownlinechi';
---
<footer class="mt-14 md:mt-16">
  <div class="max-w-5xl mx-auto px-6 pb-10 md:pb-12">
    <CredibilityStrip />
  </div>

  {/* Support CTA: right after "Supported by / Featured in", the ask. Kept as
      a quiet centered block so it reads as part of the page, not a billboard. */}
  <div class="px-6 pb-12 md:pb-14 text-center">
    <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">Fund the line</p>
    <p class="font-heading font-semibold text-darkWalnut text-2xl md:text-3xl leading-tight tracking-tight mt-2">
      Keep the train running.
    </p>
    <a
      href={`${base}support`}
      data-ga-event="support_click"
      data-ga-label="footer_band"
      class="mt-5 inline-flex items-center gap-2 border-2 border-darkWalnut bg-amber px-6 py-3 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cayenne"
    >
      Support The Brown Line <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <TransitDivider />
  <div class="bg-darkWalnut text-seashell">
    <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-6">
      <div>
        <p class="font-wordmark text-3xl md:text-4xl leading-none">the Brown Line</p>
        <p class="font-body text-seashell/75 text-sm mt-4 max-w-xs leading-relaxed">
          Your go-to guide for Chicago's Global South diaspora arts, culture, and community.
        </p>

        <p class="font-body uppercase text-[10px] tracking-[0.3em] text-seashell/55 font-semibold mt-8">Find us</p>
        <ul class="flex items-center gap-2 mt-3">
          <li>
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="The Brown Line on Instagram"
              class="footer-social inline-flex items-center justify-center w-10 h-10 text-seashell rounded-sm"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href={tiktokUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="The Brown Line on TikTok"
              class="footer-social inline-flex items-center justify-center w-10 h-10 text-seashell rounded-sm"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <div class="md:justify-self-end">
        <p class="font-body uppercase text-xs tracking-widest text-seashell/60 mb-4">Follow the line</p>
        <ul class="space-y-2 font-body text-sm">
          <li><a href={`${base}about`} class="link-transit">About</a></li>
          <li><a href={`${base}events`} class="link-transit">Events</a></li>
          <li><a href={`${base}submit-event`} class="link-transit">Submit an event</a></li>
          <li><a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="link-transit">Social media</a></li>
          <li><a href={`${base}newsletter`} class="link-transit">Newsletter</a></li>
          <li><a href={`${base}support`} class="link-transit">Keep the line running</a></li>
          <li><a href={`${base}about#ethics`} class="link-transit">Standards &amp; Ethics</a></li>
          <li><a href={`${base}privacy`} class="link-transit">Privacy</a></li>
          <li><a href="https://rss.beehiiv.com/feeds/utXCBZV29P.xml" target="_blank" rel="noopener noreferrer" class="link-transit">RSS</a></li>
          <li><a href="mailto:hi@thebrownlinechi.com" class="link-transit">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-6 pb-8">
      <p class="font-body text-seashell/60 text-xs uppercase tracking-widest">
        &copy; {year} The Brown Line.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-social {
    transition: transform 180ms ease, color 180ms ease;
  }
  .footer-social:hover,
  .footer-social:focus-visible {
    color: #FFBC29;
    transform: translateY(-2px);
    outline: none;
  }
</style>
