---
// Events panel of the admin command center (/admin#events): flyer scanner,
// add one event, the full schedule manager, and CSV import. Moved from the
// former src/pages/admin/events.astro with behavior unchanged; the password,
// client, realtime channel, and Publish live site now come from
// src/lib/admin-session.ts.
import { ALLOWED_TAGS as DIASPORA_TAGS } from '../../lib/admin-shared';
import {
  buttonClass,
  cardClass,
  cardHeadingClass,
  eyebrowClass,
  fieldMarkerClass,
  inputClass,
  labelClass,
  secondaryButtonClass,
} from './classes';

const csvHeaders = [
  'event_date',
  'title',
  'venue',
  'start_time',
  'end_time',
  'neighborhood',
  'description',
  'organizer',
  'cost_info',
  'event_url',
  'image_url',
  'author_note',
  'emoji',
  'tags',
  'is_curated',
  'is_giveaway',
];
const csvTemplateHref = `data:text/csv;charset=utf-8,${encodeURIComponent(`${csvHeaders.join(',')}\n`)}`;

const jumpLinkClass =
  'inline-flex border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue';
const jumps = [
  { href: '#events-scan', label: 'Scan a flyer' },
  { href: '#events-add', label: 'Add one event' },
  { href: '#events-schedule', label: 'Full schedule' },
  { href: '#events-csv', label: 'CSV import' },
];
---

<div data-admin-panel="events" class="space-y-8">
  <header>
    <p class={eyebrowClass}>Line operations</p>
    <h2 data-panel-heading tabindex="-1" class="mt-3 font-heading text-[2.25rem] leading-none text-darkWalnut focus:outline-none md:text-5xl">
      Events
    </h2>
    <p class="mt-4 max-w-2xl font-body text-sm leading-relaxed text-darkWalnut/75 md:text-base">
      Scan a flyer, add single events, edit the full schedule, or import a spreadsheet. Every change
      saves to the database instantly; the public page rebuilds every 4 hours, or push it out right
      away with Publish live site.
    </p>
    <nav aria-label="Jump to an events section" class="mt-5">
      <ul class="flex flex-wrap gap-2">
        {jumps.map((jump) => (
          <li><a href={jump.href} class={jumpLinkClass}>{jump.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>

  <section id="events-scan" data-scanner-section aria-labelledby="events-scan-title" class={cardClass}>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenneInk">
          Camera car
        </p>
        <h3 id="events-scan-title" class={cardHeadingClass}>
          Scan a flyer
        </h3>
      </div>
      <p
        data-scan-quota
        class="border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut"
        role="status"
        aria-live="polite"
      >
        Checking today's scans...
      </p>
    </div>

    <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
      Upload a flyer photo and Gemini reads it into a draft event. The draft lands in the
      Add one event form below, so review every field before saving. Scans come from a shared
      daily pool across all admins and reset at midnight Chicago time.
    </p>

    <form data-scan-form class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <label class={labelClass} for="scan-file">
        Flyer photo
        <input
          id="scan-file"
          data-scan-file
          type="file"
          accept="image/*"
          class="mt-2 w-full border-2 border-dashed border-darkWalnut bg-seashell px-3 py-6 font-body text-sm text-darkWalnut file:mr-4 file:border-2 file:border-darkWalnut file:bg-amber file:px-3 file:py-2 file:font-body file:text-xs file:font-bold file:uppercase file:tracking-widest file:text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue"
          required
        />
      </label>
      <button type="submit" data-scan-submit class={buttonClass}>Scan with Gemini</button>
    </form>

    <div data-scan-preview-wrap hidden class="mt-4 border-2 border-dashed border-darkWalnut/35 bg-seashell p-3">
      <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45">
        Selected photo
      </p>
      <img
        data-scan-preview
        alt="Selected flyer"
        class="mt-2 max-h-64 w-auto max-w-full border-2 border-darkWalnut object-contain"
      />
    </div>

    <p data-scan-status class="mt-4 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
  </section>

  <section id="events-add" aria-labelledby="events-add-title" class={cardClass}>
    <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenneInk">
      Single stop
    </p>
    <h3 id="events-add-title" class={cardHeadingClass}>
      Add one event
    </h3>
    <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
      Fill the fields marked Required, including the organizer, start time, neighborhood,
      event URL, a flyer or photo link, and a description of 150 words or fewer. For a
      multi-day run, set Last day and we add one event per day.
    </p>

    {/* novalidate: native validation stops at the first empty required field.
        The submit handler collects every missing one and names them all in a
        single message instead. */}
    <form data-single-event-form novalidate class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">
      <label class={labelClass} for="event-title">
        Title
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-title" name="title" type="text" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-date">
        Event date
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-date" name="event_date" type="date" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-end-date">
        Last day
        <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional, for multi-day runs</span>
        <input id="event-end-date" name="event_end_date" type="date" class={inputClass} />
        <span class="mt-1.5 block font-body text-[11px] font-normal normal-case leading-relaxed tracking-normal text-darkWalnut/60">
          For a run of consecutive days, set the final date and we add one event per day from
          the event date through this one. Leave blank for a single day.
        </span>
      </label>

      <label class={labelClass} for="event-venue">
        Venue
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-venue" name="venue" type="text" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-start-time">
        Start time
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-start-time" name="start_time" type="time" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-end-time">
        End time
        <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
        <input id="event-end-time" name="end_time" type="time" class={inputClass} />
      </label>

      <label class={labelClass} for="event-neighborhood">
        Neighborhood
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-neighborhood" name="neighborhood" type="text" placeholder="Pilsen, Hyde Park" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-organizer">
        Organizer
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-organizer" name="organizer" type="text" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-cost-info">
        Cost info
        <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
        <input id="event-cost-info" name="cost_info" type="text" class={inputClass} />
      </label>

      <label class={`${labelClass} md:col-span-2`} for="event-url">
        Event URL
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-url" name="event_url" type="url" placeholder="https://..." class={inputClass} required />
      </label>

      <label class={`${labelClass} md:col-span-2`} for="event-image-url">
        Photo or flyer URL
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
        <input id="event-image-url" name="image_url" type="url" placeholder="https://... (link to a flyer or photo)" class={inputClass} required />
      </label>

      <label class={labelClass} for="event-emoji">
        Emoji
        <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
        <input id="event-emoji" name="emoji" type="text" class={inputClass} />
      </label>

      <fieldset class="md:col-span-2">
        <legend class={labelClass}>
          Community tags
          <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional, pick any that apply</span>
        </legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {DIASPORA_TAGS.map((tag) => (
            <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut has-[:checked]:bg-amber">
              <input name="tags" value={tag} type="checkbox" class="h-4 w-4 accent-cayenne" />
              {tag}
            </label>
          ))}
        </div>
      </fieldset>

      <label class={`${labelClass} md:col-span-2`} for="event-description">
        Description
        <span class={`${fieldMarkerClass} text-cayenneInk`}>Required, 150 words max</span>
        <textarea id="event-description" name="description" rows="5" data-word-limit="150" class={inputClass} required></textarea>
        <span data-word-count class="mt-1.5 block font-body text-[11px] font-bold normal-case tracking-normal text-darkWalnut/60" aria-live="polite">0 / 150 words</span>
      </label>

      <label class={`${labelClass} md:col-span-2`} for="event-author-note">
        Author note
        <span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
        <textarea id="event-author-note" name="author_note" rows="3" class={inputClass}></textarea>
      </label>

      <div class="flex flex-wrap gap-3 md:col-span-2">
        <p class="basis-full font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45">
          Optional flags
        </p>
        <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
          <input name="is_curated" type="checkbox" class="h-4 w-4 accent-cayenne" />
          Conductor's pick
        </label>

        <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-seashell px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
          <input name="is_giveaway" type="checkbox" class="h-4 w-4 accent-cayenne" />
          Giveaway
        </label>
      </div>

      <div class="md:col-span-2">
        <button type="submit" data-single-submit class={buttonClass}>Add event</button>
        {/* A div, not a p: the success confirmation renders a block-level
            banner inside this same live region so it is announced. */}
        <div data-single-status class="mt-3 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></div>
      </div>
    </form>
  </section>

  <section id="events-schedule" data-database-section aria-labelledby="events-schedule-title" class={cardClass}>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-body text-[10px] font-bold uppercase tracking-[0.3em] text-cayenneInk">
          Control tower
        </p>
        <h3 id="events-schedule-title" class={cardHeadingClass}>
          The full schedule
          <span data-db-count class="ml-2 align-middle font-body text-base font-bold text-darkWalnut/60"></span>
        </h3>
      </div>
      <p data-db-live class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/45" role="status">
        Live updates: connecting...
      </p>
    </div>

    <p class="mt-5 font-body text-sm leading-relaxed text-darkWalnut/75">
      Every event in the database. Edits and deletes save to Supabase the moment you confirm
      them, and this list refreshes by itself when anyone makes a change. The public page is a
      static rebuild of this data: press Publish live site to push changes out in a couple of
      minutes instead of waiting for the 4-hour refresh.
    </p>

    <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto_auto] md:items-end">
      <label class={labelClass} for="db-scope">
        Show
        <select id="db-scope" data-db-scope class={inputClass}>
          <option value="upcoming" selected>Upcoming events</option>
          <option value="all">All events, including past</option>
        </select>
      </label>
      <label class={labelClass} for="db-search">
        Search
        <input
          id="db-search"
          data-db-search
          type="search"
          placeholder="Title, venue, organizer, tag..."
          class={inputClass}
        />
      </label>
      <button type="button" data-db-refresh class={secondaryButtonClass}>Refresh</button>
      <button type="button" data-db-publish data-publish-live class={buttonClass}>Publish live site</button>
    </div>

    <p data-db-publish-status class="mt-3 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
    <p data-db-status class="mt-3 font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>

    <div data-db-list class="mt-6 space-y-3"></div>
  </section>

  <details id="events-csv" data-csv-details class="scroll-mt-6 border-2 border-darkWalnut bg-[#FDFBF7] shadow-retro">
    <summary class="admin-summary flex cursor-pointer list-none items-end justify-between gap-3 p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue md:p-7">
      <span>
        <span class={`block ${eyebrowClass}`}>Spreadsheet transfer</span>
        <span class={`block ${cardHeadingClass}`}>Bulk CSV upload</span>
      </span>
      <span aria-hidden="true" class="admin-summary-marker shrink-0 border-2 border-darkWalnut bg-amber px-2 py-1 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut"></span>
    </summary>
    <div class="border-t-2 border-dashed border-darkWalnut/35 p-5 md:p-7">
      <p class="font-body text-sm leading-relaxed text-darkWalnut/75">
        Download the template, fill one row per event, then upload the finished CSV here. Optional columns can stay blank or be removed from the file.
      </p>

      <a
        href={csvTemplateHref}
        download="brown-line-events-template.csv"
        class={`${secondaryButtonClass} mt-5`}
      >
        Download CSV template
      </a>

      <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="border-2 border-darkWalnut bg-seashell p-4">
          <p class="font-body text-[10px] font-bold uppercase tracking-widest text-cayenneInk">
            Required columns
          </p>
          <p class="mt-2 font-body text-sm leading-relaxed text-darkWalnut/75">
            event_date, title, venue, start_time, neighborhood, organizer, event_url, image_url (copied into our storage on upload), description (150 words max)
          </p>
        </div>

        <div class="border-2 border-dashed border-darkWalnut/35 bg-seashell p-4">
          <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/55">
            Optional columns
          </p>
          <p class="mt-2 font-body text-sm leading-relaxed text-darkWalnut/75">
            end_time, cost_info, author_note, emoji, tags, is_curated, is_giveaway
          </p>
        </div>
      </div>

      <p class="mt-4 font-body text-sm leading-relaxed text-darkWalnut/75">
        Tags can be comma-separated inside one cell and must come from the fixed community tag
        list: {DIASPORA_TAGS.join(', ')}. For pick or giveaway columns, use true, false, yes,
        no, 1, or 0. Start time and end time both use 24-hour HH:MM. An end time may be
        earlier than its start time when the event runs past midnight. For a multi-day run,
        add one row per day with the same title and venue; the public board collapses them
        into a single card with a date range.
      </p>

      <form data-csv-form class="mt-7 space-y-5">
        <label class={labelClass} for="event-csv">
          CSV file
          <input
            id="event-csv"
            data-csv-file
            type="file"
            accept=".csv,text/csv"
            class="mt-2 w-full border-2 border-dashed border-darkWalnut bg-seashell px-3 py-8 font-body text-sm text-darkWalnut file:mr-4 file:border-2 file:border-darkWalnut file:bg-amber file:px-3 file:py-2 file:font-body file:text-xs file:font-bold file:uppercase file:tracking-widest file:text-darkWalnut focus:outline-none focus:ring-2 focus:ring-mayaBlue"
            required
          />
        </label>

        <div class="border-2 border-dashed border-darkWalnut/35 bg-seashell p-4">
          <p class="font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut/65">
            When will it show up?
          </p>
          <p class="mt-2 font-body text-sm leading-relaxed text-darkWalnut/75">
            Saves land in the database instantly. The public page rebuilds every 4 hours on its own, or press Publish live site in the schedule section to push everything out in a couple of minutes.
          </p>
        </div>

        <button type="submit" data-csv-submit class={buttonClass}>Upload CSV</button>
        <div data-csv-status class="font-body text-sm font-bold leading-relaxed text-darkWalnut" role="status" aria-live="polite"></div>
      </form>
    </div>
  </details>

  <template data-event-row-template>
    <article data-event-row class="border-2 border-darkWalnut bg-seashell shadow-[3px_3px_0_#642713]">
      <div class="flex flex-wrap items-center gap-3 p-4">
        <div class="min-w-[8.5rem] border-2 border-darkWalnut bg-[#FDFBF7] px-2 py-1 text-center font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut">
          <span data-row-date></span>
        </div>
        <div class="min-w-0 flex-1">
          <p class="truncate font-body text-sm font-bold text-darkWalnut">
            <span data-row-emoji></span>
            <span data-row-title></span>
          </p>
          <p class="truncate font-body text-xs text-darkWalnut/65">
            <span data-row-venue></span>
            <span data-row-meta class="ml-2 font-bold uppercase tracking-widest text-cayenneInk"></span>
          </p>
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            data-row-edit
            class="border-2 border-darkWalnut bg-amber px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
          >Edit</button>
          <button
            type="button"
            data-row-delete
            class="border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[10px] font-bold uppercase tracking-widest text-cayenneInk transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue disabled:cursor-not-allowed disabled:opacity-60"
          >Delete</button>
        </div>
      </div>

      <form data-row-editor hidden class="grid grid-cols-1 gap-4 border-t-2 border-dashed border-darkWalnut/35 p-4 md:grid-cols-2">
        <label class={labelClass}>
          Title<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="title" type="text" class={inputClass} required />
        </label>

        <label class={labelClass}>
          Event date<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="event_date" type="date" class={inputClass} required />
        </label>

        <label class={labelClass}>
          Venue<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="venue" type="text" class={inputClass} required />
        </label>

        <label class={labelClass}>
          Start time<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="start_time" type="time" class={inputClass} required />
        </label>

        <label class={labelClass}>
          End time<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
          <input name="end_time" type="time" class={inputClass} />
        </label>

        <label class={labelClass}>
          Neighborhood<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="neighborhood" type="text" class={inputClass} required />
        </label>

        <label class={labelClass}>
          Organizer<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="organizer" type="text" class={inputClass} required />
        </label>

        <label class={labelClass}>
          Cost info<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
          <input name="cost_info" type="text" class={inputClass} />
        </label>

        <label class={labelClass}>
          Emoji<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
          <input name="emoji" type="text" class={inputClass} />
        </label>

        <label class={`${labelClass} md:col-span-2`}>
          Event URL<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="event_url" type="url" class={inputClass} required />
        </label>

        <label class={`${labelClass} md:col-span-2`}>
          Photo or flyer URL<span class={`${fieldMarkerClass} text-cayenneInk`}>Required</span>
          <input name="image_url" type="url" class={inputClass} required />
        </label>

        <fieldset class="md:col-span-2">
          <legend class={labelClass}>
            Community tags<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Pick any that apply</span>
          </legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {DIASPORA_TAGS.map((tag) => (
              <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut has-[:checked]:bg-amber">
                <input name="tags" value={tag} type="checkbox" class="h-4 w-4 accent-cayenne" />
                {tag}
              </label>
            ))}
          </div>
        </fieldset>

        <label class={`${labelClass} md:col-span-2`}>
          Description<span class={`${fieldMarkerClass} text-cayenneInk`}>Required, 150 words max</span>
          <textarea name="description" rows="4" data-word-limit="150" class={inputClass} required></textarea>
          <span data-word-count class="mt-1.5 block font-body text-[11px] font-bold normal-case tracking-normal text-darkWalnut/60" aria-live="polite">0 / 150 words</span>
        </label>

        <label class={`${labelClass} md:col-span-2`}>
          Author note<span class={`${fieldMarkerClass} text-darkWalnut/45`}>Optional</span>
          <textarea name="author_note" rows="2" class={inputClass}></textarea>
        </label>

        <div class="flex flex-wrap gap-3 md:col-span-2">
          <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
            <input name="is_curated" type="checkbox" class="h-4 w-4 accent-cayenne" />
            Conductor's pick
          </label>
          <label class="inline-flex cursor-pointer items-center gap-2 border-2 border-darkWalnut bg-[#FDFBF7] px-3 py-2 font-body text-[11px] font-bold uppercase tracking-widest text-darkWalnut">
            <input name="is_giveaway" type="checkbox" class="h-4 w-4 accent-cayenne" />
            Giveaway
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t-2 border-dashed border-darkWalnut/35 pt-4 md:col-span-2">
          <button type="submit" data-row-save class={`${buttonClass} disabled:cursor-not-allowed disabled:opacity-60`}>Save changes</button>
          <button
            type="button"
            data-row-cancel
            class="border-2 border-darkWalnut bg-seashell px-4 py-3 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-retro focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue"
          >Cancel</button>
          <p data-row-status class="font-body text-sm font-bold text-darkWalnut" role="status" aria-live="polite"></p>
        </div>
      </form>
    </article>
  </template>
</div>

<script>
  import Papa from 'papaparse';
  import type { SupabaseClient } from '@supabase/supabase-js';
  import {
    type AdminEventRecord,
    addDaysToDateString,
    attachWordCounters,
    chicagoToday,
    cleanText,
    errorMessage,
    mirrorImageUrl as mirrorImageUrlWithAuth,
    normalizeTimeOfDay,
    nullableText,
    readSessionFlag,
    requiredDate,
    requiredDescription,
    requiredText,
    requiredTimeOfDay,
    requiredUrl,
    setInlineStatus,
    STORED_IMAGE_PATH,
    updateWordCounters,
    validateTags,
    withBusy,
    writeSessionFlag,
  } from '../../lib/admin-shared';
  import {
    emit,
    functionsBase,
    getClient,
    getPassword,
    getRealtimeStatus,
    on,
    publishLiveSite,
    type ScanQuota,
  } from '../../lib/admin-session';

  type CsvRow = Record<string, unknown>;

  const app = document.querySelector('[data-admin-panel="events"]') as HTMLElement | null;

  if (app) {
    // Mirrors the shared session client (set on unlock, cleared on lock) so the
    // moved code below reads exactly as it did on the old page.
    let adminSupabase: SupabaseClient | null = null;
    let dbReloadTimer: ReturnType<typeof setTimeout> | undefined;
    let scanPreviewUrl: string | null = null;

    const singleEventForm = app.querySelector('[data-single-event-form]') as HTMLFormElement | null;
    const singleSubmit = app.querySelector('[data-single-submit]') as HTMLButtonElement | null;
    const singleStatus = app.querySelector('[data-single-status]') as HTMLElement | null;
    const csvDetails = app.querySelector('[data-csv-details]') as HTMLDetailsElement | null;
    const csvForm = app.querySelector('[data-csv-form]') as HTMLFormElement | null;
    const csvSubmit = app.querySelector('[data-csv-submit]') as HTMLButtonElement | null;
    const csvStatus = app.querySelector('[data-csv-status]') as HTMLElement | null;
    const csvFileInput = app.querySelector('[data-csv-file]') as HTMLInputElement | null;
    const scanForm = app.querySelector('[data-scan-form]') as HTMLFormElement | null;
    const scanFile = app.querySelector('[data-scan-file]') as HTMLInputElement | null;
    const scanSubmit = app.querySelector('[data-scan-submit]') as HTMLButtonElement | null;
    const scanStatus = app.querySelector('[data-scan-status]') as HTMLElement | null;
    const scanQuota = app.querySelector('[data-scan-quota]') as HTMLElement | null;
    const scanPreviewWrap = app.querySelector('[data-scan-preview-wrap]') as HTMLElement | null;
    const scanPreview = app.querySelector('[data-scan-preview]') as HTMLImageElement | null;
    const dbList = app.querySelector('[data-db-list]') as HTMLElement | null;
    const dbCount = app.querySelector('[data-db-count]') as HTMLElement | null;
    const dbStatus = app.querySelector('[data-db-status]') as HTMLElement | null;
    const dbLive = app.querySelector('[data-db-live]') as HTMLElement | null;
    const dbScopeSelect = app.querySelector('[data-db-scope]') as HTMLSelectElement | null;
    const dbSearch = app.querySelector('[data-db-search]') as HTMLInputElement | null;
    const dbRefresh = app.querySelector('[data-db-refresh]') as HTMLButtonElement | null;
    const dbPublish = app.querySelector('[data-db-publish]') as HTMLButtonElement | null;
    const dbPublishStatus = app.querySelector('[data-db-publish-status]') as HTMLElement | null;
    const eventRowTemplate = app.querySelector('[data-event-row-template]') as HTMLTemplateElement | null;
    let dbEvents: Array<AdminEventRecord & { id: string }> = [];

    function setUnlocked(isUnlocked: boolean) {
      if (isUnlocked) {
        void loadDbEvents();
        renderLiveStatus(getRealtimeStatus());
        void refreshScanQuota();
      } else {
        clearTimeout(dbReloadTimer);
        dbPendingReload = false;
        dbEvents = [];
        if (dbList) dbList.innerHTML = '';
        if (dbCount) dbCount.textContent = '';
        if (dbStatus) dbStatus.textContent = '';
        if (dbPublishStatus) dbPublishStatus.textContent = '';
        if (dbSearch) dbSearch.value = '';
        scanForm?.reset();
        clearScanPreview();
        if (scanQuota) scanQuota.textContent = "Checking today's scans...";
        if (scanStatus) scanStatus.textContent = '';
      }
    }

    // Multi-day runs from the single-add form: one row per day from event_date
    // through the last day, which is how the public board already models a
    // series (same title + venue rows collapse into one card with a range).
    const MAX_RANGE_DAYS = 90;

    function expandDateRange(record: AdminEventRecord, endDate: string): AdminEventRecord[] {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(endDate)) {
        throw new Error('Last day must use YYYY-MM-DD format.');
      }
      if (endDate < record.event_date) {
        throw new Error('Last day must be on or after the event date.');
      }
      const records: AdminEventRecord[] = [];
      let date = record.event_date;
      while (date <= endDate) {
        records.push({ ...record, event_date: date });
        if (records.length > MAX_RANGE_DAYS) {
          throw new Error(
            `That range is longer than ${MAX_RANGE_DAYS} days. Double-check the last day.`
          );
        }
        date = addDaysToDateString(date, 1);
      }
      return records;
    }

    // One delegated listener covers the static single form plus every row
    // editor in this panel. (Review cards have their own, in the Submissions
    // panel.)
    attachWordCounters(app);

    function parseTags(value: unknown) {
      const clean = cleanText(value);
      if (!clean) return null;

      if (clean.startsWith('[')) {
        try {
          const parsed = JSON.parse(clean);
          if (Array.isArray(parsed)) {
            const tags = parsed.map((tag) => cleanText(tag)).filter(Boolean);
            return tags.length > 0 ? tags : null;
          }
        } catch (_) {
          // Fall back to delimiter parsing below.
        }
      }

      const tags = clean
        .split(/[|,]/)
        .map((tag) => tag.trim())
        .filter(Boolean);

      return tags.length > 0 ? tags : null;
    }

    // The single-add form confirms with a themed banner rather than a text line.
    // It is built inside the existing status element so the same live region
    // announces it, and so the next setInlineStatus call wipes it.
    function setSingleSuccessBanner(title: string, dayCount = 1) {
      if (!singleStatus) return;
      singleStatus.textContent = '';
      singleStatus.classList.remove('text-cayenneInk');
      singleStatus.classList.add('text-darkWalnut');

      const banner = document.createElement('div');
      banner.className = 'border-2 border-darkWalnut bg-celadon p-4 shadow-retro';

      const heading = document.createElement('p');
      heading.className = 'font-body text-[10px] font-bold uppercase tracking-[0.3em] text-darkWalnut';
      heading.textContent = 'Now boarding';

      const body = document.createElement('p');
      body.className = 'mt-2 font-body text-sm font-normal leading-relaxed text-darkWalnut';
      body.textContent =
        dayCount > 1
          ? `"${title}" is on the schedule for ${dayCount} days. Press Publish live site to show it publicly now, or wait for the scheduled rebuild.`
          : `"${title}" is on the schedule. Press Publish live site to show it publicly now, or wait for the scheduled rebuild.`;

      banner.append(heading, body);
      singleStatus.appendChild(banner);
    }

    function parseBoolean(value: unknown) {
      const clean = cleanText(value).toLowerCase();
      if (!clean) return false;
      return ['true', '1', 'yes', 'y', 'x'].includes(clean);
    }

    function getFormValue(formData: FormData, name: string) {
      return formData.get(name);
    }

    function recordFromForm(form: HTMLFormElement): AdminEventRecord {
      const formData = new FormData(form);
      const checkedTags = formData.getAll('tags').map((tag) => cleanText(tag)).filter(Boolean);
      return {
        title: requiredText(getFormValue(formData, 'title'), 'title'),
        event_date: requiredDate(getFormValue(formData, 'event_date')),
        venue: requiredText(getFormValue(formData, 'venue'), 'venue'),
        start_time: requiredTimeOfDay(getFormValue(formData, 'start_time'), 'start_time'),
        end_time: normalizeTimeOfDay(getFormValue(formData, 'end_time'), 'end_time'),
        neighborhood: requiredText(getFormValue(formData, 'neighborhood'), 'neighborhood'),
        organizer: requiredText(getFormValue(formData, 'organizer'), 'organizer'),
        cost_info: nullableText(getFormValue(formData, 'cost_info')),
        event_url: requiredUrl(getFormValue(formData, 'event_url'), 'event_url'),
        image_url: requiredUrl(getFormValue(formData, 'image_url'), 'image_url'),
        description: requiredDescription(getFormValue(formData, 'description')),
        author_note: nullableText(getFormValue(formData, 'author_note')),
        emoji: nullableText(getFormValue(formData, 'emoji')),
        tags: validateTags(checkedTags.length > 0 ? checkedTags : null),
        is_curated: formData.get('is_curated') === 'on',
        is_giveaway: formData.get('is_giveaway') === 'on',
      };
    }

    // Only the single-add form runs this pass. The review cards and the row
    // editor keep their native validation, which is fine on a form the admin is
    // correcting one field at a time.
    const SINGLE_REQUIRED_FIELDS = [
      { name: 'title', label: 'Title' },
      { name: 'event_date', label: 'Event date' },
      { name: 'venue', label: 'Venue' },
      { name: 'start_time', label: 'Start time' },
      { name: 'neighborhood', label: 'Neighborhood' },
      { name: 'organizer', label: 'Organizer' },
      { name: 'event_url', label: 'Event URL' },
      { name: 'image_url', label: 'Photo or flyer URL' },
      { name: 'description', label: 'Description' },
    ];

    function missingRequiredLabels(form: HTMLFormElement) {
      const formData = new FormData(form);
      return SINGLE_REQUIRED_FIELDS.filter(
        (field) => !cleanText(getFormValue(formData, field.name))
      ).map((field) => field.label);
    }

    function recordFromCsvRow(row: CsvRow, rowNumber: number): AdminEventRecord {
      try {
        return {
          event_date: requiredDate(row.event_date),
          title: requiredText(row.title, 'title'),
          venue: requiredText(row.venue, 'venue'),
          start_time: requiredTimeOfDay(row.start_time, 'start_time'),
          end_time: normalizeTimeOfDay(row.end_time, 'end_time'),
          neighborhood: requiredText(row.neighborhood, 'neighborhood'),
          description: requiredDescription(row.description),
          organizer: requiredText(row.organizer, 'organizer'),
          cost_info: nullableText(row.cost_info),
          event_url: requiredUrl(row.event_url, 'event_url'),
          image_url: requiredUrl(row.image_url, 'image_url'),
          author_note: nullableText(row.author_note),
          emoji: nullableText(row.emoji),
          tags: validateTags(parseTags(row.tags)),
          is_curated: parseBoolean(row.is_curated),
          is_giveaway: parseBoolean(row.is_giveaway),
        };
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Invalid row.';
        throw new Error(`Row ${rowNumber}: ${message}`);
      }
    }

    function isBlankCsvRow(row: CsvRow) {
      return Object.values(row).every((value) => cleanText(value) === '');
    }

    // Flyer mirroring: the shared helper, fed the session's password.
    function mirrorImageUrl(url: string | null) {
      return mirrorImageUrlWithAuth(url, getPassword(), functionsBase);
    }

    // Mirrors every distinct flyer link across a batch (a date range shares one
    // link across all its rows), rewriting the records in place.
    async function mirrorRecordImages(records: AdminEventRecord[], statusEl: HTMLElement | null) {
      const distinct = Array.from(
        new Set(records.map((record) => record.image_url).filter((url): url is string => Boolean(url)))
      );
      const todo = distinct.filter((url) => !url.includes(STORED_IMAGE_PATH));
      if (todo.length === 0) return [] as string[];
      setInlineStatus(statusEl, `Copying ${todo.length === 1 ? 'the flyer' : `${todo.length} flyers`} into our storage...`);
      const warnings: string[] = [];
      const replacements = new Map<string, string | null>();
      for (const url of todo) {
        const mirrored = await mirrorImageUrl(url);
        replacements.set(url, mirrored.url);
        if (mirrored.warning) warnings.push(mirrored.warning);
      }
      records.forEach((record) => {
        if (record.image_url && replacements.has(record.image_url)) {
          record.image_url = replacements.get(record.image_url) ?? record.image_url;
        }
      });
      return warnings;
    }

    async function insertEvents(records: AdminEventRecord[], statusEl: HTMLElement | null = null) {
      if (!adminSupabase) {
        throw new Error('Unlock the admin portal first.');
      }

      const warnings = await mirrorRecordImages(records, statusEl);
      const { error } = await adminSupabase.from('events').insert(records);
      if (error) throw new Error(error.message);
      return warnings;
    }

    /* ---------- Database manager ---------- */
    type DbEventRow = AdminEventRecord & { id: string };

    function dbScopeValue() {
      return dbScopeSelect?.value === 'all' ? 'all' : 'upcoming';
    }

    // Returns a 12-hour clock label, or an empty string when the value is not a
    // usable HH:MM time.
    function formatClockTime(timeStr: string | null) {
      const clean = (timeStr ?? '').slice(0, 5);
      if (!/^\d{2}:\d{2}$/.test(clean)) return '';
      const [hour, minute] = clean.split(':').map(Number);
      const hour12 = ((hour + 11) % 12) + 1;
      return `${hour12}:${String(minute).padStart(2, '0')} ${hour < 12 ? 'AM' : 'PM'}`;
    }

    // An end time only appears alongside a start time: "9:00 PM" on its own
    // would read as the moment the event begins.
    function formatRowDate(dateStr: string, timeStr: string | null, endTimeStr: string | null = null) {
      const date = new Date(`${dateStr}T12:00:00`);
      let label = Number.isNaN(date.getTime())
        ? dateStr
        : date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
      const start = formatClockTime(timeStr);
      if (start) {
        const end = formatClockTime(endTimeStr);
        label += ` · ${start}${end ? ` to ${end}` : ''}`;
      }
      return label;
    }

    // A realtime change that arrives while a row editor is open waits here so
    // the re-render cannot wipe unsaved edits.
    let dbPendingReload = false;
    // Generation counter: with overlapping loads (realtime + scope change +
    // refresh), only the newest response may write the list.
    let dbLoadGeneration = 0;

    function dbEditorOpen() {
      return Boolean(dbList?.querySelector('[data-row-editor]:not([hidden])'));
    }

    function runPendingDbReload() {
      if (dbPendingReload && !dbEditorOpen()) {
        void loadDbEvents();
      }
    }

    async function loadDbEvents() {
      if (!adminSupabase || !dbList) return;
      const client = adminSupabase;
      dbPendingReload = false;
      const generation = ++dbLoadGeneration;
      setInlineStatus(dbStatus, 'Loading events...');
      try {
        let query = client
          .from('events')
          .select('*')
          .order('event_date', { ascending: true })
          .order('start_time', { ascending: true, nullsFirst: false })
          .order('title', { ascending: true });
        if (dbScopeValue() === 'upcoming') {
          query = query.gte('event_date', chicagoToday());
        }
        const { data, error } = await query;
        // Stale (a newer load started) or the session locked meanwhile.
        if (generation !== dbLoadGeneration || adminSupabase !== client) return;
        if (error) throw new Error(error.message);
        dbEvents = (data ?? []) as DbEventRow[];
        renderDbList();
      } catch (error) {
        if (generation !== dbLoadGeneration || adminSupabase !== client) return;
        const message = errorMessage(error);
        setInlineStatus(dbStatus, `Could not load events: ${message}`, true);
      }
    }

    function matchesDbSearch(row: DbEventRow, needle: string) {
      if (!needle) return true;
      return [
        row.title,
        row.venue,
        row.organizer,
        row.neighborhood,
        row.description,
        (row.tags ?? []).join(' '),
      ]
        .map((value) => (value ?? '').toString().toLowerCase())
        .join(' ')
        .includes(needle);
    }

    function renderDbList() {
      if (!dbList || !eventRowTemplate) return;
      const needle = cleanText(dbSearch?.value).toLowerCase();
      const rows = dbEvents.filter((row) => matchesDbSearch(row, needle));
      const today = chicagoToday();
      dbList.innerHTML = '';
      rows.forEach((row) => {
        const card = buildEventRow(row, today);
        if (card) dbList.appendChild(card);
      });
      if (dbCount) {
        const scopeLabel = dbScopeValue() === 'upcoming' ? 'upcoming' : 'total';
        dbCount.textContent = needle
          ? `(${rows.length} of ${dbEvents.length} ${scopeLabel})`
          : `(${dbEvents.length} ${scopeLabel})`;
      }
      if (rows.length === 0) {
        setInlineStatus(
          dbStatus,
          dbEvents.length === 0 ? 'No events in this view.' : 'No events match the search.'
        );
      } else {
        setInlineStatus(dbStatus, '');
      }
    }

    function fillRowEditor(editor: HTMLFormElement, row: DbEventRow) {
      const setValue = (name: string, value: string) => {
        const el = editor.querySelector(`[name="${name}"]`) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | null;
        if (el) el.value = value;
      };
      setValue('title', row.title ?? '');
      setValue('event_date', row.event_date ?? '');
      setValue('venue', row.venue ?? '');
      setValue('start_time', (row.start_time ?? '').slice(0, 5));
      setValue('end_time', (row.end_time ?? '').slice(0, 5));
      setValue('neighborhood', row.neighborhood ?? '');
      setValue('organizer', row.organizer ?? '');
      setValue('cost_info', row.cost_info ?? '');
      setValue('event_url', row.event_url ?? '');
      setValue('image_url', row.image_url ?? '');
      setValue('emoji', row.emoji ?? '');
      setValue('description', row.description ?? '');
      setValue('author_note', row.author_note ?? '');
      const rowTags = (row.tags ?? []).map((tag) => tag.toLowerCase());
      (editor.querySelectorAll('input[name="tags"]') as NodeListOf<HTMLInputElement>).forEach((el) => {
        el.checked = rowTags.includes(el.value.toLowerCase());
      });
      const setChecked = (name: string, checked: boolean) => {
        const el = editor.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
        if (el) el.checked = checked;
      };
      setChecked('is_curated', Boolean(row.is_curated));
      setChecked('is_giveaway', Boolean(row.is_giveaway));
    }

    function buildEventRow(row: DbEventRow, today: string) {
      if (!eventRowTemplate) return null;
      const fragment = eventRowTemplate.content.cloneNode(true) as DocumentFragment;
      const card = fragment.querySelector('[data-event-row]') as HTMLElement | null;
      if (!card) return null;

      const setText = (name: string, value: string) => {
        const el = card.querySelector(`[data-row-${name}]`);
        if (el) el.textContent = value;
      };
      setText('date', formatRowDate(row.event_date, row.start_time, row.end_time));
      setText('title', row.title ?? '');
      setText('emoji', row.emoji ?? '');
      setText('venue', row.venue ?? '');
      setText(
        'meta',
        [
          ...(row.tags ?? []),
          row.is_curated ? "Conductor's pick" : '',
          row.is_giveaway ? 'Giveaway' : '',
        ]
          .filter(Boolean)
          .join(' · ')
      );
      if (row.event_date < today) card.classList.add('opacity-60');

      const editor = card.querySelector('[data-row-editor]') as HTMLFormElement | null;
      const editButton = card.querySelector('[data-row-edit]') as HTMLButtonElement | null;
      const deleteButton = card.querySelector('[data-row-delete]') as HTMLButtonElement | null;
      const cancelButton = card.querySelector('[data-row-cancel]') as HTMLButtonElement | null;
      const saveButton = card.querySelector('[data-row-save]') as HTMLButtonElement | null;
      const rowStatus = card.querySelector('[data-row-status]') as HTMLElement | null;

      editButton?.setAttribute('aria-label', `Edit ${row.title}`);
      deleteButton?.setAttribute('aria-label', `Delete ${row.title}`);

      editButton?.addEventListener('click', () => {
        if (!editor) return;
        if (!editor.hidden) {
          editor.hidden = true;
          runPendingDbReload();
          return;
        }
        fillRowEditor(editor, row);
        updateWordCounters(editor);
        if (rowStatus) rowStatus.textContent = '';
        editor.hidden = false;
      });

      cancelButton?.addEventListener('click', () => {
        if (editor) editor.hidden = true;
        if (rowStatus) rowStatus.textContent = '';
        runPendingDbReload();
      });

      editor?.addEventListener('submit', (event) => {
        event.preventDefault();
        void withBusy(saveButton, 'Saving...', async () => {
          try {
            if (!adminSupabase) throw new Error('Unlock the admin portal first.');
            setInlineStatus(rowStatus, '');
            const record = recordFromForm(editor);
            setInlineStatus(rowStatus, 'Copying the flyer into our storage...');
            const mirrored = await mirrorImageUrl(record.image_url);
            record.image_url = mirrored.url;
            setInlineStatus(rowStatus, '');
            // .select() so a silent zero-row update (stale password, deleted
            // row) surfaces as an error instead of a fake success.
            const { data, error } = await adminSupabase
              .from('events')
              .update(record)
              .eq('id', row.id)
              .select('id');
            if (error) throw new Error(error.message);
            if (!data || data.length === 0) {
              throw new Error('The database rejected the change. Lock the portal, unlock it again, and retry.');
            }
            setInlineStatus(
              dbPublishStatus,
              `Saved "${record.title}". It is in the database now; press Publish live site to show it publicly, or wait for the scheduled rebuild.${
                mirrored.warning ? ` ${mirrored.warning}` : ''
              }`
            );
            dbPublishStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            await loadDbEvents();
          } catch (error) {
            const message = errorMessage(error);
            setInlineStatus(rowStatus, `Could not save: ${message}`, true);
          }
        });
      });

      deleteButton?.addEventListener('click', () => {
        if (
          !window.confirm(
            `Delete "${row.title}" from the database? This cannot be undone. The public page keeps showing it until the next publish.`
          )
        )
          return;
        void withBusy(deleteButton, 'Deleting...', async () => {
          try {
            if (!adminSupabase) throw new Error('Unlock the admin portal first.');
            const { data, error } = await adminSupabase
              .from('events')
              .delete()
              .eq('id', row.id)
              .select('id');
            if (error) throw new Error(error.message);
            if (!data || data.length === 0) {
              throw new Error('The database rejected the delete. Lock the portal, unlock it again, and retry.');
            }
            setInlineStatus(
              dbPublishStatus,
              `Deleted "${row.title}". Press Publish live site to update the public page, or wait for the scheduled rebuild.`
            );
            dbPublishStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            await loadDbEvents();
          } catch (error) {
            const message = errorMessage(error);
            setInlineStatus(dbPublishStatus, `Could not delete: ${message}`, true);
          }
        });
      });

      return card;
    }

    /* ---------- Realtime (the session owns the one channel) ---------- */

    function renderLiveStatus(status: string) {
      if (!dbLive) return;
      if (status === 'off') {
        dbLive.textContent = 'Live updates: off';
      } else if (status === 'connecting') {
        dbLive.textContent = 'Live updates: connecting...';
      } else {
        dbLive.textContent =
          status === 'SUBSCRIBED' ? 'Live updates: on' : 'Live updates: reconnecting...';
      }
    }

    on('realtime-status', renderLiveStatus);

    on('events-change', () => {
      if (!adminSupabase) return;
      // Debounced: a CSV import fires one change per row.
      clearTimeout(dbReloadTimer);
      dbReloadTimer = setTimeout(() => {
        if (!adminSupabase) return;
        if (dbEditorOpen()) {
          // Re-rendering now would destroy the open editor's unsaved
          // edits. Reload once it closes.
          dbPendingReload = true;
          setInlineStatus(
            dbStatus,
            'The schedule changed elsewhere. It will refresh when you close the open editor.'
          );
          return;
        }
        void loadDbEvents();
      }, 400);
    });

    // Re-rendering the list would discard an open row editor's unsaved edits,
    // so search and scope changes wait, the same way realtime reloads do, and
    // apply as soon as the editor closes.
    dbScopeSelect?.addEventListener('change', () => {
      if (dbEditorOpen()) {
        dbPendingReload = true;
        return;
      }
      void loadDbEvents();
    });
    dbSearch?.addEventListener('input', () => {
      if (dbEditorOpen()) {
        dbPendingReload = true;
        return;
      }
      renderDbList();
    });
    dbRefresh?.addEventListener('click', () => {
      void withBusy(dbRefresh, 'Refreshing...', () => loadDbEvents());
    });

    // Publish live site: the shared session request. Every Publish button on
    // the page shows the same busy state (the page shell toggles them), and a
    // second press while one is in flight is ignored.
    dbPublish?.addEventListener('click', () => {
      if (dbPublish.disabled) return;
      setInlineStatus(dbPublishStatus, '');
      void publishLiveSite('events').then((record) => {
        if (record) setInlineStatus(dbPublishStatus, record.message, !record.ok);
      });
    });

    /* ---------- Flyer scanner (Gemini) ---------- */

    function setScanQuota(quota: ScanQuota) {
      emit('scan-quota', quota ?? null);
      if (!scanQuota) return;
      if (!quota || typeof quota.remaining !== 'number' || typeof quota.limit !== 'number') {
        scanQuota.textContent = 'Scan counter unavailable';
        return;
      }
      scanQuota.textContent = `${quota.remaining} of ${quota.limit} scans left today`;
    }

    async function refreshScanQuota() {
      if (scanQuota) scanQuota.textContent = "Checking today's scans...";
      try {
        const res = await fetch(`${functionsBase}/parse-event-image`, {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-admin-password': getPassword() },
          body: JSON.stringify({ action: 'status' }),
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok) throw new Error(payload?.error ?? 'Status check failed.');
        if (!adminSupabase) return;
        setScanQuota(payload?.quota);
      } catch (_) {
        if (!adminSupabase) return;
        setScanQuota(null);
      }
    }

    // The overview board's Refresh asks for a fresh count through here, so
    // there is one quota fetcher on the page.
    on('scan-quota-refresh', () => {
      if (adminSupabase) void refreshScanQuota();
    });

    function clearScanPreview() {
      if (scanPreviewUrl) {
        URL.revokeObjectURL(scanPreviewUrl);
        scanPreviewUrl = null;
      }
      if (scanPreviewWrap) scanPreviewWrap.hidden = true;
      if (scanPreview) scanPreview.removeAttribute('src');
    }

    // Downscale in the browser so uploads stay small for the edge function and
    // Gemini. Falls back to the original bytes for formats canvas cannot
    // decode (HEIC outside Safari); the server enforces its own size cap.
    async function imageFileToPayload(file: File): Promise<{ data: string; mime: string }> {
      try {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const context = canvas.getContext('2d');
        if (!context) throw new Error('Canvas unavailable.');
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
        const data = dataUrl.split(',')[1] ?? '';
        if (!data) throw new Error('Could not encode the image.');
        return { data, mime: 'image/jpeg' };
      } catch (_) {
        const buffer = await file.arrayBuffer();
        const bytes = new Uint8Array(buffer);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < bytes.length; i += chunk) {
          binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
        }
        return { data: btoa(binary), mime: file.type || 'image/jpeg' };
      }
    }

    function prefillSingleForm(eventDraft: Record<string, unknown>) {
      if (!singleEventForm) return;
      const setValue = (name: string, value: unknown) => {
        const el = singleEventForm.querySelector(
          `input[name="${name}"]:not([type="checkbox"]), textarea[name="${name}"]`
        ) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = typeof value === 'string' ? value : '';
      };
      setValue('title', eventDraft.title);
      setValue('event_date', eventDraft.event_date);
      setValue('venue', eventDraft.venue);
      setValue('start_time', eventDraft.start_time);
      // The scanner may not return an end_time yet; setValue blanks the field
      // for anything that is not a string, so an absent key is safe.
      setValue('end_time', eventDraft.end_time);
      setValue('neighborhood', eventDraft.neighborhood);
      setValue('organizer', eventDraft.organizer);
      setValue('cost_info', eventDraft.cost_info);
      setValue('event_url', eventDraft.event_url);
      setValue('image_url', eventDraft.image_url);
      setValue('description', eventDraft.description);
      setValue('author_note', '');
      setValue('emoji', eventDraft.emoji);
      const draftTags = Array.isArray(eventDraft.tags)
        ? eventDraft.tags.map((tag) => cleanText(tag).toLowerCase())
        : [];
      (singleEventForm.querySelectorAll('input[name="tags"]') as NodeListOf<HTMLInputElement>).forEach(
        (el) => {
          el.checked = draftTags.includes(el.value.toLowerCase());
        }
      );
      const setChecked = (name: string, checked: boolean) => {
        const el = singleEventForm.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
        if (el) el.checked = checked;
      };
      setChecked('is_giveaway', eventDraft.is_giveaway === true);
      setChecked('is_curated', false);
    }

    scanFile?.addEventListener('change', () => {
      clearScanPreview();
      const file = scanFile.files?.[0];
      if (file && scanPreview && scanPreviewWrap) {
        scanPreviewUrl = URL.createObjectURL(file);
        scanPreview.src = scanPreviewUrl;
        scanPreviewWrap.hidden = false;
      }
      if (scanStatus) scanStatus.textContent = '';
    });

    scanForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const file = scanFile?.files?.[0];
      if (!file) {
        setInlineStatus(scanStatus, 'Choose a flyer photo first.', true);
        return;
      }
      void withBusy(scanSubmit, 'Scanning...', async () => {
        try {
          setInlineStatus(scanStatus, 'Reading the flyer with Gemini...');
          const payload = await imageFileToPayload(file);
          const res = await fetch(`${functionsBase}/parse-event-image`, {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-admin-password': getPassword() },
            body: JSON.stringify({
              action: 'parse',
              mime_type: payload.mime,
              image_base64: payload.data,
            }),
          });
          const body = await res.json().catch(() => null);
          if (body?.quota) setScanQuota(body.quota);
          if (!res.ok) throw new Error(body?.error ?? `Scan failed (status ${res.status}).`);
          prefillSingleForm(body?.event ?? {});
          updateWordCounters(singleEventForm ?? app);
          const note = cleanText(body?.event?.scan_notes);
          setInlineStatus(
            scanStatus,
            `Draft loaded into the Add one event form. Review every field, then press Add event.${
              note ? ` Scanner note: ${note}` : ''
            }`
          );
          singleEventForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          const message = errorMessage(error);
          setInlineStatus(scanStatus, message, true);
        }
      });
    });

    singleEventForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void withBusy(singleSubmit, 'Saving...', async () => {
        try {
          setInlineStatus(singleStatus, '');
          const missing = missingRequiredLabels(singleEventForm);
          if (missing.length > 0) {
            setInlineStatus(
              singleStatus,
              `Still needed before this event can board: ${missing.join(', ')}.`,
              true
            );
            return;
          }
          const record = recordFromForm(singleEventForm);
          const endDate = cleanText(new FormData(singleEventForm).get('event_end_date'));
          const records = endDate ? expandDateRange(record, endDate) : [record];
          const warnings = await insertEvents(records, singleStatus);
          singleEventForm.reset();
          updateWordCounters(singleEventForm);
          setSingleSuccessBanner(record.title, records.length);
          setInlineStatus(singleStatus, warnings.join(' '), warnings.length > 0);
        } catch (error) {
          const message = errorMessage(error);
          setInlineStatus(singleStatus, `Could not add event: ${message}`, true);
        }
      });
    });

    function setCsvErrors(lines: string[]) {
      if (!csvStatus) return;
      csvStatus.textContent = '';
      csvStatus.classList.add('text-cayenneInk');
      csvStatus.classList.remove('text-darkWalnut');
      const intro = document.createElement('p');
      intro.textContent =
        lines.length === 1 ? 'Fix this row and upload again:' : `Fix these ${lines.length} rows and upload again:`;
      csvStatus.appendChild(intro);
      const list = document.createElement('ul');
      list.className = 'mt-2 list-disc space-y-1 pl-5 font-normal';
      lines.forEach((line) => {
        const item = document.createElement('li');
        item.textContent = line;
        list.appendChild(item);
      });
      csvStatus.appendChild(list);
    }

    csvForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const file = csvFileInput?.files?.[0];

      if (!file) {
        setInlineStatus(csvStatus, 'Choose a CSV file first.', true);
        return;
      }

      void withBusy(csvSubmit, 'Uploading...', () =>
        new Promise<void>((resolve) => {
          setInlineStatus(csvStatus, '');
          Papa.parse<CsvRow>(file, {
            header: true,
            skipEmptyLines: 'greedy',
            transformHeader: (header) => header.trim().toLowerCase(),
            complete: (results) => {
              void (async () => {
                try {
                  // Row numbers everywhere are spreadsheet rows: header is row 1,
                  // first data row is row 2. Papa reports 0-based data indexes.
                  const problems: string[] = [];
                  results.errors.forEach((parseError) => {
                    const rowNumber =
                      typeof parseError.row === 'number' ? parseError.row + 2 : 'unknown';
                    problems.push(`Row ${rowNumber}: ${parseError.message}`);
                  });

                  const records: AdminEventRecord[] = [];
                  results.data.forEach((row, index) => {
                    if (isBlankCsvRow(row)) return;
                    try {
                      records.push(recordFromCsvRow(row, index + 2));
                    } catch (rowError) {
                      problems.push(
                        rowError instanceof Error ? rowError.message : `Row ${index + 2}: invalid row.`
                      );
                    }
                  });

                  if (problems.length > 0) {
                    setCsvErrors(problems);
                    return;
                  }
                  if (records.length === 0) {
                    setInlineStatus(csvStatus, 'No event rows found in the CSV.', true);
                    return;
                  }

                  const warnings = await insertEvents(records, csvStatus);
                  csvForm.reset();
                  setInlineStatus(
                    csvStatus,
                    `${records.length} ${records.length === 1 ? 'event' : 'events'} added. Press Publish live site in the schedule section to show them publicly now, or wait for the scheduled rebuild.${
                      warnings.length > 0
                        ? ` ${warnings.length} flyer ${warnings.length === 1 ? 'link' : 'links'} could not be copied and ${warnings.length === 1 ? 'was' : 'were'} saved as pasted.`
                        : ''
                    }`
                  );
                } catch (error) {
                  const message = errorMessage(error);
                  setInlineStatus(csvStatus, `Could not upload CSV: ${message}`, true);
                } finally {
                  resolve();
                }
              })();
            },
            error: (error) => {
              setInlineStatus(csvStatus, `Could not read CSV: ${error.message}`, true);
              resolve();
            },
          });
        })
      );
    });

    // The CSV section is rarely used, so it starts collapsed; its open state
    // is remembered for this browser tab only.
    const CSV_OPEN_KEY = 'bl-admin-csv-open';
    if (csvDetails) {
      csvDetails.open = readSessionFlag(CSV_OPEN_KEY) === '1';
      csvDetails.addEventListener('toggle', () => {
        writeSessionFlag(CSV_OPEN_KEY, csvDetails.open ? '1' : '0');
      });
    }

    /* ---------- Session ---------- */

    on('unlock', () => {
      adminSupabase = getClient();
      setUnlocked(true);
    });

    on('lock', () => {
      adminSupabase = null;
      setUnlocked(false);
    });

    setUnlocked(false);
  }
</script>
