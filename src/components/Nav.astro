---
import MiniCalendar from './MiniCalendar.astro';

const base = import.meta.env.BASE_URL;
const instagramUrl = 'https://www.instagram.com/thebrownlinechi';
const tiktokUrl = 'https://www.tiktok.com/@thebrownlinechi';
// Route stops = destinations, in the order the team set: About, Events,
// Submit an Event, Social Media, Newsletter, Keep the Line Running (support).
// Social Media rides out to Instagram; every other stop stays on the line.
// One route for desktop and the mobile drawer, colors cycling the brand
// palette so no two neighboring stops share a dot color.
const route = [
  { href: `${base}about`,        label: 'About',                 stopColor: '#FFBC29' },
  { href: `${base}events`,       label: 'Events',                stopColor: '#5BC3FF' },
  { href: `${base}submit-event`, label: 'Submit an Event',       stopColor: '#F79CD0', gaEvent: 'submit_click' },
  { href: instagramUrl,          label: 'Social Media',          stopColor: '#90D393', gaEvent: 'social_click', external: true },
  { href: `${base}newsletter`,   label: 'Newsletter',            stopColor: '#F35A0F' },
  { href: `${base}support`,      label: 'Keep the Line Running', stopColor: '#FFBC29', gaEvent: 'support_click' },
];
---
<header class="bg-seashell sticky top-0 z-30 lg:static lg:z-auto">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-4">
    <a href={base} class="flex items-center gap-3 shrink-0 relative z-40" aria-label="The Brown Line, home">
      <img
        src={`${base}logos/logo.png`}
        alt="the Brown Line"
        class="h-12 w-auto md:h-14"
        width="120"
        height="120"
        decoding="async"
      />
    </a>

    {/* Desktop nav: all six destinations on a single route, with the mini
        calendar parked at the end of the line. Shown at lg+; tablets and phones
        use the hamburger drawer below so the route never gets crammed. */}
    <div class="hidden lg:flex flex-1 items-center gap-8 min-w-0">
      <nav aria-label="Primary" class="desktop-route-nav min-w-0">
        <ul class="desktop-route">
          {route.map(({ href, label, stopColor, gaEvent, external }) => (
            <li class="desktop-route-item" style={`--stop-color: ${stopColor};`}>
              <a
                href={href}
                class="desktop-route-link"
                data-ga-event={gaEvent}
                data-ga-label={gaEvent ? 'nav' : undefined}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <span class="desktop-route-stop" aria-hidden="true"></span>
                <span class="desktop-route-label">{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <MiniCalendar class="hidden lg:block shrink-0" />
    </div>

    {/* Mobile menu toggle */}
    <button
      id="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="lg:hidden relative z-40 w-11 h-11 flex flex-col items-center justify-center gap-[5px] text-darkWalnut focus:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue rounded-sm"
    >
      <span class="nav-bar nav-bar-top block w-7 h-[3px] bg-darkWalnut origin-center"></span>
      <span class="nav-bar nav-bar-mid block w-7 h-[3px] bg-darkWalnut"></span>
      <span class="nav-bar nav-bar-bot block w-7 h-[3px] bg-darkWalnut origin-center"></span>
    </button>
  </div>

  {/* Mobile drawer backdrop */}
  <div
    id="mobile-nav-backdrop"
    class="lg:hidden fixed inset-0 z-20 bg-darkWalnut/60 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  {/* Mobile slide-in drawer styled as a transit route map */}
  <aside
    id="mobile-nav"
    aria-label="Mobile menu"
    aria-hidden="true"
    inert
    class="lg:hidden fixed top-0 right-0 z-30 h-full w-[88vw] max-w-sm bg-seashell border-l-2 border-darkWalnut translate-x-full transition-transform duration-500 ease-out flex flex-col overflow-y-auto"
  >
    <div class="transit-divider"></div>

    <div class="px-6 pt-6 pb-2">
      <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">Now boarding</p>
      <p class="font-wordmark text-3xl text-darkWalnut leading-none mt-1">the Brown Line</p>
    </div>

    <nav aria-label="Mobile primary" class="px-6 pt-4 pb-2 flex-1">
      <ul id="mobile-nav-list" class="nav-stops flex flex-col">
        {route.map(({ href, label, stopColor, gaEvent, external }) => (
          <li class="mobile-nav-item" style={`--stop-color: ${stopColor};`}>
            <a
              href={href}
              class="mobile-nav-link"
              data-mobile-link
              data-ga-event={gaEvent}
              data-ga-label={gaEvent ? 'nav' : undefined}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="mobile-nav-stop" aria-hidden="true"></span>
              <span class="mobile-nav-label">{label}</span>
              <span class="mobile-nav-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
            </a>
          </li>
        ))}
      </ul>

      {/* Same mini calendar as the desktop header, parked after the stops. Its
          popover panel is re-anchored left and clamped to the drawer width
          (see .drawer-calendar rules below). */}
      <div class="drawer-calendar mt-8">
        <MiniCalendar />
      </div>
    </nav>

    <div class="mx-6 pt-5 pb-1 flex items-center gap-3 border-t-2 border-darkWalnut/10">
      <span class="font-body text-darkWalnut/55 text-[10px] uppercase tracking-[0.3em] font-semibold">Follow</span>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="The Brown Line on Instagram"
        class="social-icon inline-flex items-center justify-center w-10 h-10 text-darkWalnut"
        data-mobile-link
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a
        href={tiktokUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="The Brown Line on TikTok"
        class="social-icon inline-flex items-center justify-center w-10 h-10 text-darkWalnut"
        data-mobile-link
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        </svg>
      </a>
    </div>

    <div class="px-6 pt-4 pb-8">
      <p class="font-body text-darkWalnut/60 text-xs uppercase tracking-widest">Underground culture, elevated.</p>
    </div>
  </aside>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    if (!toggle || !drawer || !backdrop) return;
    const links = drawer.querySelectorAll('[data-mobile-link]');

    function setOpen(open) {
      drawer.classList.toggle('translate-x-full', !open);
      drawer.classList.toggle('translate-x-0', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      drawer.inert = !open;
      backdrop.classList.toggle('opacity-0', !open);
      backdrop.classList.toggle('pointer-events-none', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('is-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

    const mq = window.matchMedia('(min-width: 1024px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<style>
  /* Hamburger morphs into an X when the drawer is open */
  #nav-toggle .nav-bar {
    transition: transform 320ms cubic-bezier(0.65, 0, 0.35, 1), opacity 200ms ease;
  }
  #nav-toggle.is-open .nav-bar-top {
    transform: translateY(8px) rotate(45deg);
  }
  #nav-toggle.is-open .nav-bar-mid {
    opacity: 0;
  }
  #nav-toggle.is-open .nav-bar-bot {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Drawer calendar: re-anchor the popover panel to the left edge and clamp it
     to the drawer's inner width so it never spills past the drawer edge on
     small phones (the desktop instance keeps its fixed 21rem right-anchored
     panel). */
  .drawer-calendar :global(.mini-cal-panel) {
    right: auto;
    left: 0;
    width: 100%;
  }

  /* Desktop route map: dot and label ride side by side on one line, and a
     single track runs behind the whole route. Each link carries the header
     background, so the track shows only in the gaps between stops, reading
     as segments connecting station to station. */
  .desktop-route-nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  .desktop-route {
    position: relative;
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    align-items: center;
    column-gap: 0.95rem;
    isolation: isolate;
  }

  .desktop-route::before {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: #642713;
    z-index: 0;
  }

  .desktop-route-item {
    position: relative;
    z-index: 1;
  }

  .desktop-route-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.35rem;
    background: #FAF1EC;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.63rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #642713;
    transition: color 200ms ease, transform 220ms ease;
  }

  .desktop-route-stop {
    display: block;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 2px solid #642713;
    background: var(--stop-color);
    box-shadow: 1.5px 1.5px 0 #642713;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .desktop-route-link:hover,
  .desktop-route-link:focus-visible {
    color: #F35A0F;
    transform: translateY(-1px);
    outline: none;
  }

  .desktop-route-link:hover .desktop-route-stop,
  .desktop-route-link:focus-visible .desktop-route-stop {
    transform: scale(1.2);
    box-shadow: 2px 2px 0 #642713;
  }

  /* The header container caps at max-w-6xl, so the route never gets more
     room than this even on very wide screens. */
  @media (min-width: 1280px) {
    .desktop-route {
      column-gap: 1.4rem;
    }

    .desktop-route-link {
      font-size: 0.67rem;
      gap: 0.5rem;
    }

    .desktop-route-stop {
      width: 15px;
      height: 15px;
    }
  }

  /* Vertical transit line connecting the stops, draws downward as the drawer opens */
  #mobile-nav .nav-stops {
    position: relative;
  }
  #mobile-nav .nav-stops::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: #642713;
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  #mobile-nav[aria-hidden="false"] .nav-stops::before {
    transform: scaleY(1);
    transition-delay: 140ms;
  }

  /* Each stop slides in from the right with a stagger, like cars arriving */
  #mobile-nav .mobile-nav-item {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 350ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item {
    opacity: 1;
    transform: translateX(0);
  }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(1) { transition-delay: 200ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(2) { transition-delay: 280ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(3) { transition-delay: 360ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(4) { transition-delay: 440ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(5) { transition-delay: 520ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(6) { transition-delay: 600ms; }

  /* Social icons row at the drawer footer, fades in after the stops */
  #mobile-nav .social-icon {
    border-radius: 4px;
    transition: transform 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }
  #mobile-nav .social-icon:hover,
  #mobile-nav .social-icon:focus-visible {
    color: #F35A0F;
    transform: translateY(-2px);
    outline: none;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #642713;
    line-height: 1;
    transition: color 200ms ease, transform 220ms ease;
  }

  .mobile-nav-stop {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    border: 2px solid #642713;
    background: var(--stop-color);
    box-shadow: 2px 2px 0 #642713;
    flex-shrink: 0;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .mobile-nav-label {
    flex: 1;
  }

  .mobile-nav-arrow {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: #F35A0F;
    transform: translateX(4px);
    outline: none;
  }
  .mobile-nav-link:hover .mobile-nav-stop,
  .mobile-nav-link:focus-visible .mobile-nav-stop {
    transform: scale(1.15);
    box-shadow: 3px 3px 0 #642713;
  }
  .mobile-nav-link:hover .mobile-nav-arrow,
  .mobile-nav-link:focus-visible .mobile-nav-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav,
    #mobile-nav .nav-stops::before,
    #mobile-nav .mobile-nav-item,
    .mobile-nav-link,
    .mobile-nav-stop,
    .mobile-nav-arrow,
    .desktop-route-link,
    .desktop-route-stop,
    #nav-toggle .nav-bar {
      transition: none !important;
    }
  }
</style>
