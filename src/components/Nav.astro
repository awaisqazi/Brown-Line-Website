---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${base}#archive`,   label: 'Archive' },
  { href: `${base}about`,      label: 'About' },
  { href: `${base}standards`,  label: 'Standards & Ethics' },
  { href: `${base}#subscribe`, label: 'Subscribe' },
];
const instagramUrl = 'https://www.instagram.com/thebrownlinechi';
---
<header class="bg-seashell relative">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-4">
    <a href={base} class="flex items-center gap-3 shrink-0 relative z-40" aria-label="The Brown Line, home">
      <img
        src={`${base}logos/logo.png`}
        alt="the Brown Line"
        class="h-12 w-auto md:h-14"
        width="120"
        height="120"
        decoding="async"
      />
    </a>

    {/* Desktop nav */}
    <nav aria-label="Primary" class="hidden md:block min-w-0">
      <ul class="flex items-center justify-end gap-x-4 md:gap-x-6 lg:gap-x-8">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="link-transit font-body text-darkWalnut uppercase text-xs md:text-sm font-semibold tracking-widest"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Mobile menu toggle */}
    <button
      id="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="md:hidden relative z-40 w-11 h-11 flex flex-col items-center justify-center gap-[5px] text-darkWalnut focus:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue rounded-sm"
    >
      <span class="nav-bar nav-bar-top block w-7 h-[3px] bg-darkWalnut origin-center"></span>
      <span class="nav-bar nav-bar-mid block w-7 h-[3px] bg-darkWalnut"></span>
      <span class="nav-bar nav-bar-bot block w-7 h-[3px] bg-darkWalnut origin-center"></span>
    </button>
  </div>

  {/* Mobile drawer backdrop */}
  <div
    id="mobile-nav-backdrop"
    class="md:hidden fixed inset-0 z-20 bg-darkWalnut/60 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  {/* Mobile slide-in drawer styled as a transit route map */}
  <aside
    id="mobile-nav"
    aria-label="Mobile menu"
    aria-hidden="true"
    class="md:hidden fixed top-0 right-0 z-30 h-full w-[88vw] max-w-sm bg-seashell border-l-2 border-darkWalnut translate-x-full transition-transform duration-500 ease-out flex flex-col overflow-y-auto"
  >
    <div class="transit-divider"></div>

    <div class="px-6 pt-6 pb-2">
      <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">Now boarding</p>
      <p class="font-heading text-3xl text-darkWalnut leading-none mt-1">the Brown Line</p>
    </div>

    <nav aria-label="Mobile primary" class="px-6 pt-4 pb-2 flex-1">
      <ul id="mobile-nav-list" class="nav-stops flex flex-col">
        {navLinks.map(({ href, label }) => (
          <li class="mobile-nav-item">
            <a href={href} class="mobile-nav-link" data-mobile-link>
              <span class="mobile-nav-stop" aria-hidden="true"></span>
              <span class="mobile-nav-label">{label}</span>
              <span class="mobile-nav-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mx-6 pt-5 pb-1 flex items-center gap-3 border-t-2 border-darkWalnut/10">
      <span class="font-body text-darkWalnut/55 text-[10px] uppercase tracking-[0.3em] font-semibold">Follow</span>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="The Brown Line on Instagram"
        class="social-icon inline-flex items-center justify-center w-10 h-10 text-darkWalnut"
        data-mobile-link
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>

    <div class="px-6 pt-4 pb-8">
      <p class="font-body text-darkWalnut/60 text-xs uppercase tracking-widest">All stops, all stories.</p>
    </div>
  </aside>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    if (!toggle || !drawer || !backdrop) return;
    const links = drawer.querySelectorAll('[data-mobile-link]');

    function setOpen(open) {
      drawer.classList.toggle('translate-x-full', !open);
      drawer.classList.toggle('translate-x-0', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      backdrop.classList.toggle('opacity-0', !open);
      backdrop.classList.toggle('pointer-events-none', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('is-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

    const mq = window.matchMedia('(min-width: 768px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<style>
  /* Hamburger morphs into an X when the drawer is open */
  #nav-toggle .nav-bar {
    transition: transform 320ms cubic-bezier(0.65, 0, 0.35, 1), opacity 200ms ease;
  }
  #nav-toggle.is-open .nav-bar-top {
    transform: translateY(8px) rotate(45deg);
  }
  #nav-toggle.is-open .nav-bar-mid {
    opacity: 0;
  }
  #nav-toggle.is-open .nav-bar-bot {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Vertical transit line connecting the stops, draws downward as the drawer opens */
  #mobile-nav .nav-stops {
    position: relative;
  }
  #mobile-nav .nav-stops::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: #642713;
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  #mobile-nav[aria-hidden="false"] .nav-stops::before {
    transform: scaleY(1);
    transition-delay: 140ms;
  }

  /* Four transit colors map onto the four stops; Subscribe is the Cayenne terminus per the CTA token */
  #mobile-nav .mobile-nav-item:nth-child(1) .mobile-nav-stop { background: #F79CD0; }
  #mobile-nav .mobile-nav-item:nth-child(2) .mobile-nav-stop { background: #5BC3FF; }
  #mobile-nav .mobile-nav-item:nth-child(3) .mobile-nav-stop { background: #90D393; }
  #mobile-nav .mobile-nav-item:nth-child(4) .mobile-nav-stop { background: #F35A0F; }

  /* Each stop slides in from the right with a stagger, like cars arriving */
  #mobile-nav .mobile-nav-item {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 350ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item {
    opacity: 1;
    transform: translateX(0);
  }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(1) { transition-delay: 200ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(2) { transition-delay: 280ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(3) { transition-delay: 360ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(4) { transition-delay: 440ms; }

  /* Social icons row at the drawer footer, fades in after the stops */
  #mobile-nav .social-icon {
    border-radius: 4px;
    transition: transform 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }
  #mobile-nav .social-icon:hover,
  #mobile-nav .social-icon:focus-visible {
    color: #F35A0F;
    transform: translateY(-2px);
    outline: none;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #642713;
    line-height: 1;
    transition: color 200ms ease, transform 220ms ease;
  }

  .mobile-nav-stop {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    border: 2px solid #642713;
    box-shadow: 2px 2px 0 #642713;
    flex-shrink: 0;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .mobile-nav-label {
    flex: 1;
  }

  .mobile-nav-arrow {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: #F35A0F;
    transform: translateX(4px);
    outline: none;
  }
  .mobile-nav-link:hover .mobile-nav-stop,
  .mobile-nav-link:focus-visible .mobile-nav-stop {
    transform: scale(1.15);
    box-shadow: 3px 3px 0 #642713;
  }
  .mobile-nav-link:hover .mobile-nav-arrow,
  .mobile-nav-link:focus-visible .mobile-nav-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav,
    #mobile-nav .nav-stops::before,
    #mobile-nav .mobile-nav-item,
    .mobile-nav-link,
    .mobile-nav-stop,
    .mobile-nav-arrow,
    #nav-toggle .nav-bar {
      transition: none !important;
    }
  }
</style>
