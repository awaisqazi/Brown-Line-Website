---
const base = import.meta.env.BASE_URL;
// Route stops = destinations. Support + Subscribe sit side by side; Submit an
// Event is a wide amber CTA on its own row beneath them (see the CTA cluster).
const navLinks = [
  { href: `${base}events`,    label: 'Events',  stopColor: '#5BC3FF' },
  { href: `${base}#archive`,  label: 'Archive', stopColor: '#90D393' },
  { href: `${base}about`,     label: 'About',   stopColor: '#FFBC29' },
  { href: `${base}standards`, label: 'Ethics', stopColor: '#F35A0F' },
];
const navButtons = [
  { href: `${base}support`,    label: 'Support',   variant: 'outline', gaEvent: 'support_click' },
  { href: `${base}#subscribe`, label: 'Board here', variant: 'filled',  gaEvent: 'subscribe_click' },
];
const submitCta = { href: `${base}submit-event`, label: 'Submit an Event', gaEvent: 'submit_click' };
const variantClass = {
  amber:   'nav-cta-amber',
  outline: 'nav-cta-outline',
  filled:  'nav-cta-filled',
};
const instagramUrl = 'https://www.instagram.com/thebrownlinechi';
---
<header class="bg-seashell sticky top-0 z-30 lg:static lg:z-auto">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-4">
    <a href={base} class="flex items-center gap-3 shrink-0 relative z-40" aria-label="The Brown Line, home">
      <img
        src={`${base}logos/logo.png`}
        alt="the Brown Line"
        class="h-12 w-auto md:h-14"
        width="120"
        height="120"
        decoding="async"
      />
    </a>

    {/* Desktop nav: route of destinations + distinct Support/Subscribe buttons.
        Shown at lg+; tablets and phones use the hamburger drawer below so the
        7-item route never gets crammed. */}
    <div class="hidden lg:flex flex-1 items-center gap-8 min-w-0">
      <nav aria-label="Primary" class="desktop-route-nav min-w-0">
        <ul class="desktop-route">
          {navLinks.map(({ href, label, stopColor, gaEvent }) => (
            <li class="desktop-route-item" style={`--stop-color: ${stopColor};`}>
              <a
                href={href}
                class="desktop-route-link"
                data-ga-event={gaEvent}
                data-ga-label={gaEvent ? 'nav' : undefined}
              >
                <span class="desktop-route-stop" aria-hidden="true"></span>
                <span class="desktop-route-label">{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex shrink-0 flex-col gap-2.5">
        <div class="flex items-stretch gap-2.5">
          {navButtons.map(({ href, label, variant, gaEvent }) => (
            <a href={href} class:list={['nav-cta flex-1', variantClass[variant]]} data-ga-event={gaEvent} data-ga-label="nav">
              {label}
            </a>
          ))}
        </div>
        <a href={submitCta.href} class="nav-cta nav-cta-amber w-full" data-ga-event={submitCta.gaEvent} data-ga-label="nav">
          {submitCta.label}
        </a>
      </div>
    </div>

    {/* Mobile menu toggle */}
    <button
      id="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="lg:hidden relative z-40 w-11 h-11 flex flex-col items-center justify-center gap-[5px] text-darkWalnut focus:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue rounded-sm"
    >
      <span class="nav-bar nav-bar-top block w-7 h-[3px] bg-darkWalnut origin-center"></span>
      <span class="nav-bar nav-bar-mid block w-7 h-[3px] bg-darkWalnut"></span>
      <span class="nav-bar nav-bar-bot block w-7 h-[3px] bg-darkWalnut origin-center"></span>
    </button>
  </div>

  {/* Mobile drawer backdrop */}
  <div
    id="mobile-nav-backdrop"
    class="lg:hidden fixed inset-0 z-20 bg-darkWalnut/60 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  {/* Mobile slide-in drawer styled as a transit route map */}
  <aside
    id="mobile-nav"
    aria-label="Mobile menu"
    aria-hidden="true"
    inert
    class="lg:hidden fixed top-0 right-0 z-30 h-full w-[88vw] max-w-sm bg-seashell border-l-2 border-darkWalnut translate-x-full transition-transform duration-500 ease-out flex flex-col overflow-y-auto"
  >
    <div class="transit-divider"></div>

    <div class="px-6 pt-6 pb-2">
      <p class="font-body uppercase text-[10px] tracking-[0.3em] text-cayenne font-bold">Now boarding</p>
      <p class="font-wordmark text-3xl text-darkWalnut leading-none mt-1">the Brown Line</p>
    </div>

    <nav aria-label="Mobile primary" class="px-6 pt-4 pb-2 flex-1">
      <ul id="mobile-nav-list" class="nav-stops flex flex-col">
        {navLinks.map(({ href, label, stopColor, gaEvent }) => (
          <li class="mobile-nav-item" style={`--stop-color: ${stopColor};`}>
            <a href={href} class="mobile-nav-link" data-mobile-link data-ga-event={gaEvent} data-ga-label={gaEvent ? 'nav' : undefined}>
              <span class="mobile-nav-stop" aria-hidden="true"></span>
              <span class="mobile-nav-label">{label}</span>
              <span class="mobile-nav-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-col gap-3">
        {navButtons.map(({ href, label, variant, gaEvent }) => (
          <a
            href={href}
            data-mobile-link
            data-ga-event={gaEvent}
            data-ga-label="nav"
            class:list={['nav-cta nav-cta-mobile', variantClass[variant]]}
          >
            {label}
          </a>
        ))}
        <a
          href={submitCta.href}
          data-mobile-link
          data-ga-event={submitCta.gaEvent}
          data-ga-label="nav"
          class="nav-cta nav-cta-mobile nav-cta-amber"
        >
          {submitCta.label}
        </a>
      </div>
    </nav>

    <div class="mx-6 pt-5 pb-1 flex items-center gap-3 border-t-2 border-darkWalnut/10">
      <span class="font-body text-darkWalnut/55 text-[10px] uppercase tracking-[0.3em] font-semibold">Follow</span>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="The Brown Line on Instagram"
        class="social-icon inline-flex items-center justify-center w-10 h-10 text-darkWalnut"
        data-mobile-link
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>

    <div class="px-6 pt-4 pb-8">
      <p class="font-body text-darkWalnut/60 text-xs uppercase tracking-widest">Underground culture, elevated.</p>
    </div>
  </aside>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    if (!toggle || !drawer || !backdrop) return;
    const links = drawer.querySelectorAll('[data-mobile-link]');

    function setOpen(open) {
      drawer.classList.toggle('translate-x-full', !open);
      drawer.classList.toggle('translate-x-0', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      drawer.inert = !open;
      backdrop.classList.toggle('opacity-0', !open);
      backdrop.classList.toggle('pointer-events-none', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('is-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

    const mq = window.matchMedia('(min-width: 1024px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<style>
  /* Hamburger morphs into an X when the drawer is open */
  #nav-toggle .nav-bar {
    transition: transform 320ms cubic-bezier(0.65, 0, 0.35, 1), opacity 200ms ease;
  }
  #nav-toggle.is-open .nav-bar-top {
    transform: translateY(8px) rotate(45deg);
  }
  #nav-toggle.is-open .nav-bar-mid {
    opacity: 0;
  }
  #nav-toggle.is-open .nav-bar-bot {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Support / Subscribe buttons: visually distinct from the route links */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #642713;
    padding: 0.5rem 1rem;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;
    transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .nav-cta-outline {
    background: #FAF1EC;
    color: #642713;
  }

  .nav-cta-filled {
    background: #F35A0F;
    color: #FAF1EC;
  }

  /* Submit an Event: engaging amber CTA (matches the site's other Submit buttons). */
  .nav-cta-amber {
    background: #FFBC29;
    color: #642713;
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 #642713;
    outline: none;
  }

  .nav-cta-mobile {
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
  }

  @media (min-width: 1024px) {
    .nav-cta {
      font-size: 0.78rem;
    }
  }

  /* Desktop route map mirrors the mobile stop language on a compact horizontal track */
  .desktop-route-nav {
    flex: 1 1 auto;
  }

  .desktop-route {
    --route-gap: 2.75rem;
    --stop-size: 20px;
    /* Horizontal padding reserves room for the first/last station labels, which
       are centered under their dots and overflow the dot width. Without it the
       first/last label spills past the route box. */
    --route-pad: 2.25rem;
    position: relative;
    display: flex;
    /* A content-width group centered in the space between the logo and the CTA
       cluster: comfortable spacing between stops without stretching the route
       across the whole header. */
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    align-items: flex-start;
    justify-content: center;
    column-gap: var(--route-gap);
    padding: 0 var(--route-pad) 1.75rem;
    isolation: isolate;
  }

  .desktop-route::before {
    content: '';
    position: absolute;
    /* Start/end on the first and last dot centers (inset by the route padding). */
    left: calc(var(--route-pad) + var(--stop-size) / 2);
    right: calc(var(--route-pad) + var(--stop-size) / 2);
    top: calc(var(--stop-size) / 2);
    height: 2px;
    background: #642713;
    z-index: 0;
  }

  .desktop-route-item {
    position: relative;
    width: var(--stop-size);
    height: calc(var(--stop-size) + 1.75rem);
    z-index: 1;
  }

  .desktop-route-link {
    position: relative;
    display: block;
    width: var(--stop-size);
    height: 100%;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    color: #642713;
    white-space: nowrap;
    transition: color 200ms ease, transform 220ms ease;
  }

  .desktop-route-stop {
    display: block;
    width: var(--stop-size);
    height: var(--stop-size);
    border-radius: 9999px;
    border: 2px solid #642713;
    background: var(--stop-color);
    box-shadow: 2px 2px 0 #642713;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .desktop-route-label {
    display: block;
    position: absolute;
    top: calc(var(--stop-size) + 0.55rem);
    left: 50%;
    transform: translateX(-50%);
  }

  .desktop-route-link:hover,
  .desktop-route-link:focus-visible {
    color: #F35A0F;
    transform: translateY(-2px);
    outline: none;
  }

  .desktop-route-link:hover .desktop-route-stop,
  .desktop-route-link:focus-visible .desktop-route-stop {
    transform: scale(1.15);
    box-shadow: 3px 3px 0 #642713;
  }

  @media (min-width: 1024px) {
    .desktop-route {
      --route-gap: 5rem;
    }

    .desktop-route-link {
      font-size: 0.78rem;
    }
  }

  /* Vertical transit line connecting the stops, draws downward as the drawer opens */
  #mobile-nav .nav-stops {
    position: relative;
  }
  #mobile-nav .nav-stops::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: #642713;
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  #mobile-nav[aria-hidden="false"] .nav-stops::before {
    transform: scaleY(1);
    transition-delay: 140ms;
  }

  /* Each stop slides in from the right with a stagger, like cars arriving */
  #mobile-nav .mobile-nav-item {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 350ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item {
    opacity: 1;
    transform: translateX(0);
  }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(1) { transition-delay: 200ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(2) { transition-delay: 280ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(3) { transition-delay: 360ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(4) { transition-delay: 440ms; }
  #mobile-nav[aria-hidden="false"] .mobile-nav-item:nth-child(5) { transition-delay: 520ms; }

  /* Social icons row at the drawer footer, fades in after the stops */
  #mobile-nav .social-icon {
    border-radius: 4px;
    transition: transform 180ms ease, color 180ms ease, box-shadow 180ms ease;
  }
  #mobile-nav .social-icon:hover,
  #mobile-nav .social-icon:focus-visible {
    color: #F35A0F;
    transform: translateY(-2px);
    outline: none;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #642713;
    line-height: 1;
    transition: color 200ms ease, transform 220ms ease;
  }

  .mobile-nav-stop {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    border: 2px solid #642713;
    background: var(--stop-color);
    box-shadow: 2px 2px 0 #642713;
    flex-shrink: 0;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .mobile-nav-label {
    flex: 1;
  }

  .mobile-nav-arrow {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: #F35A0F;
    transform: translateX(4px);
    outline: none;
  }
  .mobile-nav-link:hover .mobile-nav-stop,
  .mobile-nav-link:focus-visible .mobile-nav-stop {
    transform: scale(1.15);
    box-shadow: 3px 3px 0 #642713;
  }
  .mobile-nav-link:hover .mobile-nav-arrow,
  .mobile-nav-link:focus-visible .mobile-nav-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav,
    #mobile-nav .nav-stops::before,
    #mobile-nav .mobile-nav-item,
    .mobile-nav-link,
    .mobile-nav-stop,
    .mobile-nav-arrow,
    .desktop-route-link,
    .desktop-route-stop,
    #nav-toggle .nav-bar {
      transition: none !important;
    }
  }
</style>
