---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import TransitDivider from '../components/TransitDivider.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import SupportPopup from '../components/SupportPopup.astro';
import { getTickerItems } from '../lib/ticker';
import { BRAND_KEYWORDS, buildSiteJsonLd, stringifyJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Extra search keywords for this page, added ahead of the site-wide set. */
  keywords?: string[];
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  minimal?: boolean;
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  "Chicago's independent guide to Global South diaspora events, arts, culture, and community media. A curated events calendar plus one weekly newsletter stop in your inbox.";

// 1200x630 share card; pages can override ogImage with their own art.
const DEFAULT_OG_IMAGE = 'og/og-card.png';

const {
  title = "The Brown Line: Chicago's Global South Diaspora Events & Media",
  description = DEFAULT_DESCRIPTION,
  keywords = [],
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = "The Brown Line, Chicago's Global South arts and culture guide",
  ogType = 'website',
  minimal = false,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const baseUrl = Astro.site?.toString() ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const brandName = 'The Brown Line';
const faviconUrl = `${base}logos/logo.png`;
const appleTouchIconUrl = `${base}app-icons/apple-touch-icon.png`;
const manifestUrl = `${base}site.webmanifest`;
// If ogImage is already absolute, use it as-is; otherwise resolve relative to site+base
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(`${base}${ogImage.replace(/^\//, '')}`, baseUrl).toString();
// Only the default card has known dimensions; overrides may be any size.
const isDefaultOgImage = ogImage === DEFAULT_OG_IMAGE;
const tickerItems = minimal ? [] : await getTickerItems();

// Publisher identity (Organization + WebSite), rendered on every page so the
// same brand, logo, and Instagram profile back every URL a crawler finds.
const siteJsonLd = buildSiteJsonLd({
  siteUrl: new URL(base, baseUrl).toString(),
  logoUrl: new URL(faviconUrl, baseUrl).toString(),
});

// Google Analytics 4. Loads only when PUBLIC_GA_MEASUREMENT_ID (one or more
// "G-XXXXXXXXXX" ids, comma-separated) is set, so the site never ships a
// non-collecting tracker. One gtag.js load serves every id: the first id is the
// script's query id and every id gets its own config call, so the same hits
// reach each property (the site's original property and the team's own one).
// Analytics is on by default (US audience, no opt-in banner, owner decision
// 2026-10-14); a visitor can opt out on /privacy, which stores 'denied' in
// localStorage['blAnalyticsConsent'] and every tracker here honors it.
const gaMeasurementIds = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '')
  .split(',')
  .map((id) => id.trim())
  .filter((id) => /^G-[A-Z0-9]+$/i.test(id));
const gaMeasurementId = gaMeasurementIds[0];
// The inline tag is rendered as literal text (not define:vars) so each id appears
// in the HTML exactly as Google's "Test your website" detector expects:
// gtag.js loaded with the first id, then a plain gtag('config', 'G-...') line
// per id. The ids are regex-validated above, so nothing unsafe reaches the page.
const gaInlineTag = [
  'window.dataLayer = window.dataLayer || [];',
  'function gtag(){ dataLayer.push(arguments); }',
  'window.gtag = gtag;',
  'var optedOut = false;',
  "try { optedOut = localStorage.getItem('blAnalyticsConsent') === 'denied'; } catch (_) {}",
  "gtag('consent', 'default', {",
  "  ad_storage: 'denied',",
  "  ad_user_data: 'denied',",
  "  ad_personalization: 'denied',",
  "  analytics_storage: optedOut ? 'denied' : 'granted',",
  '});',
  "gtag('js', new Date());",
  ...gaMeasurementIds.map((id) => `gtag('config', '${id}', { anonymize_ip: true });`),
].join('\n');

// Meta pixel for the newsletter ad campaign. Loads only when PUBLIC_META_PIXEL_ID
// (the numeric pixel id) is set, so by default nothing from Meta ships. It honors
// the same /privacy opt-out as GA: consent is revoked before init when the
// visitor has opted out.
const metaPixelId = /^\d+$/.test(String(import.meta.env.PUBLIC_META_PIXEL_ID ?? '').trim())
  ? String(import.meta.env.PUBLIC_META_PIXEL_ID).trim()
  : '';

// The opt-out hook and the delegated event tracking render whenever any
// tracker is configured.
const hasAnalytics = Boolean(gaMeasurementId || metaPixelId);

// Search keywords: the page's own first, then the site-wide set, deduped.
const metaKeywords = Array.from(new Set([...keywords, ...BRAND_KEYWORDS])).join(', ');

// Google Search Console ownership token (the content value of the meta tag
// Search Console hands out under "HTML tag" verification). Set through the
// PUBLIC_GOOGLE_SITE_VERIFICATION repo variable; nothing renders while unset.
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="geo.region" content="US-IL" />
    <meta name="geo.placename" content="Chicago" />
    {googleSiteVerification && !noindex && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <meta name="theme-color" content="#FAF1EC" />
    <meta name="application-name" content={brandName} />
    <meta name="apple-mobile-web-app-title" content={brandName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow, noarchive" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <title>{title}</title>

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {isDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {isDefaultOgImage && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_US" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Publisher structured data. Page-specific schemas (Event, Article,
        ItemList, BreadcrumbList) are rendered by the pages themselves. */}
    <script type="application/ld+json" set:html={stringifyJsonLd(siteJsonLd)} />

    {gaMeasurementId && (
      <Fragment>
        {/* Google Analytics 4 with Consent Mode v2. Analytics storage is granted
            by default and denied only for a visitor who opted out on /privacy.
            Ad storage stays denied: GA is used for measurement, not ads. */}
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline set:html={gaInlineTag} />
      </Fragment>
    )}

    {metaPixelId && (
      <Fragment>
        {/* Meta pixel base code. Consent is revoked before init for a visitor
            who opted out on /privacy, so nothing is sent for them; everyone
            else sends the PageView straight away. */}
        <script is:inline define:vars={{ metaPixelId }}>
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          var optedOut = false;
          try { optedOut = localStorage.getItem('blAnalyticsConsent') === 'denied'; } catch (_) {}
          if (optedOut) fbq('consent', 'revoke');
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} />
        </noscript>
      </Fragment>
    )}

    {/* Newsletter subscribe-source attribution. Loads unless the visitor opted
        out of analytics on /privacy. */}
    <script is:inline>
      (function () {
        function loadAttribution() {
          if (window.__blAttributionLoaded) return;
          window.__blAttributionLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://subscribe-forms.beehiiv.com/attribution.js';
          document.head.appendChild(s);
        }
        window.blLoadAttribution = loadAttribution;
        var optedOut = false;
        try { optedOut = localStorage.getItem('blAnalyticsConsent') === 'denied'; } catch (_) {}
        if (!optedOut) loadAttribution();
      })();
    </script>
  </head>

  <body class="font-body bg-seashell text-darkWalnut min-h-screen flex flex-col">
    {!minimal && <Nav />}
    {!minimal && <TransitDivider />}
    {!minimal && <Marquee items={tickerItems} />}

    <main class="flex-1">
      <slot />
    </main>

    {!minimal && <Footer />}
    {!minimal && <SupportPopup />}

    {hasAnalytics && (
      <Fragment>
      <script is:inline>
        (() => {
          // Analytics opt-out hook, used by the switch on /privacy. 'denied'
          // turns GA storage and the Meta pixel off for this browser; 'granted'
          // turns them back on. The choice is remembered in localStorage.
          window.blSetAnalyticsConsent = function (choice) {
            try { localStorage.setItem('blAnalyticsConsent', choice); } catch (_) {}
            var granted = choice === 'granted';
            if (window.gtag) {
              window.gtag('consent', 'update', { analytics_storage: granted ? 'granted' : 'denied' });
            }
            if (window.fbq) window.fbq('consent', granted ? 'grant' : 'revoke');
            if (granted && window.blLoadAttribution) window.blLoadAttribution();
          };

          // Delegated custom-event tracking. No-ops if gtag isn't present.
          document.addEventListener('click', function (e) {
            var el = e.target.closest('[data-ga-event]');
            if (!el || !window.gtag) return;
            var params = {};
            if (el.dataset.gaLabel) params.label = el.dataset.gaLabel;
            window.gtag('event', el.dataset.gaEvent, params);
          });
          document.addEventListener('change', function (e) {
            var el = e.target.closest('select[data-ga-event]');
            if (!el || !window.gtag) return;
            window.gtag('event', el.dataset.gaEvent, { label: el.value || '(cleared)' });
          });

          // Homepage / page scroll depth: each threshold fires once.
          var marks = [25, 50, 75, 90];
          var hit = {};
          window.addEventListener('scroll', function () {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            if (max <= 0) return;
            var pct = (window.scrollY / max) * 100;
            for (var i = 0; i < marks.length; i++) {
              var m = marks[i];
              if (pct >= m && !hit[m]) {
                hit[m] = true;
                if (window.gtag) window.gtag('event', 'scroll_depth', { label: m + '%', value: m });
              }
            }
          }, { passive: true });
        })();
      </script>
      </Fragment>
    )}

    {/* Paper-grain noise overlay: 4% multiply texture, sits above all chrome but never blocks clicks. */}
    <div
      class="pointer-events-none fixed inset-0 z-[999] opacity-[0.04] mix-blend-multiply"
      aria-hidden="true"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
    ></div>
  </body>
</html>
