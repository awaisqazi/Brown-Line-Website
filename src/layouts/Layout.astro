---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import TransitDivider from '../components/TransitDivider.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';
import TrainSplash from '../components/TrainSplash.jsx';
import { getTickerItems } from '../lib/ticker';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  minimal?: boolean;
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Chicago arts, culture, and community, through a Global South diaspora lens. One weekly stop in your inbox. Independent voices. Real neighborhoods. All aboard.';

// 1200x630 share card; pages can override ogImage with their own art.
const DEFAULT_OG_IMAGE = 'og/og-card.png';

const {
  title = "The Brown Line: Chicago's Global South Arts & Culture Guide",
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = "The Brown Line, Chicago's Global South arts and culture guide",
  ogType = 'website',
  minimal = false,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const baseUrl = Astro.site?.toString() ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const brandName = 'The Brown Line';
const faviconUrl = `${base}logos/logo.png`;
const appleTouchIconUrl = `${base}app-icons/apple-touch-icon.png`;
const manifestUrl = `${base}site.webmanifest`;
// If ogImage is already absolute, use it as-is; otherwise resolve relative to site+base
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(`${base}${ogImage.replace(/^\//, '')}`, baseUrl).toString();
// Only the default card has known dimensions; overrides may be any size.
const isDefaultOgImage = ogImage === DEFAULT_OG_IMAGE;
const tickerItems = minimal ? [] : await getTickerItems();

// Google Analytics 4. Loads only when PUBLIC_GA_MEASUREMENT_ID (a "G-XXXXXXXXXX"
// id) is set, so the site never ships a non-collecting tracker. Uses Consent
// Mode v2 defaulting to denied; the consent banner below upgrades to granted.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF1EC" />
    <meta name="application-name" content={brandName} />
    <meta name="apple-mobile-web-app-title" content={brandName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <title>{title}</title>

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {isDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {isDefaultOgImage && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_US" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Intro gate memory: returning visitors (and anyone opening a shared link a
        second time) skip the splash entirely. Setting splash-done in <head>,
        before the body paints, means the React splash is never shown, no flash.
        Also auto-skip for reduced-motion users. */}
    <script is:inline>
      try {
        var seen = localStorage.getItem('brownLineIntroSeen') === '1';
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (seen || reduced) {
          document.documentElement.classList.add('splash-done');
        }
      } catch (_) {}
    </script>

    {gaMeasurementId && (
      <Fragment>
        {/* Google Analytics 4 with Consent Mode v2. Analytics storage defaults to
            denied (no cookies) until the visitor accepts via the banner below. */}
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500,
          });
          try {
            if (localStorage.getItem('blAnalyticsConsent') === 'granted') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            }
          } catch (_) {}
          gtag('js', new Date());
          gtag('config', gaMeasurementId, { anonymize_ip: true });
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      </Fragment>
    )}

    {/* Beehiiv V3 Attribution tracking */}
    <script type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>
  </head>

  <body class="font-body bg-seashell text-darkWalnut min-h-screen flex flex-col">
    {!minimal && <TrainSplash client:load />}
    {!minimal && <Nav />}
    {!minimal && <TransitDivider />}
    {!minimal && <Marquee items={tickerItems} />}

    <main class="flex-1">
      <slot />
    </main>

    {!minimal && <Footer tickerItems={tickerItems} />}

    {gaMeasurementId && (
      <Fragment>
      <div
        id="bl-consent"
        class="fixed inset-x-0 bottom-0 z-[1000] hidden border-t-2 border-darkWalnut bg-seashell px-4 py-4 shadow-[0_-4px_0_#642713]"
        role="region"
        aria-label="Analytics consent"
        aria-live="polite"
      >
        <div class="mx-auto flex max-w-5xl flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <p class="font-body text-sm text-darkWalnut leading-relaxed">
            We use privacy-respecting analytics to see what's useful. No ads, and we never sell your data. See our <a href={`${base}privacy`} class="font-bold underline decoration-2 decoration-mayaBlue underline-offset-2 hover:decoration-cayenne">privacy page</a>.
          </p>
          <div class="flex shrink-0 items-center gap-2">
            <button type="button" data-consent="decline" class="border-2 border-darkWalnut bg-seashell px-4 py-2 font-body text-xs font-bold uppercase tracking-widest text-darkWalnut transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[2px_2px_0_#642713] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue">Decline</button>
            <button type="button" data-consent="accept" class="border-2 border-darkWalnut bg-cayenne px-4 py-2 font-body text-xs font-bold uppercase tracking-widest text-seashell transition-transform duration-150 hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[2px_2px_0_#642713] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mayaBlue">Accept</button>
          </div>
        </div>
      </div>

      <script is:inline>
        (() => {
          // Consent banner: show only when the visitor hasn't chosen yet.
          var banner = document.getElementById('bl-consent');
          var stored = null;
          try { stored = localStorage.getItem('blAnalyticsConsent'); } catch (_) {}
          if (banner && !stored) banner.classList.remove('hidden');
          function setConsent(choice) {
            try { localStorage.setItem('blAnalyticsConsent', choice); } catch (_) {}
            if (choice === 'granted' && window.gtag) {
              window.gtag('consent', 'update', { analytics_storage: 'granted' });
            }
            if (banner) banner.classList.add('hidden');
          }
          if (banner) {
            banner.addEventListener('click', function (e) {
              var btn = e.target.closest('[data-consent]');
              if (!btn) return;
              setConsent(btn.getAttribute('data-consent') === 'accept' ? 'granted' : 'denied');
            });
          }

          // Delegated custom-event tracking. No-ops if gtag isn't present.
          document.addEventListener('click', function (e) {
            var el = e.target.closest('[data-ga-event]');
            if (!el || !window.gtag) return;
            var params = {};
            if (el.dataset.gaLabel) params.label = el.dataset.gaLabel;
            window.gtag('event', el.dataset.gaEvent, params);
          });
          document.addEventListener('change', function (e) {
            var el = e.target.closest('select[data-ga-event]');
            if (!el || !window.gtag) return;
            window.gtag('event', el.dataset.gaEvent, { label: el.value || '(cleared)' });
          });

          // Homepage / page scroll depth: each threshold fires once.
          var marks = [25, 50, 75, 90];
          var hit = {};
          window.addEventListener('scroll', function () {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            if (max <= 0) return;
            var pct = (window.scrollY / max) * 100;
            for (var i = 0; i < marks.length; i++) {
              var m = marks[i];
              if (pct >= m && !hit[m]) {
                hit[m] = true;
                if (window.gtag) window.gtag('event', 'scroll_depth', { label: m + '%', value: m });
              }
            }
          }, { passive: true });
        })();
      </script>
      </Fragment>
    )}

    {/* Paper-grain noise overlay: 4% multiply texture, sits above all chrome but never blocks clicks. */}
    <div
      class="pointer-events-none fixed inset-0 z-[999] opacity-[0.04] mix-blend-multiply"
      aria-hidden="true"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
    ></div>
  </body>
</html>
